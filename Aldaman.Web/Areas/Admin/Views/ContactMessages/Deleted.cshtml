@using Aldaman.Persistence.Enums
@using Aldaman.Services.Dtos.ContactMessage
@model PagedResultDto<ContactMessageDto>
@{
    ViewData["Title"] = Localizer[UIResourceKeys.DeletedMessages];
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h3 mb-0 text-danger d-flex align-items-center gap-2">
        <i class="bi bi-trash fs-4"></i>
        @Localizer[UIResourceKeys.DeletedMessages]
    </h2>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i>
        @Localizer[UIResourceKeys.BackToList]
    </a>
</div>

<div class="mb-4 p-3 bg-light border shadow rounded-4">
    <form method="get" class="row g-3">
        <div class="col-md-3">
            <div class="input-group">
                <span class="input-group-text border-end-0">
                    <i class="bi bi-search" style="font-size: 18px;"></i>
                </span>
                <input type="text" name="SearchTerm" class="form-control border-start-0" placeholder="@Localizer[UIResourceKeys.Search]..." value="@Context.Request.Query["SearchTerm"]">
            </div>
        </div>
        <div class="col-md-4">
            <select name="SortBy" class="form-select">
                <option value="@SortByConstants.CreatedAt" selected="@(Context.Request.Query["SortBy"] == SortByConstants.CreatedAt)">@Localizer[UIResourceKeys.SortByDate]</option>
                <option value="@SortByConstants.State" selected="@(Context.Request.Query["SortBy"] == SortByConstants.State)">@Localizer[UIResourceKeys.SortByStatus]</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="SortDescending" class="form-select">
                <option value="true" selected="@(Context.Request.Query["SortDescending"] == "true" || string.IsNullOrEmpty(Context.Request.Query["SortDescending"]))">@Localizer[UIResourceKeys.Descending]</option>
                <option value="false" selected="@(Context.Request.Query["SortDescending"] == "false")">@Localizer[UIResourceKeys.Ascending]</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary flex-grow-1">@Localizer[UIResourceKeys.Filter]</button>
            <button type="submit" onclick="this.form.SearchTerm.value=''; this.form.SortBy.value='@SortByConstants.CreatedAt'; this.form.SortDescending.value='true';" class="btn btn-outline-secondary flex-grow-1">@Localizer[UIResourceKeys.Clear]</button>
        </div>
    </form>
</div>

<div class="bg-light border shadow rounded-4 overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table table-light table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-4 py-3 text-uppercase small fw-bold text-muted" style="width: 25%">@Localizer[UIResourceKeys.Sender]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer[UIResourceKeys.Subject] / @Localizer[UIResourceKeys.Message]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer[UIResourceKeys.State]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted text-end pe-4">@Localizer[UIResourceKeys.Actions]</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-5 text-muted">@Localizer[UIResourceKeys.NoItemsFound]</td>
                    </tr>
                }
                @foreach (var item in Model.Items)
                {
                    <tr id="row-deleted-@item.Id">
                        <td class="ps-4 py-3">
                            <div class="fw-semibold text-muted">@item.EmailOrPhone</div>
                        </td>
                        <td class="py-3">
                            <div class="fw-medium text-muted text-truncate" style="max-width: 300px;">@(string.IsNullOrEmpty(item.Subject) ? Localizer[UIResourceKeys.NoSubject].Value : item.Subject)</div>
                            <div class="small text-muted text-truncate" style="max-width: 300px;">@item.Message</div>
                        </td>
                        <td class="py-3">
                            @if (item.DeletedAtUtc.HasValue)
                            {
                                <span class="text-danger small fw-medium">
                                    @string.Format(Localizer[UIResourceKeys.DeletedOnDate].Value, item.DeletedAtUtc.Value.ToLocalTime().ToString(FormatConstants.DateDot))
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">@Localizer[UIResourceKeys.Deleted]</span>
                            }
                            <div class="text-muted small mt-2">
                                <div>
                                    <i class="bi bi-asterisk"></i>
                                    @item.CreatedAtUtc.ToLocalTime().ToString(FormatConstants.DateTimeDot)
                                </div>
                            </div>
                        </td>
                        <td class="py-3 text-end pe-4">
                            <div class="d-inline-flex flex-column gap-2">
                                <button class="btn btn-outline-success btn-sm d-inline align-items-center gap-1" data-action="restore" data-id="@item.Id" data-title="@item.EmailOrPhone" data-url="@Url.Action("Restore")">
                                    <i class="bi bi-arrow-counterclockwise"></i>
                                    @Localizer[UIResourceKeys.Restore]
                                </button>
                                <a class="btn btn-outline-info btn-sm d-inline align-items-center gap-1" asp-action="Details" asp-route-id="@item.Id" title="@Localizer[UIResourceKeys.View]">
                                    <i class="bi bi-info-circle"></i>
                                    @Localizer[UIResourceKeys.Details]
                                </a>
                                <button class="btn btn-outline-danger btn-sm d-inline align-items-center gap-1" data-action="hard-delete" data-id="@item.Id" data-title="@item.EmailOrPhone" data-url="@Url.Action("HardDelete")" data-confirm-text="@Localizer[UIResourceKeys.ConfirmDeletePermanentlyMessageText].Value">
                                    <i class="bi bi-trash"></i>
                                    @Localizer[UIResourceKeys.DeletePermanently]
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="px-4 pb-4">
        @await Html.PartialAsync("_AdminPagination", Model)
    </div>
</div>

@Html.AntiForgeryToken()
