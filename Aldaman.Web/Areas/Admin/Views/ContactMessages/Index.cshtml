@using Aldaman.Persistence.Enums
@using Aldaman.Services.Dtos.ContactMessage
@model PagedResultsDto<ContactMessageDto>
@{
    ViewData["Title"] = Localizer["ContactMessages"];
    var query = Model.Query;
}

<div class="mb-4 p-3 bg-light border shadow rounded-4">
    <form method="get" class="row g-3">
        <div class="col-md-3">
            <div class="input-group">
                <span class="input-group-text border-end-0">
                    <i class="bi bi-search" style="font-size: 18px;"></i>
                </span>
                <input type="text" name="SearchTerm" class="form-control border-start-0" placeholder="@Localizer["Search"]..." value="@query.SearchTerm">
            </div>
        </div>
        <div class="col-md-4">
            <select name="SortBy" class="form-select">
                <option value="CreatedAt" selected="@(query.SortBy == "CreatedAt")">@Localizer["SortByDate"]</option>
                <option value="State" selected="@(query.SortBy == "State")">@Localizer["SortByStatus"]</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="SortDescending" class="form-select">
                <option value="true" selected="@(query.SortDescending == true)">@Localizer["Descending"]</option>
                <option value="false" selected="@(query.SortDescending == false)">@Localizer["Ascending"]</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary flex-grow-1">@Localizer["Filter"]</button>
            <button type="submit" onclick="this.form.SearchTerm.value=''; this.form.SortBy.value='CreatedAt'; this.form.SortDescending.value='true';" class="btn btn-outline-secondary flex-grow-1">@Localizer["Clear"]</button>
        </div>
    </form>
</div>

<div class="bg-light border shadow rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-light table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-4 py-3 text-uppercase small fw-bold text-muted" style="width: 25%">@Localizer["Sender"]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer["Subject"] / @Localizer["Message"]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer["State"]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted text-end pe-4">@Localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Items.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-5 text-muted">@Localizer["NoItemsFound"]</td>
                    </tr>
                }
                @foreach (var item in Model.Items.Items)
                {
                    <tr id="row-@item.Id">
                        <td class="ps-4 py-3">
                            <div class="fw-semibold text-dark">@item.EmailOrPhone</div>
                        </td>
                        <td class="py-3">
                            <div class="fw-medium text-dark text-truncate" style="max-width: 300px;">@(string.IsNullOrEmpty(item.Subject) ? Localizer["NoSubject"].Value : item.Subject)</div>
                            <div class="small text-muted text-truncate" style="max-width: 300px;">@item.Message</div>
                        </td>
                        <td class="py-3">
                            @switch (item.State)
                            {
                                case ContactMessageState.Pending:
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">@Localizer["Pending"]</span>
                                    break;
                                case ContactMessageState.Sent:
                                    <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">@Localizer["Handled"]</span>
                                    break;
                                case ContactMessageState.Failed:
                                    <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle">@Localizer["Failed"]</span>
                                    break;
                            }
                            <div class="text-muted small mt-2">
                                <div>
                                    <i class="bi bi-asterisk"></i>
                                    @item.CreatedAtUtc.ToLocalTime().ToString(FormatConstants.DateTimeDot)
                                </div>
                            </div>
                        </td>
                        <td class="py-3 text-end pe-4">
                            <div class="d-inline-flex flex-column gap-2">
                                <a class="btn btn-outline-info btn-sm d-inline align-items-center gap-1" asp-action="Details" asp-route-id="@item.Id">
                                    <i class="bi bi-info-circle"></i>
                                    @Localizer["Details"]
                                </a>
                                @if (item.State == ContactMessageState.Pending)
                                {
                                    <form asp-action="MarkHandled" asp-route-id="@item.Id" method="post" class="d-flex w-100 m-0">
                                        <button type="submit" class="btn btn-outline-success btn-sm d-inline align-items-center gap-1 w-100">
                                            <i class="bi bi-check-lg"></i>
                                            @Localizer["Handle"]
                                        </button>
                                    </form>
                                }
                                <button class="btn btn-outline-danger btn-sm d-inline align-items-center gap-1" onclick="deleteItem('@item.Id', '@item.EmailOrPhone')">
                                    <i class="bi bi-trash"></i>
                                    @Localizer["Delete"]
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    <div class="px-4 pb-4">
        @await Html.PartialAsync("_AdminPagination", Model.Items)
    </div>
</div>

@if (Model.DeletedItems != null && Model.DeletedItems.TotalCount > 0)
{
    <div class="mt-5 mb-4">
        <h3 class="h5 text-danger d-flex align-items-center gap-2">
            <i class="bi bi-trash fs-5"></i>
            @Localizer["DeletedMessages"]
        </h3>
    </div>

    <div class="bg-light border shadow rounded-4 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table table-light table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4 py-3 text-uppercase small fw-bold text-muted" style="width: 25%">@Localizer["Sender"]</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer["Subject"] / @Localizer["Message"]</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer["State"]</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted text-end pe-4">@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.DeletedItems.Items)
                    {
                        <tr id="row-deleted-@item.Id">
                            <td class="ps-4 py-3">
                                <div class="fw-semibold text-muted">@item.EmailOrPhone</div>
                            </td>
                            <td class="py-3">
                                <div class="fw-medium text-muted text-truncate" style="max-width: 300px;">@(string.IsNullOrEmpty(item.Subject) ? Localizer["NoSubject"].Value : item.Subject)</div>
                                <div class="small text-muted text-truncate" style="max-width: 300px;">@item.Message</div>
                            </td>
                            <td class="py-3">
                                <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">@Localizer["Deleted"]</span>
                                <div class="text-muted small mt-2">
                                    <div>
                                        <i class="bi bi-asterisk"></i>
                                        @item.CreatedAtUtc.ToLocalTime().ToString(FormatConstants.DateTimeDot)
                                    </div>
                                </div>
                            </td>
                            <td class="py-3 text-end pe-4">
                                <div class="d-inline-flex flex-column gap-2">
                                    <button class="btn btn-outline-success btn-sm d-inline align-items-center gap-1" onclick="restoreItem('@item.Id', '@item.EmailOrPhone')">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                        @Localizer["Restore"]
                                    </button>
                                    <a class="btn btn-outline-info btn-sm d-inline align-items-center gap-1" asp-action="Details" asp-route-id="@item.Id" title="@Localizer["View"]">
                                        <i class="bi bi-info-circle"></i>
                                        @Localizer["Details"]
                                    </a>
                                    <button class="btn btn-outline-danger btn-sm d-inline align-items-center gap-1" onclick="hardDeleteItem('@item.Id', '@item.EmailOrPhone')">
                                        <i class="bi bi-trash"></i>
                                        @Localizer["DeletePermanently"]
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="px-4 pb-4">
            @await Html.PartialAsync("_AdminPagination", Model.DeletedItems)
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function deleteItem(id, title) {
            Swal.fire({
                title: '@Localizer["AreYouSure"]',
                text: '@Localizer["ConfirmDeleteMessageText"]'.replace('{0}', title),
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: '@Localizer["YesDeleteIt"]',
                cancelButtonText: '@Localizer["Cancel"]'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("Delete")',
                        type: 'POST',
                        data: { 
                            id: id,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            if (response.success) {
                                Swal.fire('@Localizer["DeletedSuccessfully"]', response.message, 'success').then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('@Localizer["Error"]', response.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('@Localizer["Error"]', '@Localizer["ErrorOccurred"]', 'error');
                        }
                    });
                }
            });
        }

        function restoreItem(id, title) {
            $.ajax({
                url: '@Url.Action("Restore")',
                type: 'POST',
                data: { 
                    id: id,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        Swal.fire('@Localizer["RestoredSuccessfully"]', response.message, 'success').then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('@Localizer["Error"]', response.message, 'error');
                    }
                },
                error: function() {
                    Swal.fire('@Localizer["Error"]', '@Localizer["ErrorOccurred"]', 'error');
                }
            });
        }

        function hardDeleteItem(id, title) {
            Swal.fire({
                title: '@Localizer["AreYouSure"]',
                text: '@Localizer["ConfirmDeletePermanentlyMessageText"]'.replace('{0}', title),
                icon: 'error',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: '@Localizer["DeletePermanentlyButton"]',
                cancelButtonText: '@Localizer["Cancel"]'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("HardDelete")',
                        type: 'POST',
                        data: { 
                            id: id,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            if (response.success) {
                                Swal.fire('@Localizer["DeletedSuccessfully"]', response.message, 'success').then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('@Localizer["Error"]', response.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('@Localizer["Error"]', '@Localizer["ErrorOccurred"]', 'error');
                        }
                    });
                }
            });
        }
    </script>
}
