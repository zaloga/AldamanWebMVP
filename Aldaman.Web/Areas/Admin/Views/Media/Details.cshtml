@using Aldaman.Services.Dtos.Media
@model MediaAssetDto
@{
    ViewData.SetPageTitle(Localizer[UIResourceKeys.MediaDetails]);
}

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">@Localizer[UIResourceKeys.AssetPreview]</h6>
                </div>
                <div class="card-body text-center">
                    <div class="bg-light rounded border border-2 border-dashed overflow-hidden d-flex align-items-center justify-content-center" style="min-height: 250px;">
                        @if (Model.IsImage)
                        {
                            <img src="@Model.RelativePath" class="img-fluid" style="object-fit: contain; max-height: 350px;" alt="@Model.AltText">
                        }
                        else if (Model.IsVideo)
                        {
                            <video src="@Model.RelativePath" controls class="img-fluid" style="max-height: 350px;"></video>
                        }
                        else
                        {
                            <i class="bi bi-file-earmark text-muted" style="font-size: 64px;"></i>
                        }
                    </div>
                    <div class="mt-3 text-break small font-monospace text-muted">@Model.RelativePath</div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">@Localizer[UIResourceKeys.Metadata]</h6>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5 text-muted small text-uppercase fw-bold">@Localizer[UIResourceKeys.OriginalFileName]</dt>
                        <dd class="col-sm-7 text-break">@Model.OriginalFileName</dd>

                        <dt class="col-sm-5 text-muted small text-uppercase fw-bold">@Localizer[UIResourceKeys.Title]</dt>
                        <dd class="col-sm-7">@(string.IsNullOrEmpty(Model.Title) ? "-" : Model.Title)</dd>

                        <dt class="col-sm-5 text-muted small text-uppercase fw-bold">@Localizer[UIResourceKeys.AltText]</dt>
                        <dd class="col-sm-7">@(string.IsNullOrEmpty(Model.AltText) ? "-" : Model.AltText)</dd>

                        <dt class="col-sm-5 text-muted small text-uppercase fw-bold">@Localizer[UIResourceKeys.ContentType]</dt>
                        <dd class="col-sm-7"><span class="badge bg-light text-dark border">@Model.ContentType</span></dd>

                        <dt class="col-sm-5 text-muted small text-uppercase fw-bold">@Localizer[UIResourceKeys.FileSize]</dt>
                        <dd class="col-sm-7">@((Model.FileSize / 1024.0).ToString(FormatConstants.FileSizeDecimal)) KB</dd>

                        @if (Model.IsImage && Model.Width.HasValue && Model.Height.HasValue)
                        {
                            <dt class="col-sm-5 text-muted small text-uppercase fw-bold">@Localizer[UIResourceKeys.Dimensions]</dt>
                            <dd class="col-sm-7">@Model.Width x @Model.Height px</dd>
                        }

                        <dt class="col-sm-5 text-muted small text-uppercase fw-bold">@Localizer[UIResourceKeys.Uploaded]</dt>
                        <dd class="col-sm-7">@Model.UploadedAtUtc.ToLocalTime().ToString(FormatConstants.ShortDateTime)</dd>

                        @if (Model.IsDeleted)
                        {
                            <dt class="col-sm-5 text-muted small text-uppercase fw-bold">@Localizer[UIResourceKeys.DeletionDate]</dt>
                            <dd class="col-sm-7 text-danger fw-medium">@Model.DeletedAtUtc?.ToLocalTime().ToString(FormatConstants.ShortDateTime)</dd>
                        }
                    </dl>

                    <hr />

                    <div class="d-grid">
                        @if (!Model.IsDeleted)
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-block mb-2">@Localizer[UIResourceKeys.Edit]</a>
                        }
                        <a asp-action="@(Model.IsDeleted ? "Deleted" : "Index")" class="btn btn-outline-secondary btn-block">@Localizer[UIResourceKeys.Back]</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
