@using Aldaman.Services.Dtos.Media
@using Aldaman.Services.Constants
@model PagedResultDto<MediaAssetDto>
@{
    ViewData.SetPageTitle(Localizer[UIResources.DeletedAssets]);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h3 mb-0 text-danger d-flex align-items-center gap-2">
        <i class="bi bi-trash fs-4"></i>
        @Localizer[UIResources.DeletedAssets]
    </h2>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i>
        @Localizer[UIResources.BackToList]
    </a>
</div>

<div class="mb-4 p-3 bg-light border shadow rounded-4">
    <form method="get" class="row g-3">
        <div class="col-md-3">
            <div class="input-group">
                <span class="input-group-text border-end-0">
                    <i class="bi bi-search" style="font-size: 18px;"></i>
                </span>
                <input type="text" name="SearchTerm" class="form-control border-start-0" placeholder="@Localizer[UIResources.Search]..." value="@Context.Request.Query["SearchTerm"]">
            </div>
        </div>
        <div class="col-md-4">
            <select name="@SortByConstants.SortBy" class="form-select">
                <option value="@SortByConstants.UploadedAt" selected="@(Context.Request.Query[SortByConstants.SortBy] == SortByConstants.UploadedAt)">@Localizer[UIResources.SortByUploadDate]</option>
                <option value="@SortByConstants.FileName" selected="@(Context.Request.Query[SortByConstants.SortBy] == SortByConstants.FileName)">@Localizer[UIResources.SortByFilename]</option>
                <option value="@SortByConstants.Size" selected="@(Context.Request.Query[SortByConstants.SortBy] == SortByConstants.Size)">@Localizer[UIResources.SortBySize]</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="@SortByConstants.SortDescending" class="form-select">
                <option value="true" selected="@(Context.Request.Query[SortByConstants.SortDescending] == "true" || string.IsNullOrEmpty(Context.Request.Query[SortByConstants.SortDescending]))">@Localizer[UIResources.Descending]</option>
                <option value="false" selected="@(Context.Request.Query[SortByConstants.SortDescending] == "false")">@Localizer[UIResources.Ascending]</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary flex-grow-1">@Localizer[UIResources.Filter]</button>
            <button type="button" data-action="clear-filter" data-default-sort-by="@SortByConstants.UploadedAt" data-default-sort-desc="true" class="btn btn-outline-secondary flex-grow-1">@Localizer[UIResources.Clear]</button>
        </div>
    </form>
</div>

<div class="bg-light border shadow rounded-4 overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table table-light table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-4 py-3 text-uppercase small fw-bold text-muted" style="width: 120px">@Localizer[UIResources.Preview]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer[UIResources.FileName]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer[UIResources.Dimensions] / @Localizer[UIResources.Size]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer[UIResources.State]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted text-end pe-4">@Localizer[UIResources.Actions]</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">@Localizer[UIResources.NoItemsFound]</td>
                    </tr>
                }
                @foreach (var item in Model.Items)
                {
                    <tr id="row-deleted-@item.Id">
                        <td class="ps-4 py-3">
                            <div class="bg-light rounded border d-flex align-items-center justify-content-center overflow-hidden shadow-sm opacity-50" style="width: 64px; height: 64px;">
                                @if (item.IsImage)
                                {
                                    <img src="@item.RelativePath" class="img-fluid" style="object-fit: cover; width: 100%; height: 100%; filter: grayscale(100%);" alt="@item.AltTextDefault">
                                }
                                else
                                {
                                    <i class="bi bi-file-earmark text-muted" style="font-size: 32px;"></i>
                                }
                            </div>
                        </td>
                        <td class="py-3">
                            <div class="fw-semibold text-muted text-truncate" style="max-width: 250px;">@item.OriginalFileName</div>
                            <div class="small text-muted">@item.ContentType</div>
                        </td>
                        <td class="py-3">
                            @if (item.IsImage && item.Width.HasValue && item.Height.HasValue)
                            {
                                <div class="small text-muted">@item.Width x @item.Height px</div>
                            }
                            <div class="small text-muted">@((item.FileSize / 1024.0).ToString(FormatConstants.FileSizeDecimal)) KB</div>
                        </td>
                        <td class="py-3">
                            @if (item.DeletedAtUtc.HasValue)
                            {
                                <span class="text-danger small fw-medium">
                                    @string.Format(Localizer[UIResources.DeletedOnDate].Value, item.DeletedAtUtc.Value.ToLocalTime().ToString(FormatConstants.DateDot))
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">@Localizer[UIResources.Deleted]</span>
                            }
                            <div class="text-muted small mt-2">
                                <div>
                                    <i class="bi bi-asterisk"></i>
                                    @item.UploadedAtUtc.ToLocalTime().ToString(FormatConstants.DateTimeDot)
                                </div>
                                @if (item.UpdatedAtUtc.HasValue)
                                {
                                    <div class="text-secondary text-opacity-75 mt-2">
                                        <i class="bi bi-pencil"></i>
                                        @item.UpdatedAtUtc.Value.ToLocalTime().ToString(FormatConstants.DateTimeDot)
                                    </div>
                                }
                            </div>
                        </td>
                        <td class="py-3 text-end pe-4">
                            <div class="d-inline-flex flex-column gap-2">
                                <button class="btn btn-outline-success btn-sm d-inline align-items-center gap-1" data-action="restore" data-id="@item.Id" data-title="@item.OriginalFileName" data-url="@Url.Action("Restore")">
                                    <i class="bi bi-arrow-counterclockwise"></i>
                                    @Localizer[UIResources.Restore]
                                </button>
                                <a class="btn btn-outline-info btn-sm d-inline align-items-center gap-1" asp-action="Details" asp-route-id="@item.Id" title="@Localizer[UIResources.Details]">
                                    <i class="bi bi-info-circle"></i>
                                    @Localizer[UIResources.Details]
                                </a>
                                <button class="btn btn-outline-danger btn-sm d-inline align-items-center gap-1" data-action="hard-delete" data-id="@item.Id" data-title="@item.OriginalFileName" data-url="@Url.Action("HardDelete")">
                                    <i class="bi bi-trash"></i>
                                    @Localizer[UIResources.DeletePermanently]
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="px-4 pb-4">
        @await Html.PartialAsync("_AdminPagination", Model)
    </div>
</div>

@Html.AntiForgeryToken()
