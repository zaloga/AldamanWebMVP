@using Aldaman.Services.Dtos.Media
@model UpdateMediaAssetDto
@{
    ViewData.SetPageTitle(Localizer[UIResources.EditMedia]);
    var (relativePath, isImage) = ViewData.GetMediaPreview();
}

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    @Html.AntiForgeryToken()

    <div class="row">
        <div class="col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">@Localizer[UIResources.AssetPreview]</h6>
                </div>
                <div class="card-body text-center">
                    <div class="bg-light rounded border border-2 border-dashed overflow-hidden d-flex align-items-center justify-content-center" style="min-height: 250px;">
                        @if (isImage)
                        {
                            <img src="@relativePath" class="img-fluid" style="object-fit: contain; max-height: 350px;" alt="@Localizer[UIResources.AssetPreview]">
                        }
                        else
                        {
                            <i class="bi bi-file-earmark text-muted" style="font-size: 64px;"></i>
                        }
                    </div>
                    <div class="mt-3 text-break small font-monospace text-muted">@relativePath</div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">@Localizer[UIResources.EditMedia]</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="TitleDefault" class="form-label fw-medium">@Localizer[UIResources.Title]</label>
                        <input asp-for="TitleDefault" class="form-control" placeholder="@Localizer[UIResources.TitleInfo]" />
                        <span asp-validation-for="TitleDefault" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AltTextDefault" class="form-label fw-medium">@Localizer[UIResources.AltText]</label>
                        <textarea asp-for="AltTextDefault" class="form-control" rows="3" placeholder="@Localizer[UIResources.AltTextInfo]"></textarea>
                        <span asp-validation-for="AltTextDefault" class="text-danger"></span>
                    </div>

                    <hr />

                    <div class="d-grid">
                        <button type="submit" class="btn btn-success btn-block mb-2">@Localizer[UIResources.Save]</button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-block">@Localizer[UIResources.Back]</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

