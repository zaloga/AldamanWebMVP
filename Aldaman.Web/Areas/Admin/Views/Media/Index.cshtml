@using Aldaman.Services.Dtos.Media
@using Aldaman.Services.Constants
@model PagedResultDto<MediaAssetDto>
@{
    ViewData.SetPageTitle(Localizer[UIResourceKeys.MediaLibrary]);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex gap-2">
        <a asp-action="Upload" class="btn btn-success">
            <i class="bi bi-upload"></i>
            @Localizer[UIResourceKeys.UploadMedia]
        </a>
        <a asp-action="Deleted" class="btn btn-outline-danger">
            <i class="bi bi-trash"></i>
            @Localizer[UIResourceKeys.DeletedAssets]
        </a>
    </div>
</div>

<div class="mb-4 p-3 bg-light border shadow rounded-4">
    <form method="get" class="row g-3">
        <div class="col-md-3">
            <div class="input-group">
                <span class="input-group-text border-end-0">
                    <i class="bi bi-search" style="font-size: 18px;"></i>
                </span>
                <input type="text" name="SearchTerm" class="form-control border-start-0" placeholder="@Localizer[UIResourceKeys.Search]..." value="@Context.Request.Query["SearchTerm"]">
            </div>
        </div>
        <div class="col-md-4">
            <select name="SortBy" class="form-select">
                <option value="@SortByConstants.UploadedAt" selected="@(Context.Request.Query["SortBy"] == SortByConstants.UploadedAt)">@Localizer[UIResourceKeys.SortByUploadDate]</option>
                <option value="@SortByConstants.FileName" selected="@(Context.Request.Query["SortBy"] == SortByConstants.FileName)">@Localizer[UIResourceKeys.SortByFilename]</option>
                <option value="@SortByConstants.Size" selected="@(Context.Request.Query["SortBy"] == SortByConstants.Size)">@Localizer[UIResourceKeys.SortBySize]</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="SortDescending" class="form-select">
                <option value="true" selected="@(Context.Request.Query["SortDescending"] == "true" || string.IsNullOrEmpty(Context.Request.Query["SortDescending"]))">@Localizer[UIResourceKeys.Descending]</option>
                <option value="false" selected="@(Context.Request.Query["SortDescending"] == "false")">@Localizer[UIResourceKeys.Ascending]</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary flex-grow-1">@Localizer[UIResourceKeys.Filter]</button>
            <button type="button" data-action="clear-filter" data-default-sort-by="@SortByConstants.UploadedAt" data-default-sort-desc="true" class="btn btn-outline-secondary flex-grow-1">@Localizer[UIResourceKeys.Clear]</button>
        </div>
    </form>
</div>

<div class="bg-light border shadow rounded-4 overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table table-light table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-4 py-3 text-uppercase small fw-bold text-muted" style="width: 120px">@Localizer[UIResourceKeys.Preview]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer[UIResourceKeys.FileName]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer[UIResourceKeys.Title] / @Localizer[UIResourceKeys.AltText]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer[UIResourceKeys.Dimensions] / @Localizer[UIResourceKeys.Size]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer[UIResourceKeys.State]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted text-end pe-4">@Localizer[UIResourceKeys.Actions]</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">@Localizer[UIResourceKeys.NoItemsFound]</td>
                    </tr>
                }
                @foreach (var item in Model.Items)
                {
                    <tr id="row-@item.Id">
                        <td class="ps-4 py-3">
                            <div class="bg-light rounded border d-flex align-items-center justify-content-center overflow-hidden shadow-sm" style="width: 64px; height: 64px;">
                                @if (item.IsImage)
                                {
                                    <img src="@item.RelativePath" class="img-fluid" style="object-fit: cover; width: 100%; height: 100%;" alt="@item.AltText">
                                }
                                else
                                {
                                    <i class="bi bi-file-earmark text-muted" style="font-size: 32px;"></i>
                                }
                            </div>
                        </td>
                        <td class="py-3">
                            <div class="fw-semibold text-dark text-truncate" style="max-width: 250px;">@item.OriginalFileName</div>
                            <div class="small text-muted">@item.ContentType</div>
                        </td>
                        <td class="py-3">
                            <div class="small fw-medium text-dark text-truncate" style="max-width: 200px;">@item.Title</div>
                            <div class="small text-muted text-truncate" style="max-width: 200px;">@item.AltText</div>
                        </td>
                        <td class="py-3">
                            @if (item.IsImage && item.Width.HasValue && item.Height.HasValue)
                            {
                                <div class="small fw-medium">@item.Width x @item.Height px</div>
                            }
                            <div class="small text-muted">@((item.FileSize / 1024.0).ToString(FormatConstants.FileSizeDecimal)) KB</div>
                        </td>
                        <td class="py-3 text-muted small">
                            <div>
                                <i class="bi bi-asterisk"></i>
                                @item.UploadedAtUtc.ToLocalTime().ToString(FormatConstants.DateTimeDot)
                            </div>
                            @if (item.UpdatedAtUtc.HasValue)
                            {
                                <div class="text-secondary text-opacity-75 mt-2">
                                    <i class="bi bi-pencil"></i>
                                    @item.UpdatedAtUtc.Value.ToLocalTime().ToString(FormatConstants.DateTimeDot)
                                </div>
                            }
                        </td>
                        <td class="py-3 text-end pe-4">
                            <div class="d-inline-flex flex-column gap-2">
                                <a class="btn btn-outline-primary btn-sm d-inline align-items-center gap-1" asp-action="Edit" asp-route-id="@item.Id" title="@Localizer[UIResourceKeys.Edit]">
                                    <i class="bi bi-pencil-square"></i>
                                    @Localizer[UIResourceKeys.Edit]
                                </a>
                                <a class="btn btn-outline-info btn-sm d-inline align-items-center gap-1" asp-action="Details" asp-route-id="@item.Id" title="@Localizer[UIResourceKeys.Details]">
                                    <i class="bi bi-info-circle"></i>
                                    @Localizer[UIResourceKeys.Details]
                                </a>
                                <a class="btn btn-outline-secondary btn-sm d-inline align-items-center gap-1" href="@item.RelativePath" target="_blank" title="@Localizer[UIResourceKeys.View]">
                                    <i class="bi bi-box-arrow-up-right"></i>
                                    @Localizer[UIResourceKeys.View]
                                </a>
                                <button class="btn btn-outline-danger btn-sm d-inline align-items-center gap-1" data-action="delete" data-id="@item.Id" data-title="@item.OriginalFileName" data-url="@Url.Action("Delete")" title="@Localizer[UIResourceKeys.Delete]">
                                    <i class="bi bi-trash"></i>
                                    @Localizer[UIResourceKeys.Delete]
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="px-4 pb-4">
        @await Html.PartialAsync("_AdminPagination", Model)
    </div>
</div>

@Html.AntiForgeryToken()
