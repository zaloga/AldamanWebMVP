@model Aldaman.Services.Dtos.Blog.BlogPostEditDto

@{
    var isCreate = Model.Id == null || Model.Id == Guid.Empty;
    ViewData["Title"] = isCreate ? Localizer[UIResourceKeys.CreateBlogPost] : Localizer[UIResourceKeys.UpdateBlogPost];
}

@section Styles {
    <link rel="stylesheet" href="~/lib/quill/quill.snow.css" />
}

<div class="container-fluid">
    <form asp-action="@(isCreate ? "Create" : "Update")" method="post" enctype="multipart/form-data">
        @if (!isCreate)
        {
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CoverMediaAssetId" />
        }
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow mb-4">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">@Localizer[UIResourceKeys.Translations]</h6>
                    </div>
                    <div class="card-body">
                        <partial name="_TranslationTabs" model="Model.Translations.Select(t => t.CultureCode)" />
                        
                        <div class="tab-content" id="translationTabsContent">
                            @{
                                var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
                                var activeCulture = Model.Translations.Any(t => t.CultureCode == currentCulture) 
                                    ? currentCulture 
                                    : Model.Translations.FirstOrDefault()?.CultureCode;
                            }
                            @for (int i = 0; i < Model.Translations.Count; i++)
                            {
                                var culture = Model.Translations[i].CultureCode;
                                var isActive = culture == activeCulture;
                                <div class="tab-pane fade @(isActive ? "show active" : "")" id="content-@culture" role="tabpanel" aria-labelledby="tab-@culture">
                                    <input type="hidden" asp-for="Translations[i].CultureCode" />
                                    
                                    <div class="mb-3">
                                        <label asp-for="Translations[i].Title" class="form-label fw-medium">@Localizer[UIResourceKeys.Title] (@culture.ToUpper())</label>
                                        <input asp-for="Translations[i].Title" class="form-control" />
                                        <span asp-validation-for="Translations[i].Title" class="text-danger"></span>
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="Translations[i].Slug" class="form-label fw-medium">@Localizer[UIResourceKeys.Slug] (@culture.ToUpper())</label>
                                        <div class="input-group">
                                            <input asp-for="Translations[i].Slug" class="form-control" placeholder="@culture.ToLower()/my-post" />
                                            <button type="button" class="btn btn-outline-secondary btn-generate-slug" title="@Localizer[UIResourceKeys.GenerateSlug]">
                                                <i class="bi bi-lightning-charge"></i>
                                            </button>
                                        </div>
                                        <span asp-validation-for="Translations[i].Slug" class="text-danger"></span>
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="Translations[i].Perex" class="form-label fw-medium">@Localizer[UIResourceKeys.Perex] (@culture.ToUpper())</label>
                                        <textarea asp-for="Translations[i].Perex" class="form-control" rows="3"></textarea>
                                        <span asp-validation-for="Translations[i].Perex" class="text-danger"></span>
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="Translations[i].BodyHtml" class="form-label fw-medium">@Localizer[UIResourceKeys.Content] (@culture.ToUpper())</label>
                                        <div class="quill-editor-container bg-white" data-culture="@culture" data-index="@i" style="height: 400px;"></div>
                                        <input type="hidden" asp-for="Translations[i].BodyHtml" />
                                        <span asp-validation-for="Translations[i].BodyHtml" class="text-danger"></span>
                                    </div>
                                    
                                    <input type="hidden" asp-for="Translations[i].BodyDeltaJson" />
                                    <input type="hidden" asp-for="Translations[i].PlainText" />
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow mb-4">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">@Localizer[UIResourceKeys.PostSettings]</h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <div>
                                <label asp-for="PublishedAtUtc" class="form-label fw-medium">@Localizer[UIResourceKeys.PublicationDate]</label>
                                <input asp-for="PublishedAtUtc" class="form-control" type="datetime-local" />
                                <span asp-validation-for="PublishedAtUtc" class="text-danger"></span>
                                <small class="text-muted">@Localizer[UIResourceKeys.PublishDateInfo]</small>
                            </div>
                            <div class="form-check form-switch">
                                <input asp-for="IsPublished" class="form-check-input" type="checkbox" role="switch">
                                <label asp-for="IsPublished" class="form-check-label">@Localizer[UIResourceKeys.IsPublished]</label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CoverImageFile" class="form-label fw-medium">@Localizer[UIResourceKeys.CoverImage]</label>
                            @if (!string.IsNullOrEmpty(Model.CoverImageRelativePath))
                            {
                                <div class="mb-2 position-relative d-inline-block">
                                    <img src="@Model.CoverImageRelativePath" class="img-thumbnail" style="max-height: 200px;" alt="Current Cover" />
                                    <div class="form-check mt-2">
                                        <input asp-for="RemoveCoverImage" class="form-check-input" type="checkbox">
                                        <label asp-for="RemoveCoverImage" class="form-check-label text-danger small">
                                            @Localizer[UIResourceKeys.RemoveImage]
                                        </label>
                                    </div>
                                </div>
                            }
                            <div class="input-group">
                                <label class="input-group-text cursor-pointer" for="CoverImageFile">
                                    <i class="bi bi-upload me-1"></i>
                                    @Localizer[UIResourceKeys.ChooseFile]
                                </label>
                                <input asp-for="CoverImageFile" class="form-control d-none" type="file" accept="image/*" data-action="cover-file-input" data-display-target="coverFileNameDisplay" data-no-file-text="@Localizer[UIResourceKeys.NoFileChosen]" />
                                <span class="form-control bg-light text-muted" id="coverFileNameDisplay">@Localizer[UIResourceKeys.NoFileChosen]</span>
                            </div>
                            <input type="hidden" asp-for="CoverMediaAssetId" />
                            <span asp-validation-for="CoverImageFile" class="text-danger"></span>
                            <small class="text-muted">@Localizer[UIResourceKeys.CoverImageInfo]</small>
                        </div>

                        <hr />

                        <div class="d-grid">
                            <button type="submit" class="btn btn-success btn-block mb-2">@(isCreate ? Localizer[UIResourceKeys.Create] : Localizer[UIResourceKeys.Save])</button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-block">@Localizer[UIResourceKeys.Back]</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/quill/quill.js"></script>
    <script src="~/js/admin-quill.js" asp-append-version="true"></script>
    <script src="~/js/admin-slug.js" asp-append-version="true"></script>
}
