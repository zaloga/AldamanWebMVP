@using Aldaman.Services.Dtos.General
@using Aldaman.Services.Dtos.Blog
@model PagedResultsDto<BlogPostListItemDto>
@{
    ViewData["Title"] = Localizer["BlogPosts"];
    var query = ViewData["Query"] as PaginationQuery ?? new PaginationQuery();
    var deletedQuery = ViewData["DeletedQuery"] as PaginationQuery ?? new PaginationQuery();
}

<div class="mb-4">
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-lg me-1"></i>
        @Localizer["Create"]
    </a>
</div>

<div class="admin-card mb-4 p-3 bg-white border rounded-4">
    <form method="get" class="row g-3">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0">
                    <i class="bi bi-search" style="font-size: 18px;"></i>
                </span>
                <input type="text" name="SearchTerm" class="form-control border-start-0" placeholder="@Localizer["Search"]..." value="@query.SearchTerm">
            </div>
        </div>
        <div class="col-md-3">
            <select name="SortBy" class="form-select">
                <option value="CreatedAt" selected="@(query.SortBy == "CreatedAt")">@Localizer["SortByCreatedDate"]</option>
                <option value="Title" selected="@(query.SortBy == "Title")">@Localizer["SortByTitle"]</option>
                <option value="PublishedAt" selected="@(query.SortBy == "PublishedAt")">@Localizer["SortByPublishDate"]</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="SortDescending" class="form-select">
                <option value="true" selected="@(query.SortDescending == true)">@Localizer["Descending"]</option>
                <option value="false" selected="@(query.SortDescending == false)">@Localizer["Ascending"]</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary flex-grow-1">@Localizer["Filter"]</button>
            <button type="submit" onclick="this.form.SearchTerm.value=''; this.form.SortBy.value='CreatedAt'; this.form.SortDescending.value='true';" class="btn btn-outline-secondary flex-grow-1">@Localizer["Clear"]</button>
        </div>
    </form>
</div>

<div class="admin-card bg-white border rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4 py-3 text-uppercase small fw-bold text-muted">@Localizer["TitleAndPerex"]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer["Slug"]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer["CoverImage"]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer["CreatedAt"]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer["UpdatedAt"]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer["State"]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted text-end pe-4">@Localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody class="border-top-0">
                @if (!Model.Items.Items.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">@Localizer["NoItemsFound"]</td>
                    </tr>
                }
                @foreach (var item in Model.Items.Items)
                {
                    <tr id="row-@item.Id">
                        <td class="ps-4 py-3">
                            <div class="fw-semibold text-dark">@item.Title</div>
                            <div class="small text-muted text-truncate" style="max-width: 300px;">@item.Perex</div>
                        </td>
                        <td class="py-3 text-muted small">
                            @item.Slug
                        </td>
                        <td class="py-3">
                            @if (!string.IsNullOrEmpty(item.CoverImageRelativePath))
                            {
                                <img src="@item.CoverImageRelativePath" alt="@item.Title" class="img-thumbnail"
                                     style="width: 60px; height: 60px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="bg-light border rounded d-flex align-items-center justify-content-center text-muted"
                                     style="width: 60px; height: 60px;">
                                    <i class="bi bi-image" style="font-size: 20px;"></i>
                                </div>
                            }
                        </td>
                        <td class="py-3 text-muted small">
                            @item.CreatedAtUtc.ToLocalTime().ToString("d. M. yyyy HH:mm")
                        </td>
                        <td class="py-3 text-muted small">
                            @(item.UpdatedAtUtc.HasValue ? item.UpdatedAtUtc.Value.ToLocalTime().ToString("d. M. yyyy HH:mm") : "")
                        </td>
                        <td class="py-3">
                            @if (item.IsPublished && item.PublishedAtUtc.HasValue)
                            {
                                <span class="d-flex align-items-center text-success small fw-medium">
                                    <span class="bg-success rounded-circle me-2" style="width: 8px; height: 8px;"></span>
                                    @string.Format(Localizer["PublishedOnDate"].Value, item.PublishedAtUtc.Value.ToLocalTime().ToString("d. M. yyyy"))
                                </span>
                            }
                            else
                            {
                                <span class="d-flex align-items-center text-warning small fw-medium">
                                    <span class="bg-warning rounded-circle me-2" style="width: 8px; height: 8px;"></span>
                                    @Localizer["Draft"]
                                </span>
                            }
                        </td>
                        <td class="py-3 text-end pe-4">
                            <div class="d-inline-flex flex-column gap-2">
                                <a class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-1" asp-action="Update" asp-route-id="@item.Id">
                                    <i class="bi bi-pencil-square"></i>
                                    @Localizer["Edit"]
                                </a>
                                <a class="btn btn-outline-info btn-sm d-inline-flex align-items-center gap-1" asp-action="Details" asp-route-id="@item.Id">
                                    <i class="bi bi-info-circle"></i>
                                    @Localizer["Details"]
                                </a>
                                <button class="btn btn-outline-danger btn-sm d-inline-flex align-items-center gap-1" onclick="deleteItem('@item.Id', '@item.Title')">
                                    <i class="bi bi-trash"></i>
                                    @Localizer["Delete"]
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="px-4 pb-4">
        @await Html.PartialAsync("_AdminPagination", Model.Items)
    </div>
</div>

@if (Model.DeletedItems != null && Model.DeletedItems.TotalCount > 0)
{
    <div class="mt-5 mb-4">
        <h3 class="h5 text-danger d-flex align-items-center gap-2">
            <i class="bi bi-trash fs-5"></i>
            @Localizer["DeletedPosts"]
        </h3>
    </div>

    <div class="admin-card bg-white border rounded-4 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3 text-uppercase small fw-bold text-muted">@Localizer["TitleAndPerex"]</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer["Slug"]</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer["CoverImage"]</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer["CreatedAt"]</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer["UpdatedAt"]</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer["State"]</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted text-end pe-4">@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach (var item in Model.DeletedItems.Items)
                    {
                        <tr id="row-deleted-@item.Id">
                            <td class="ps-4 py-3">
                                <div class="fw-semibold text-dark text-decoration-line-through">@item.Title</div>
                                <div class="small text-muted text-truncate" style="max-width: 300px;">@item.Perex</div>
                            </td>
                            <td class="py-3 text-muted small">
                                @item.Slug
                            </td>
                            <td class="py-3">
                                @if (!string.IsNullOrEmpty(item.CoverImageRelativePath))
                                {
                                    <img src="@item.CoverImageRelativePath" alt="@item.Title" class="img-thumbnail" style="width: 60px; height: 60px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="bg-light border rounded d-flex align-items-center justify-content-center text-muted" style="width: 60px; height: 60px;">
                                        <i class="bi bi-image" style="font-size: 20px;"></i>
                                    </div>
                                }
                            </td>
                            <td class="py-3 text-muted small">
                                @item.CreatedAtUtc.ToLocalTime().ToString("d. M. yyyy HH:mm")
                            </td>
                            <td class="py-3 text-muted small">
                                @(item.UpdatedAtUtc.HasValue ? item.UpdatedAtUtc.Value.ToLocalTime().ToString("d. M. yyyy HH:mm") : "")
                            </td>
                            <td class="py-3">
                                <span class="d-flex align-items-center text-danger small fw-medium">
                                    <span class="bg-danger rounded-circle me-2" style="width: 8px; height: 8px;"></span>
                                    @string.Format(Localizer["DeletedOnDate"].Value, item.DeletedAtUtc.Value.ToLocalTime().ToString("d. M. yyyy"))
                                </span>
                            </td>
                            <td class="py-3 text-end pe-4">
                                <div class="d-inline-flex flex-column gap-2">
                                    <button class="btn btn-outline-success btn-sm d-inline-flex align-items-center gap-1" onclick="restoreItem('@item.Id', '@item.Title')">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                        @Localizer["Restore"]
                                    </button>
                                    <a class="btn btn-outline-info btn-sm d-inline-flex align-items-center gap-1" asp-action="Details" asp-route-id="@item.Id">
                                        <i class="bi bi-info-circle"></i>
                                        @Localizer["Details"]
                                    </a>
                                    <button class="btn btn-outline-danger btn-sm d-inline-flex align-items-center gap-1" onclick="hardDeleteItem('@item.Id', '@item.Title')">
                                        <i class="bi bi-trash"></i>
                                        @Localizer["DeletePermanently"]
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="px-4 pb-4">
            @{
                ViewData["PageParamName"] = "deleted.Page";
                await Html.PartialAsync("_AdminPagination", Model.DeletedItems);
                ViewData["PageParamName"] = null;
            }
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function deleteItem(id, title) {
        Swal.fire({
        title: '@Localizer["AreYouSure"]',
        text: '@Localizer["ConfirmDeleteText"]'.replace('{0}', title),
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#ef4444',
        cancelButtonColor: '#64748b',
        confirmButtonText: '@Localizer["YesDeleteIt"]',
        cancelButtonText: '@Localizer["Cancel"]'
        }).then((result) => {
        if (result.isConfirmed) {
        $.ajax({
        url: '@Url.Action("Delete")',
        type: 'POST',
        data: {
        id: id,
        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
        },
        success: function(response) {
        if (response.success) {
        Swal.fire('@Localizer["DeletedSuccessfully"]', response.message, 'success').then(() => {
        location.reload();
        });
        } else {
        Swal.fire('@Localizer["Error"]', response.message, 'error');
        }
        },
        error: function() {
        Swal.fire('@Localizer["Error"]', '@Localizer["ErrorOccurred"]', 'error');
        }
        });
        }
        });
        }

        function restoreItem(id, title) {
        $.ajax({
        url: '@Url.Action("Restore")',
        type: 'POST',
        data: {
        id: id,
        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
        },
        success: function(response) {
        if (response.success) {
        Swal.fire('@Localizer["RestoredSuccessfully"]', response.message, 'success').then(() => {
        location.reload();
        });
        } else {
        Swal.fire('@Localizer["Error"]', response.message, 'error');
        }
        },
        error: function() {
        Swal.fire('@Localizer["Error"]', '@Localizer["ErrorOccurred"]', 'error');
        }
        });
        }

        function hardDeleteItem(id, title) {
        Swal.fire({
        title: '@Localizer["AreYouSure"]',
        text: '@Localizer["ConfirmDeletePermanentlyText"]'.replace('{0}', title),
        icon: 'error',
        showCancelButton: true,
        confirmButtonColor: '#ef4444',
        cancelButtonColor: '#64748b',
        confirmButtonText: '@Localizer["DeletePermanentlyButton"]',
        cancelButtonText: '@Localizer["Cancel"]'
        }).then((result) => {
        if (result.isConfirmed) {
        $.ajax({
        url: '@Url.Action("HardDelete")',
        type: 'POST',
        data: {
        id: id,
        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
        },
        success: function(response) {
        if (response.success) {
        Swal.fire('@Localizer["DeletedSuccessfully"]', response.message, 'success').then(() => {
        location.reload();
        });
        } else {
        Swal.fire('@Localizer["Error"]', response.message, 'error');
        }
        },
        error: function() {
        Swal.fire('@Localizer["Error"]', '@Localizer["ErrorOccurred"]', 'error');
        }
        });
        }
        });
        }
    </script>
}
