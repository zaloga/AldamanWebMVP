@using Aldaman.Services.Dtos.General
@using Aldaman.Services.Dtos.Blog
@using Aldaman.Web.Models.General
@model PagedResultsDto<BlogPostListItemDto>
@{
    ViewData["Title"] = Localizer["BlogPosts"];
    var query = Model.Query;
}

<div class="mb-4">
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-lg me-1"></i>
        @Localizer["Create"]
    </a>
</div>

<div class="mb-4 p-3 bg-light border shadow rounded-4">
    <form method="get" class="row g-3">
        <div class="col-md-3">
            <div class="input-group">
                <span class="input-group-text border-end-0">
                    <i class="bi bi-search" style="font-size: 18px;"></i>
                </span>
                <input type="text" name="SearchTerm" class="form-control border-start-0" placeholder="@Localizer["Search"]..." value="@query.SearchTerm">
            </div>
        </div>
        <div class="col-md-4">
            <select name="SortBy" class="form-select">
                <option value="@SortByConstants.CreatedAt" selected="@(query.SortBy == SortByConstants.CreatedAt)">@Localizer["SortByCreatedDate"]</option>
                <option value="@SortByConstants.Title" selected="@(query.SortBy == SortByConstants.Title)">@Localizer["SortByTitle"]</option>
                <option value="@SortByConstants.PublishedAt" selected="@(query.SortBy == SortByConstants.PublishedAt)">@Localizer["SortByPublishDate"]</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="SortDescending" class="form-select">
                <option value="true" selected="@(query.SortDescending == true)">@Localizer["Descending"]</option>
                <option value="false" selected="@(query.SortDescending == false)">@Localizer["Ascending"]</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary flex-grow-1">@Localizer["Filter"]</button>
            <button type="submit" onclick="this.form.SearchTerm.value=''; this.form.SortBy.value='@SortByConstants.CreatedAt'; this.form.SortDescending.value='true';" class="btn btn-outline-secondary flex-grow-1">@Localizer["Clear"]</button>
        </div>
    </form>
</div>

<div class="bg-light border shadow rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-light table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-4 py-3 text-uppercase small fw-bold text-muted">@Localizer["BlogPost"]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer["CoverImage"]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer["State"]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted text-end pe-4">@Localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Items.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-5 text-muted">@Localizer["NoItemsFound"]</td>
                    </tr>
                }
                @foreach (var item in Model.Items.Items)
                {
                    <tr id="row-@item.Id">
                        <td class="ps-4 py-3">
                            <div class="fw-semibold text-dark">@item.Title</div>
                            <div class="small text-muted text-truncate mt-2" style="max-width: 300px;">@item.Perex</div>
                            <div class="text-muted small mt-2">
                                @{
                                    var postUrl = Url.RouteUrl("blog_detail", new { area = "", culture = ViewContext.RouteData.Values["culture"], slug = item.Slug }, Context.Request.Scheme);
                                }
                                <a href="@postUrl" target="_blank" class="text-decoration-none text-primary">@postUrl</a>
                            </div>
                        </td>
                        <td class="py-3">
                            @if (!string.IsNullOrEmpty(item.CoverImageRelativePath))
                            {
                                <img src="@item.CoverImageRelativePath" alt="@item.Title" class="img-thumbnail"
                                     style="width: 60px; height: 60px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="bg-light border rounded d-flex align-items-center justify-content-center text-muted"
                                     style="width: 60px; height: 60px;">
                                    <i class="bi bi-image" style="font-size: 20px;"></i>
                                </div>
                            }
                        </td>
                        <td class="py-3">
                            @if (item.IsPublished && item.PublishedAtUtc.HasValue)
                            {
                                <span class="text-success small fw-medium">
                                    @string.Format(Localizer["PublishedOnDate"].Value, item.PublishedAtUtc.Value.ToLocalTime().ToString(FormatConstants.DateDot))
                                </span>
                            }
                            else
                            {
                                <span class="text-warning small fw-medium">
                                    @Localizer["Draft"]
                                </span>
                            }
                            <div class="text-muted small mt-2">
                                <div>
                                    <i class="bi bi-asterisk"></i>
                                    @item.CreatedAtUtc.ToLocalTime().ToString(FormatConstants.DateTimeDot)
                                </div>
                                @if (item.UpdatedAtUtc.HasValue)
                                {
                                    <div class="text-secondary text-opacity-75 mt-2">
                                        <i class="bi bi-pencil"></i>
                                        @item.UpdatedAtUtc.Value.ToLocalTime().ToString(FormatConstants.DateTimeDot)
                                    </div>
                                }
                            </div>
                        </td>
                        <td class="py-3 text-end pe-4">
                            <div class="d-inline-flex flex-column gap-2">
                                <a class="btn btn-outline-primary btn-sm d-inline align-items-center gap-1" asp-action="Update" asp-route-id="@item.Id">
                                    <i class="bi bi-pencil-square"></i>
                                    @Localizer["Edit"]
                                </a>
                                <a class="btn btn-outline-info btn-sm d-inline align-items-center gap-1" asp-action="Details" asp-route-id="@item.Id">
                                    <i class="bi bi-info-circle"></i>
                                    @Localizer["Details"]
                                </a>
                                <button class="btn btn-outline-danger btn-sm d-inline align-items-center gap-1" onclick="deleteItem('@item.Id', '@item.Title')">
                                    <i class="bi bi-trash"></i>
                                    @Localizer["Delete"]
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="px-4 pb-4">
        @await Html.PartialAsync("_AdminPagination", new PaginationViewModel(Model.Items))
    </div>
</div>

@if (Model.DeletedItems != null && Model.DeletedItems.TotalCount > 0)
{
    <div class="mt-5 mb-4">
        <h3 class="h5 text-danger d-flex align-items-center gap-2">
            <i class="bi bi-trash fs-5"></i>
            @Localizer["DeletedPosts"]
        </h3>
    </div>

    <div class="bg-light border shadow rounded-4 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table table-light table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4 py-3 text-uppercase small fw-bold text-muted">@Localizer["BlogPost"]</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer["CoverImage"]</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer["State"]</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted text-end pe-4">@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.DeletedItems.Items)
                    {
                        <tr id="row-deleted-@item.Id">
                            <td class="ps-4 py-3">
                                <div class="fw-semibold text-dark">@item.Title</div>
                                <div class="small text-muted text-truncate mt-2" style="max-width: 300px;">@item.Perex</div>
                                <div class="text-muted small mt-2">
                                    @{
                                        var deletedPostUrl = Url.RouteUrl("blog_detail", new { area = "", culture = ViewContext.RouteData.Values["culture"], slug = item.Slug }, Context.Request.Scheme);
                                    }
                                    <a href="@deletedPostUrl" target="_blank" class="text-decoration-none text-primary">@deletedPostUrl</a>
                                </div>
                            </td>
                            <td class="py-3">
                                @if (!string.IsNullOrEmpty(item.CoverImageRelativePath))
                                {
                                    <img src="@item.CoverImageRelativePath" alt="@item.Title" class="img-thumbnail" style="width: 60px; height: 60px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="bg-light border rounded d-flex align-items-center justify-content-center text-muted" style="width: 60px; height: 60px;">
                                        <i class="bi bi-image" style="font-size: 20px;"></i>
                                    </div>
                                }
                            </td>
                            <td class="py-3">
                                <span class="text-danger small fw-medium">
                                    @string.Format(Localizer["DeletedOnDate"].Value, item.DeletedAtUtc.Value.ToLocalTime().ToString(FormatConstants.DateDot))
                                </span>
                                <div class="text-muted small mt-2">
                                    <div>
                                        <i class="bi bi-asterisk"></i>
                                        @item.CreatedAtUtc.ToLocalTime().ToString(FormatConstants.DateTimeDot)
                                    </div>
                                    @if (item.UpdatedAtUtc.HasValue)
                                    {
                                        <div class="text-secondary text-opacity-75 mt-2">
                                            <i class="bi bi-pencil"></i>
                                            @item.UpdatedAtUtc.Value.ToLocalTime().ToString(FormatConstants.DateTimeDot)
                                        </div>
                                    }
                                </div>
                            </td>
                            <td class="py-3 text-end pe-4">
                                <div class="d-inline-flex flex-column gap-2">
                                    <button class="btn btn-outline-success btn-sm d-inline align-items-center gap-1" onclick="restoreItem('@item.Id', '@item.Title')">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                        @Localizer["Restore"]
                                    </button>
                                    <a class="btn btn-outline-info btn-sm d-inline align-items-center gap-1" asp-action="Details" asp-route-id="@item.Id">
                                        <i class="bi bi-info-circle"></i>
                                        @Localizer["Details"]
                                    </a>
                                    <button class="btn btn-outline-danger btn-sm d-inline align-items-center gap-1" onclick="hardDeleteItem('@item.Id', '@item.Title')">
                                        <i class="bi bi-trash"></i>
                                        @Localizer["DeletePermanently"]
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="px-4 pb-4">
            @await Html.PartialAsync("_AdminPagination", new PaginationViewModel(Model.DeletedItems, "deleted.Page"))
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function deleteItem(id, title) {
        Swal.fire({
        title: '@Localizer["AreYouSure"]',
        text: '@Localizer["ConfirmDeleteText"]'.replace('{0}', title),
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#ef4444',
        cancelButtonColor: '#64748b',
        confirmButtonText: '@Localizer["YesDeleteIt"]',
        cancelButtonText: '@Localizer["Cancel"]'
        }).then((result) => {
        if (result.isConfirmed) {
        $.ajax({
        url: '@Url.Action("Delete")',
        type: 'POST',
        data: {
        id: id,
        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
        },
        success: function(response) {
        if (response.success) {
        Swal.fire('@Localizer["DeletedSuccessfully"]', response.message, 'success').then(() => {
        location.reload();
        });
        } else {
        Swal.fire('@Localizer["Error"]', response.message, 'error');
        }
        },
        error: function() {
        Swal.fire('@Localizer["Error"]', '@Localizer["ErrorOccurred"]', 'error');
        }
        });
        }
        });
        }

        function restoreItem(id, title) {
        $.ajax({
        url: '@Url.Action("Restore")',
        type: 'POST',
        data: {
        id: id,
        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
        },
        success: function(response) {
        if (response.success) {
        Swal.fire('@Localizer["RestoredSuccessfully"]', response.message, 'success').then(() => {
        location.reload();
        });
        } else {
        Swal.fire('@Localizer["Error"]', response.message, 'error');
        }
        },
        error: function() {
        Swal.fire('@Localizer["Error"]', '@Localizer["ErrorOccurred"]', 'error');
        }
        });
        }

        function hardDeleteItem(id, title) {
        Swal.fire({
        title: '@Localizer["AreYouSure"]',
        text: '@Localizer["ConfirmDeletePermanentlyText"]'.replace('{0}', title),
        icon: 'error',
        showCancelButton: true,
        confirmButtonColor: '#ef4444',
        cancelButtonColor: '#64748b',
        confirmButtonText: '@Localizer["DeletePermanentlyButton"]',
        cancelButtonText: '@Localizer["Cancel"]'
        }).then((result) => {
        if (result.isConfirmed) {
        $.ajax({
        url: '@Url.Action("HardDelete")',
        type: 'POST',
        data: {
        id: id,
        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
        },
        success: function(response) {
        if (response.success) {
        Swal.fire('@Localizer["DeletedSuccessfully"]', response.message, 'success').then(() => {
        location.reload();
        });
        } else {
        Swal.fire('@Localizer["Error"]', response.message, 'error');
        }
        },
        error: function() {
        Swal.fire('@Localizer["Error"]', '@Localizer["ErrorOccurred"]', 'error');
        }
        });
        }
        });
        }
    </script>
}
