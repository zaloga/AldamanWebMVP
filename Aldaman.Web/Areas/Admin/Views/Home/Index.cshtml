@model Aldaman.Services.Dtos.AdminDashboard.AdminDashboardStatsDto

@{
    ViewData.SetPageTitle(Localizer[UIResources.Dashboard]);
}

<div class="row row-cols-1 row-cols-lg-2 row-cols-xxl-3 g-4 mb-5">

    <div class="col">
        <div class="card bg-light h-100 shadow rounded-4">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="text-secondary p-2 rounded-3">
                        <i class="bi bi-collection fs-3"></i>
                    </div>
                    <h5 class="fw-bold mb-0">@Localizer[UIResources.ContentGroups] (@Model.TotalContentGroupsCount)</h5>
                </div>
                <div class="mt-auto pt-3 border-top">
                    <a asp-area="Admin" asp-controller="ContentGroups" asp-action="Index" class="text-decoration-none fw-medium text-primary d-flex align-items-center gap-1 small">
                        @Localizer[UIResources.Manage] <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card bg-light h-100 shadow rounded-4">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="text-secondary p-2 rounded-3">
                        <i class="bi bi-files fs-3"></i>
                    </div>
                    <h5 class="fw-bold mb-0">@Localizer[UIResources.Contents] (@Model.TotalContentsCount)</h5>
                </div>
                <div class="mt-auto pt-3 border-top">
                    <a asp-area="Admin" asp-controller="Contents" asp-action="Index" class="text-decoration-none fw-medium text-primary d-flex align-items-center gap-1 small">
                        @Localizer[UIResources.Manage] <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card bg-light h-100 shadow rounded-4">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="text-secondary p-2 rounded-3">
                        <i class="bi bi-images fs-3"></i>
                    </div>
                    <h5 class="fw-bold mb-0">@Localizer[UIResources.MediaLibrary] (@(Model.TotalMediaSizeInBytes / 1048576) MB)</h5>
                </div>
                <div class="mt-auto pt-3 border-top">
                    <a asp-area="Admin" asp-controller="Media" asp-action="Index" class="text-decoration-none fw-medium text-primary d-flex align-items-center gap-1 small">
                        @Localizer[UIResources.Manage] <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card bg-light h-100 shadow rounded-4">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="text-secondary p-2 rounded-3">
                        <i class="bi bi-envelope fs-3"></i>
                    </div>
                    <h5 class="fw-bold mb-0">@Localizer[UIResources.ContactMessages] (@Model.ContactMessagesCount)</h5>
                </div>
                <div class="mt-auto pt-3 border-top">
                    <a asp-area="Admin" asp-controller="ContactMessages" asp-action="Index" class="text-decoration-none fw-medium text-primary d-flex align-items-center gap-1 small">
                        @Localizer[UIResources.Manage] <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card bg-light h-100 shadow rounded-4">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="text-secondary p-2 rounded-3">
                        <i class="bi bi-sliders fs-3"></i>
                    </div>
                    <h5 class="fw-bold mb-0">@Localizer[UIResources.StyleSettings]</h5>
                </div>
                <div class="mt-auto pt-3 border-top">
                    <a asp-area="Admin" asp-controller="StyleSettings" asp-action="Index" class="text-decoration-none fw-medium text-primary d-flex align-items-center gap-1 small">
                        @Localizer[UIResources.Manage] <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>