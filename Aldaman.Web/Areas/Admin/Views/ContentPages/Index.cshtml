@using Aldaman.Services.Dtos.Page
@using Aldaman.Persistence.Enums
@using Aldaman.Services.Dtos.General
@model PagedResultDto<ContentPageListItemDto>
@{
    ViewData["Title"] = Localizer["Pages"];
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-lg me-1"></i>
            @Localizer["Create"]
        </a>
    </div>
    <a asp-action="Deleted" class="btn btn-outline-danger">
        <i class="bi bi-trash"></i>
        @Localizer["DeletedPages"]
    </a>
</div>

<div class="mb-4 p-3 bg-light border shadow rounded-4">
    <form method="get" class="row g-3">
        <div class="col-md-3">
            <div class="input-group">
                <span class="input-group-text border-end-0">
                    <i class="bi bi-search" style="font-size: 18px;"></i>
                </span>
                <input type="text" name="SearchTerm" class="form-control border-start-0" placeholder="@Localizer["Search"]..." value="@Context.Request.Query["SearchTerm"]">
            </div>
        </div>
        <div class="col-md-4">
            <select name="SortBy" class="form-select">
                <option value="@SortByConstants.CreatedAt" selected="@(Context.Request.Query["SortBy"] == SortByConstants.CreatedAt)">@Localizer["SortByCreatedDate"]</option>
                <option value="@SortByConstants.Title" selected="@(Context.Request.Query["SortBy"] == SortByConstants.Title)">@Localizer["SortByTitle"]</option>
                <option value="@SortByConstants.PageOrder" selected="@(Context.Request.Query["SortBy"] == SortByConstants.PageOrder)">@Localizer["SortByOrder"]</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="SortDescending" class="form-select">
                <option value="true" selected="@(Context.Request.Query["SortDescending"] == "true" || string.IsNullOrEmpty(Context.Request.Query["SortDescending"]))">@Localizer["Descending"]</option>
                <option value="false" selected="@(Context.Request.Query["SortDescending"] == "false")">@Localizer["Ascending"]</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary flex-grow-1">@Localizer["Filter"]</button>
            <button type="submit" onclick="this.form.SearchTerm.value=''; this.form.SortBy.value='@SortByConstants.CreatedAt'; this.form.SortDescending.value='true';" class="btn btn-outline-secondary flex-grow-1">@Localizer["Clear"]</button>
        </div>
    </form>
</div>

<div class="bg-light border shadow rounded-4 overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table table-light table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-4 py-3 text-uppercase small fw-bold text-muted">@Localizer["Page"]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted text-center">@Localizer["Locations"] / @Localizer["Order"]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer["State"]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted text-end pe-4">@Localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">@Localizer["NoItemsFound"]</td>
                    </tr>
                }
                @foreach (var item in Model.Items)
                {
                    <tr id="row-@item.Id">
                        <td class="ps-4 py-3">
                            <div class="fw-semibold text-dark">@item.Title</div>
                            <div class="text-muted small mt-2">
                                @{
                                    var pageUrl = Url.RouteUrl("page_detail", new { area = "", culture = ViewContext.RouteData.Values["culture"], slug = item.Slug }, Context.Request.Scheme);
                                }
                                <a href="@pageUrl" target="_blank" class="text-decoration-none text-primary">@pageUrl</a>
                            </div>
                        </td>
                        <td class="py-3 text-center">
                            <div class="d-flex flex-wrap gap-1 justify-content-center">
                                @if (item.PlaceToShow.HasFlag(PlaceToShowEnum.HomePage))
                                {
                                    <i class="bi bi-house-door" data-bs-toggle="tooltip" title="@Localizer["HomePage"]"></i>
                                }
                                @if (item.PlaceToShow.HasFlag(PlaceToShowEnum.TopNavigation))
                                {
                                    <i class="bi bi-window-fullscreen" data-bs-toggle="tooltip" title="@Localizer["TopNavigation"]"></i>
                                }
                                @if (item.PlaceToShow.HasFlag(PlaceToShowEnum.Footer))
                                {
                                    <i class="bi bi-window-fullscreen flip-y" data-bs-toggle="tooltip" title="@Localizer["Footer"]"></i>
                                }
                                @if (item.PlaceToShow == PlaceToShowEnum.None)
                                {
                                   @* nothing... *@
                                }
                            </div>
                            <div class="fw-medium text-secondary pt-1">@item.PageOrder</div>
                        </td>
                        <td class="py-3 text-muted small">
                            <div>
                                <i class="bi bi-asterisk"></i>
                                @item.CreatedAtUtc.ToLocalTime().ToString(FormatConstants.DateTimeDot)
                            </div>
                            @if (item.UpdatedAtUtc.HasValue)
                            {
                                <div class="text-secondary text-opacity-75 mt-2">
                                    <i class="bi bi-pencil"></i>
                                    @item.UpdatedAtUtc.Value.ToLocalTime().ToString(FormatConstants.DateTimeDot)
                                </div>
                            }
                        </td>
                        <td class="py-3 text-end pe-4">
                            <div class="d-inline-flex flex-column gap-2">
                                <a class="btn btn-outline-primary btn-sm d-inline align-items-center gap-1" asp-action="Update" asp-route-id="@item.Id">
                                    <i class="bi bi-pencil-square"></i>
                                    @Localizer["Edit"]
                                </a>
                                <a class="btn btn-outline-info btn-sm d-inline align-items-center gap-1" asp-action="Details" asp-route-id="@item.Id">
                                    <i class="bi bi-info-circle"></i>
                                    @Localizer["Details"]
                                </a>
                                <button class="btn btn-outline-danger btn-sm d-inline align-items-center gap-1" onclick="deleteItem('@item.Id', '@item.Title')">
                                    <i class="bi bi-trash"></i>
                                    @Localizer["Delete"]
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    <div class="px-4 pb-4">
        @await Html.PartialAsync("_AdminPagination", Model)
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function deleteItem(id, title) {
            Swal.fire({
                title: '@Localizer["AreYouSure"]',
                text: '@Localizer["ConfirmDeleteText"]'.replace('{0}', title),
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: '@Localizer["YesDeleteIt"]',
                cancelButtonText: '@Localizer["Cancel"]'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("Delete")',
                        type: 'POST',
                        data: { 
                            id: id,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            if (response.success) {
                                Swal.fire('@Localizer["DeletedSuccessfully"]', response.message, 'success').then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('@Localizer["Error"]', response.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('@Localizer["Error"]', '@Localizer["ErrorOccurred"]', 'error');
                        }
                    });
                }
            });
        }
    </script>
}
