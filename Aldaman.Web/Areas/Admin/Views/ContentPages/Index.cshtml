@using Aldaman.Services.Dtos.Page
@using Aldaman.Persistence.Enums
@using Aldaman.Services.Dtos.General
@model PagedResultDto<ContentPageListItemDto>
@{
    ViewData["Title"] = Localizer[UIResourceKeys.Pages];
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-lg me-1"></i>
            @Localizer[UIResourceKeys.Create]
        </a>
    </div>
    <a asp-action="Deleted" class="btn btn-outline-danger">
        <i class="bi bi-trash"></i>
        @Localizer[UIResourceKeys.DeletedPages]
    </a>
</div>

<div class="mb-4 p-3 bg-light border shadow rounded-4">
    <form method="get" class="row g-3">
        <div class="col-md-3">
            <div class="input-group">
                <span class="input-group-text border-end-0">
                    <i class="bi bi-search" style="font-size: 18px;"></i>
                </span>
                <input type="text" name="SearchTerm" class="form-control border-start-0" placeholder="@Localizer[UIResourceKeys.Search]..." value="@Context.Request.Query["SearchTerm"]">
            </div>
        </div>
        <div class="col-md-4">
            <select name="SortBy" class="form-select">
                <option value="@SortByConstants.CreatedAt" selected="@(Context.Request.Query["SortBy"] == SortByConstants.CreatedAt)">@Localizer[UIResourceKeys.SortByCreatedDate]</option>
                <option value="@SortByConstants.Title" selected="@(Context.Request.Query["SortBy"] == SortByConstants.Title)">@Localizer[UIResourceKeys.SortByTitle]</option>
                <option value="@SortByConstants.PageOrder" selected="@(Context.Request.Query["SortBy"] == SortByConstants.PageOrder)">@Localizer[UIResourceKeys.SortByOrder]</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="SortDescending" class="form-select">
                <option value="true" selected="@(Context.Request.Query["SortDescending"] == "true" || string.IsNullOrEmpty(Context.Request.Query["SortDescending"]))">@Localizer[UIResourceKeys.Descending]</option>
                <option value="false" selected="@(Context.Request.Query["SortDescending"] == "false")">@Localizer[UIResourceKeys.Ascending]</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary flex-grow-1">@Localizer[UIResourceKeys.Filter]</button>
            <button type="submit" onclick="this.form.SearchTerm.value=''; this.form.SortBy.value='@SortByConstants.CreatedAt'; this.form.SortDescending.value='true';" class="btn btn-outline-secondary flex-grow-1">@Localizer[UIResourceKeys.Clear]</button>
        </div>
    </form>
</div>

<div class="bg-light border shadow rounded-4 overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table table-light table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-4 py-3 text-uppercase small fw-bold text-muted">@Localizer[UIResourceKeys.Page]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted text-center">@Localizer[UIResourceKeys.Locations] / @Localizer[UIResourceKeys.Order]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer[UIResourceKeys.State]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted text-end pe-4">@Localizer[UIResourceKeys.Actions]</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">@Localizer[UIResourceKeys.NoItemsFound]</td>
                    </tr>
                }
                @foreach (var item in Model.Items)
                {
                    <tr id="row-@item.Id">
                        <td class="ps-4 py-3">
                            <div class="fw-semibold text-dark">@item.Title</div>
                            <div class="text-muted small mt-2">
                                @{
                                    var pageUrl = Url.RouteUrl("page_detail", new { area = "", culture = ViewContext.RouteData.Values["culture"], slug = item.Slug }, Context.Request.Scheme);
                                }
                                <a href="@pageUrl" target="_blank" class="text-decoration-none text-primary">@pageUrl</a>
                            </div>
                        </td>
                        <td class="py-3 text-center">
                            <div class="d-flex flex-wrap gap-1 justify-content-center">
                                @if (item.PlaceToShow.HasFlag(PlaceToShowEnum.HomePage))
                                {
                                    <i class="bi bi-house-door" data-bs-toggle="tooltip" title="@Localizer[UIResourceKeys.HomePage]"></i>
                                }
                                @if (item.PlaceToShow.HasFlag(PlaceToShowEnum.TopNavigation))
                                {
                                    <i class="bi bi-window-fullscreen" data-bs-toggle="tooltip" title="@Localizer[UIResourceKeys.TopNavigation]"></i>
                                }
                                @if (item.PlaceToShow.HasFlag(PlaceToShowEnum.Footer))
                                {
                                    <i class="bi bi-window-fullscreen flip-y" data-bs-toggle="tooltip" title="@Localizer[UIResourceKeys.Footer]"></i>
                                }
                                @if (item.PlaceToShow == PlaceToShowEnum.None)
                                {
                                   @* nothing... *@
                                }
                            </div>
                            <div class="fw-medium text-secondary pt-1">@item.PageOrder</div>
                        </td>
                        <td class="py-3 text-muted small">
                            <div>
                                <i class="bi bi-asterisk"></i>
                                @item.CreatedAtUtc.ToLocalTime().ToString(FormatConstants.DateTimeDot)
                            </div>
                            @if (item.UpdatedAtUtc.HasValue)
                            {
                                <div class="text-secondary text-opacity-75 mt-2">
                                    <i class="bi bi-pencil"></i>
                                    @item.UpdatedAtUtc.Value.ToLocalTime().ToString(FormatConstants.DateTimeDot)
                                </div>
                            }
                        </td>
                        <td class="py-3 text-end pe-4">
                            <div class="d-inline-flex flex-column gap-2">
                                <a class="btn btn-outline-primary btn-sm d-inline align-items-center gap-1" asp-action="Update" asp-route-id="@item.Id">
                                    <i class="bi bi-pencil-square"></i>
                                    @Localizer[UIResourceKeys.Edit]
                                </a>
                                <a class="btn btn-outline-info btn-sm d-inline align-items-center gap-1" asp-action="Details" asp-route-id="@item.Id">
                                    <i class="bi bi-info-circle"></i>
                                    @Localizer[UIResourceKeys.Details]
                                </a>
                                <button class="btn btn-outline-danger btn-sm d-inline align-items-center gap-1" data-action="delete" data-id="@item.Id" data-title="@item.Title" data-url="@Url.Action("Delete")">
                                    <i class="bi bi-trash"></i>
                                    @Localizer[UIResourceKeys.Delete]
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    <div class="px-4 pb-4">
        @await Html.PartialAsync("_AdminPagination", Model)
    </div>
</div>

@Html.AntiForgeryToken()
