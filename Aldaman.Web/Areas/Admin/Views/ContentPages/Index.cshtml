@using Aldaman.Services.Dtos.Page
@using Aldaman.Persistence.Enums
@using Aldaman.Services.Dtos.General
@model PagedResultsDto<ContentPageListItemDto>
@{
    ViewData["Title"] = Localizer["Pages"];
    var query = ViewData["Query"] as PaginationQuery ?? new PaginationQuery();
    var deletedQuery = ViewData["DeletedQuery"] as PaginationQuery ?? new PaginationQuery();
}

<div class="mb-4">
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-lg me-1"></i>
        @Localizer["Create"]
    </a>
</div>

<div class="admin-card mb-4 p-3 bg-white border rounded-4">
    <form method="get" class="row g-3">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0">
                    <i class="bi bi-search" style="font-size: 18px;"></i>
                </span>
                <input type="text" name="SearchTerm" class="form-control border-start-0" placeholder="@Localizer["Search"]..." value="@query.SearchTerm">
            </div>
        </div>
        <div class="col-md-3">
            <select name="SortBy" class="form-select">
                <option value="CreatedAt" selected="@(query.SortBy == "CreatedAt")">@Localizer["SortByCreatedDate"]</option>
                <option value="Title" selected="@(query.SortBy == "Title")">@Localizer["SortByTitle"]</option>
                <option value="PageOrder" selected="@(query.SortBy == "PageOrder")">@Localizer["SortByOrder"]</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="SortDescending" class="form-select">
                <option value="true" selected="@(query.SortDescending == true)">@Localizer["Descending"]</option>
                <option value="false" selected="@(query.SortDescending == false)">@Localizer["Ascending"]</option>
            </select>
        </div>
        <div class="col-md-1 d-grid">
            <button type="submit" class="btn btn-outline-secondary">@Localizer["Filter"]</button>
        </div>
    </form>
</div>

<div class="admin-card bg-white border rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4 py-3 text-uppercase small fw-bold text-muted" style="width: 30%">@Localizer["Title"]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted text-center">@Localizer["Locations"]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted text-center">@Localizer["Order"]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted text-end pe-4">@Localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody class="border-top-0">
                @if (!Model.Items.Items.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-5 text-muted">@Localizer["NoItemsFound"]</td>
                    </tr>
                }
                @foreach (var item in Model.Items.Items)
                {
                    <tr id="row-@item.Id">
                        <td class="ps-4 py-3">
                            <div class="fw-semibold text-dark">@item.Title</div>
                            <div class="small text-muted">@Localizer["Created"]: @item.CreatedAtUtc.ToLocalTime().ToString("d. M. yyyy")</div>
                        </td>
                        <td class="py-3 text-center">
                            <div class="d-flex flex-wrap gap-1 justify-content-center">
                                @if (item.PlaceToShow.HasFlag(PlaceToShowEnum.HomePage))
                                {
                                    <span class="badge bg-primary text-white">@Localizer["HomePage"]</span>
                                }
                                @if (item.PlaceToShow.HasFlag(PlaceToShowEnum.TopNavigation))
                                {
                                    <span class="badge bg-info text-white">@Localizer["TopNavigation"]</span>
                                }
                                @if (item.PlaceToShow.HasFlag(PlaceToShowEnum.Footer))
                                {
                                    <span class="badge bg-secondary text-white">@Localizer["Footer"]</span>
                                }
                                @if (item.PlaceToShow == PlaceToShowEnum.None)
                                {
                                    <span class="text-muted small">@Localizer["None"]</span>
                                }
                            </div>
                        </td>
                        <td class="py-3 text-center">
                            <span class="fw-medium text-primary">@item.PageOrder</span>
                        </td>
                        <td class="py-3 text-end pe-4">
                            <div class="d-inline-flex flex-column gap-2">
                                <a class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-1" asp-action="Update" asp-route-id="@item.Id">
                                    <i class="bi bi-pencil-square"></i>
                                    @Localizer["Edit"]
                                </a>
                                <a class="btn btn-outline-info btn-sm d-inline-flex align-items-center gap-1" asp-action="Details" asp-route-id="@item.Id">
                                    <i class="bi bi-info-circle"></i>
                                    @Localizer["Details"]
                                </a>
                                <button class="btn btn-outline-danger btn-sm d-inline-flex align-items-center gap-1" onclick="deleteItem('@item.Id', '@item.Title')">
                                    <i class="bi bi-trash"></i>
                                    @Localizer["Delete"]
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    <div class="px-4 pb-4">
        @await Html.PartialAsync("_AdminPagination", Model.Items)
    </div>
</div>

@if (Model.DeletedItems != null && Model.DeletedItems.TotalCount > 0)
{
    <div class="mt-5 mb-4">
        <h3 class="h5 text-danger d-flex align-items-center gap-2">
            <i class="bi bi-trash fs-5"></i>
            @Localizer["DeletedPages"]
        </h3>
    </div>

    <div class="admin-card bg-white border rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3 text-uppercase small fw-bold text-muted" style="width: 40%">@Localizer["Title"]</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted text-center">@Localizer["Locations"]</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted text-center">@Localizer["Order"]</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted text-end pe-4">@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach (var item in Model.DeletedItems.Items)
                    {
                        <tr id="row-deleted-@item.Id">
                            <td class="ps-4 py-3">
                                <div class="fw-semibold text-muted text-decoration-line-through">@item.Title</div>
                                <div class="small text-muted">@Localizer["Created"]: @item.CreatedAtUtc.ToLocalTime().ToString("d. M. yyyy")</div>
                            </td>
                            <td class="py-3 text-center">
                                <div class="d-flex flex-wrap gap-1 justify-content-center opacity-50">
                                    @if (item.PlaceToShow.HasFlag(PlaceToShowEnum.HomePage))
                                    {
                                        <span class="badge bg-light text-muted border">@Localizer["HomePage"]</span>
                                    }
                                    @if (item.PlaceToShow.HasFlag(PlaceToShowEnum.TopNavigation))
                                    {
                                        <span class="badge bg-light text-muted border">@Localizer["TopNavigation"]</span>
                                    }
                                    @if (item.PlaceToShow.HasFlag(PlaceToShowEnum.Footer))
                                    {
                                        <span class="badge bg-light text-muted border">@Localizer["Footer"]</span>
                                    }
                                </div>
                            </td>
                            <td class="py-3 text-center">
                                <span class="text-muted">@item.PageOrder</span>
                            </td>
                            <td class="py-3 text-end pe-4">
                                <div class="d-inline-flex flex-column gap-2">
                                    <button class="btn btn-outline-success btn-sm d-inline-flex align-items-center gap-1" onclick="restoreItem('@item.Id', '@item.Title')">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                        @Localizer["Restore"]
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm d-inline-flex align-items-center gap-1" onclick="hardDeleteItem('@item.Id', '@item.Title')">
                                        <i class="bi bi-trash"></i>
                                        @Localizer["DeletePermanently"]
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="px-4 pb-4">
            @{
                ViewData["PageParamName"] = "deleted.Page";
                await Html.PartialAsync("_AdminPagination", Model.DeletedItems);
                ViewData["PageParamName"] = null;
            }
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function deleteItem(id, title) {
            Swal.fire({
                title: '@Localizer["AreYouSure"]',
                text: '@Localizer["ConfirmDeleteText"]'.replace('{0}', title),
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: '@Localizer["YesDeleteIt"]',
                cancelButtonText: '@Localizer["Cancel"]'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("Delete")',
                        type: 'POST',
                        data: { 
                            id: id,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            if (response.success) {
                                Swal.fire('@Localizer["DeletedSuccessfully"]', response.message, 'success').then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('@Localizer["Error"]', response.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('@Localizer["Error"]', '@Localizer["ErrorOccurred"]', 'error');
                        }
                    });
                }
            });
        }

        function restoreItem(id, title) {
            $.ajax({
                url: '@Url.Action("Restore")',
                type: 'POST',
                data: { 
                    id: id,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        Swal.fire('@Localizer["RestoredSuccessfully"]', response.message, 'success').then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('@Localizer["Error"]', response.message, 'error');
                    }
                },
                error: function() {
                    Swal.fire('@Localizer["Error"]', '@Localizer["ErrorOccurred"]', 'error');
                }
            });
        }

        function hardDeleteItem(id, title) {
            Swal.fire({
                title: '@Localizer["AreYouSure"]',
                text: '@Localizer["ConfirmDeletePermanentlyText"]'.replace('{0}', title),
                icon: 'error',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: '@Localizer["DeletePermanentlyButton"]',
                cancelButtonText: '@Localizer["Cancel"]'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("HardDelete")',
                        type: 'POST',
                        data: { 
                            id: id,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            if (response.success) {
                                Swal.fire('@Localizer["DeletedSuccessfully"]', response.message, 'success').then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('@Localizer["Error"]', response.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('@Localizer["Error"]', '@Localizer["ErrorOccurred"]', 'error');
                        }
                    });
                }
            });
        }
    </script>
}
