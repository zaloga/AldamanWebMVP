@using Aldaman.Services.Dtos.ContentGroup
@using Aldaman.Persistence.Enums
@using Aldaman.Services.Dtos.General
@model PagedResultDto<ContentGroupListItemDto>
@{
    ViewData.SetPageTitle(Model.IsDeleted ? Localizer[UIResources.DeletedContentGroups] : Localizer[UIResources.ContentGroups]);
}

@await Html.PartialAsync("_AdminNavTabs", new AdminNavTabsViewModel
{
    IsDeleted = Model.IsDeleted,
    ActiveTitle = Localizer[UIResources.ContentGroups].Value,
    DeletedTitle = Localizer[UIResources.DeletedContentGroups].Value,
    ActiveIcon = "bi-collection"
})

<div class="mb-4 p-3 bg-light border shadow rounded-4">
    <form method="get" class="row g-3">
        @if (Model.IsDeleted)
        {
            <input type="hidden" name="deleted" value="true" />
        }
        <input type="hidden" name="@SortByConstants.SortBy" value="@(Context.Request.Query[SortByConstants.SortBy].ToString() is { Length: > 0 } sb ? sb : SortByConstants.GroupOrder)" />
        <input type="hidden" name="@SortByConstants.SortDescending" value="@(Context.Request.Query[SortByConstants.SortDescending].ToString() is { Length: > 0 } sd ? sd : "false")" />
        <div class="col-md-9 col-lg-10">
            <div class="input-group">
                <span class="input-group-text border-end-0">
                    <i class="bi bi-search" style="font-size: 18px;"></i>
                </span>
                <input type="text" name="SearchTerm" class="form-control border-start-0" placeholder="@Localizer[UIResources.Search]..." value="@Context.Request.Query["SearchTerm"]">
            </div>
        </div>
        <div class="col-md-3 col-lg-2 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary flex-grow-1">@Localizer[UIResources.Filter]</button>
            <button type="button" data-action="clear-filter" data-default-sort-by="@SortByConstants.GroupOrder" data-default-sort-desc="false" class="btn btn-outline-secondary flex-grow-1">@Localizer[UIResources.Clear]</button>
        </div>
    </form>
</div>

@if (!Model.IsDeleted)
{
    <div class="d-flex justify-content-center align-items-center mb-4">
        <a asp-action="Create" class="btn btn-success btn-lg px-4">
            <i class="bi bi-plus-lg me-1"></i>
            @Localizer[UIResources.Create]
        </a>
    </div>
}

<div class="bg-light border shadow rounded-4 overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table table-light table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th sort-by="@SortByConstants.Title" default-descending="false" class="ps-4 py-3 text-uppercase small fw-bold text-muted">@Localizer[UIResources.ContentGroup]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted text-center">@Localizer[UIResources.Locations]</th>
                    <th sort-by="@SortByConstants.GroupOrder" default-descending="false" class="py-3 text-uppercase small fw-bold text-muted text-center">@Localizer[UIResources.Order]</th>
                    <th sort-by="@(Model.IsDeleted ? SortByConstants.DeletedAt : SortByConstants.CreatedAt)" default-descending="true" class="py-3 text-uppercase small fw-bold text-muted">@Localizer[UIResources.State]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted text-end pe-4">@Localizer[UIResources.Actions]</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">@Localizer[UIResources.NoItemsFound]</td>
                    </tr>
                }
                @foreach (var item in Model.Items)
                {
                    var groupUrl = Url.RouteUrl(RouteConstants.ContentGroupDetail, new { area = "", culture = CurrentCulture, slug = item.Slug }, Context.Request.Scheme);
                    <tr id="row-@item.Id">
                        <td class="ps-4 py-3">
                            <div class="fw-semibold @(Model.IsDeleted ? "text-muted" : "text-dark")">@item.Title</div>
                            <div class="text-muted small mt-2 text-break">
                                @groupUrl
                            </div>
                        </td>
                        <td class="py-3 text-center">
                            <div class="d-flex flex-wrap gap-2 justify-content-center small">
                                @if (item.PlaceToShow.HasFlag(PlaceToShowEnum.HomePage))
                                {
                                    <span class="d-inline-flex align-items-center text-nowrap">
                                        <i class="bi bi-house-door fs-6 me-1"></i>@Localizer[UIResources.HomePage]
                                    </span>
                                }
                                @if (item.PlaceToShow.HasFlag(PlaceToShowEnum.TopNavigation))
                                {
                                    <span class="d-inline-flex align-items-center text-nowrap">
                                        <i class="bi bi-window-fullscreen fs-6 me-1"></i>@Localizer[UIResources.TopNavigation]
                                    </span>
                                }
                                @if (item.PlaceToShow.HasFlag(PlaceToShowEnum.Footer))
                                {
                                    <span class="d-inline-flex align-items-center text-nowrap">
                                        <i class="bi bi-window-fullscreen flip-y fs-6 me-1"></i>@Localizer[UIResources.Footer]
                                    </span>
                                }
                                @if (item.PlaceToShow.HasFlag(PlaceToShowEnum.Sidebar))
                                {
                                    <span class="d-inline-flex align-items-center text-nowrap">
                                        <i class="bi bi-layout-sidebar-inset-reverse fs-6 me-1"></i>@Localizer[UIResources.Sidebar]
                                    </span>
                                }
                                @if (item.PlaceToShow == PlaceToShowEnum.None)
                                {
                                    <span class="text-muted">@Localizer[UIResources.NotSet]</span>
                                }
                            </div>
                        </td>
                        <td class="py-3 text-center">
                            <div class="fw-medium text-secondary">@item.GroupOrder</div>
                        </td>
                        <td class="py-3">
                            @if (Model.IsDeleted)
                            {
                                if (item.DeletedAtUtc.HasValue)
                                {
                                    <span class="text-danger small fw-medium">
                                        @string.Format(Localizer[UIResources.DeletedOnDate].Value, item.DeletedAtUtc.Value.ToLocalTime().ToString(FormatConstants.DateDot))
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">@Localizer[UIResources.Deleted]</span>
                                }
                            }
                            <div class="text-muted small @(Model.IsDeleted ? "mt-2" : "")">
                                <div>
                                    <i class="bi bi-asterisk"></i>
                                    @item.CreatedAtUtc.ToLocalTime().ToString(FormatConstants.DateTimeDot)
                                </div>
                                @if (item.UpdatedAtUtc.HasValue)
                                {
                                    <div class="text-secondary text-opacity-75 mt-2">
                                        <i class="bi bi-pencil"></i>
                                        @item.UpdatedAtUtc.Value.ToLocalTime().ToString(FormatConstants.DateTimeDot)
                                    </div>
                                }
                            </div>
                        </td>
                        <td class="py-3 text-end pe-4">
                            <div class="d-inline-flex flex-column flex-xl-row gap-2">
                                @if (Model.IsDeleted)
                                {
                                    <button class="btn btn-outline-success btn-sm d-inline-flex align-items-center justify-content-center gap-1 text-nowrap" data-action="restore" data-id="@item.Id" data-title="@item.Title" data-url="@Url.Action("Restore")">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                        @Localizer[UIResources.Restore]
                                    </button>
                                    <a class="btn btn-outline-info btn-sm d-inline-flex align-items-center justify-content-center gap-1 text-nowrap" asp-action="Details" asp-route-id="@item.Id">
                                        <i class="bi bi-info-circle"></i>
                                        @Localizer[UIResources.Details]
                                    </a>
                                    <a class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center justify-content-center gap-1 text-nowrap" href="@groupUrl" target="_blank">
                                        <i class="bi bi-box-arrow-up-right"></i>
                                        @Localizer[UIResources.Preview]
                                    </a>
                                    <button class="btn btn-outline-danger btn-sm d-inline-flex align-items-center justify-content-center gap-1 text-nowrap" data-action="hard-delete" data-id="@item.Id" data-title="@item.Title" data-url="@Url.Action("HardDelete")">
                                        <i class="bi bi-trash"></i>
                                        @Localizer[UIResources.DeletePermanently]
                                    </button>
                                }
                                else
                                {
                                    <a class="btn btn-outline-primary btn-sm d-inline-flex align-items-center justify-content-center gap-1 text-nowrap" asp-action="Update" asp-route-id="@item.Id">
                                        <i class="bi bi-pencil-square"></i>
                                        @Localizer[UIResources.Edit]
                                    </a>
                                    <a class="btn btn-outline-info btn-sm d-inline-flex align-items-center justify-content-center gap-1 text-nowrap" asp-action="Details" asp-route-id="@item.Id">
                                        <i class="bi bi-info-circle"></i>
                                        @Localizer[UIResources.Details]
                                    </a>
                                    <a class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center justify-content-center gap-1 text-nowrap" href="@groupUrl" target="_blank">
                                        <i class="bi bi-box-arrow-up-right"></i>
                                        @Localizer[UIResources.Preview]
                                    </a>
                                    <button class="btn btn-outline-danger btn-sm d-inline-flex align-items-center justify-content-center gap-1 text-nowrap" data-action="delete" data-id="@item.Id" data-title="@item.Title" data-url="@Url.Action("Delete")">
                                        <i class="bi bi-trash"></i>
                                        @Localizer[UIResources.Delete]
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    <div class="px-4 pb-4">
        @await Html.PartialAsync("_AdminPagination", Model)
    </div>
</div>

@Html.AntiForgeryToken()