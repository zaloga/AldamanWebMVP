@using Aldaman.Persistence.Enums
@model Aldaman.Services.Dtos.ContentGroup.ContentGroupEditDto

@{
    var isCreate = Model.Id == null || Model.Id == Guid.Empty;
    ViewData.SetPageTitle(isCreate ? Localizer[UIResourceKeys.CreateContentGroup] : Localizer[UIResourceKeys.EditContentGroup]);
}

<div class="container-fluid">
    <form asp-action="@(isCreate ? "Create" : "Update")" method="post">
        @if (!isCreate)
        {
            <input type="hidden" asp-for="Id" />
        }
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow mb-4">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">@Localizer[UIResourceKeys.Translations]</h6>
                    </div>
                    <div class="card-body">
                        <partial name="_TranslationTabs" model="Model.Translations.Select(t => t.CultureCode)" />
                        
                        <div class="tab-content" id="translationTabsContent">
                            @{
                                var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
                                var activeCulture = Model.Translations.Any(t => t.CultureCode == currentCulture) 
                                    ? currentCulture 
                                    : Model.Translations.FirstOrDefault()?.CultureCode;
                            }
                            @for (int i = 0; i < Model.Translations.Count; i++)
                            {
                                var culture = Model.Translations[i].CultureCode;
                                var isActive = culture == activeCulture;
                                <div class="tab-pane fade @(isActive ? "show active" : "")" id="content-@culture" role="tabpanel" aria-labelledby="tab-@culture">
                                    <input type="hidden" asp-for="Translations[i].CultureCode" />
                                    
                                    <div class="mb-3">
                                        <label asp-for="Translations[i].Title" class="form-label fw-medium">@Localizer[UIResourceKeys.Title] (@culture.ToUpper())</label>
                                        <input asp-for="Translations[i].Title" class="form-control" placeholder="@Localizer[UIResourceKeys.Title] (@culture.ToUpper())..." />
                                        <span asp-validation-for="Translations[i].Title" class="text-danger"></span>
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="Translations[i].Slug" class="form-label fw-medium">@Localizer[UIResourceKeys.Slug] (@culture.ToUpper())</label>
                                        <div class="input-group">
                                            <input asp-for="Translations[i].Slug" class="form-control" placeholder="group-abc" />
                                            <button type="button" class="btn btn-outline-secondary btn-generate-slug" title="@Localizer[UIResourceKeys.GenerateSlug]">
                                                <i class="bi bi-lightning-charge"></i>
                                            </button>
                                        </div>
                                        <span asp-validation-for="Translations[i].Slug" class="text-danger"></span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow mb-4">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">@Localizer[UIResourceKeys.Settings]</h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label d-block text-dark fw-bold">@Localizer[UIResourceKeys.Locations]</label>
                            <div class="p-3 border rounded bg-light">
                                @foreach (var value in Enum.GetValues<PlaceToShowEnum>().Where(v => v != PlaceToShowEnum.None))
                                {
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" name="PlaceToShow" value="@value" id="loc-@value" @(Model.PlaceToShow.HasFlag(value) ? "checked" : "")>
                                        <label class="form-check-label fw-medium" for="loc-@value">
                                            @if (value == PlaceToShowEnum.HomePage) { <text>@Localizer[UIResourceKeys.HomePage]</text> }
                                            else if (value == PlaceToShowEnum.TopNavigation) { <text>@Localizer[UIResourceKeys.TopNavigation]</text> }
                                            else if (value == PlaceToShowEnum.Footer) { <text>@Localizer[UIResourceKeys.Footer]</text> }
                                            else { @value }
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="GroupOrder" class="form-label fw-bold text-dark">@Localizer[UIResourceKeys.GroupOrder]</label>
                            <input asp-for="GroupOrder" class="form-control" type="number" />
                            <span asp-validation-for="GroupOrder" class="text-danger"></span>
                        </div>

                        <hr />

                        <div class="d-grid">
                            <button type="submit" class="btn btn-success btn-block mb-2">@(isCreate ? Localizer[UIResourceKeys.Create] : Localizer[UIResourceKeys.Save])</button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-block">@Localizer[UIResourceKeys.Back]</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/admin-slug.js" asp-append-version="true"></script>
}
