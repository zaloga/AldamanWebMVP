@using Aldaman.Persistence.Enums
@model Aldaman.Services.Dtos.ContentGroup.ContentGroupEditDto

@{
    var isCreate = Model.Id == null || Model.Id == Guid.Empty;
    ViewData.SetPageTitle(isCreate ? Localizer[UIResources.CreateContentGroup] : Localizer[UIResources.EditContentGroup]);
}

<div class="container-fluid">
    <form asp-action="@(isCreate ? "Create" : "Update")" method="post">
        @if (!isCreate)
        {
            <input type="hidden" asp-for="Id" />
        }
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow mb-4">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">@Localizer[UIResources.Translations]</h6>
                    </div>
                    <div class="card-body">
                        <partial name="_TranslationTabs" model="Model.Translations.Select(t => t.CultureCode)" />
                        
                        <div class="tab-content" id="translationTabsContent">
                            @{
                                var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
                                var activeCulture = Model.Translations.Any(t => t.CultureCode == currentCulture) 
                                    ? currentCulture 
                                    : Model.Translations.FirstOrDefault()?.CultureCode;
                            }
                            @for (int i = 0; i < Model.Translations.Count; i++)
                            {
                                var culture = Model.Translations[i].CultureCode;
                                var isActive = culture == activeCulture;
                                <div class="tab-pane fade @(isActive ? "show active" : "")" id="content-@culture" role="tabpanel" aria-labelledby="tab-@culture">
                                    <input type="hidden" asp-for="Translations[i].CultureCode" />
                                    
                                    <div class="mb-3">
                                        <label asp-for="Translations[i].Title" class="form-label fw-medium">@Localizer[UIResources.Title] (@culture.ToUpper())</label>
                                        <input asp-for="Translations[i].Title" class="form-control" placeholder="@Localizer[UIResources.Title] (@culture.ToUpper())..." />
                                        <span asp-validation-for="Translations[i].Title" class="text-danger"></span>
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="Translations[i].Slug" class="form-label fw-medium">@Localizer[UIResources.Slug] (@culture.ToUpper())</label>
                                        <div class="input-group">
                                            <input asp-for="Translations[i].Slug" class="form-control" placeholder="group-abc" />
                                            <button type="button" class="btn btn-outline-secondary btn-generate-slug" title="@Localizer[UIResources.GenerateSlug]">
                                                <i class="bi bi-lightning-charge"></i>
                                            </button>
                                        </div>
                                        <span asp-validation-for="Translations[i].Slug" class="text-danger"></span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Unified Content Items Selector -->
                <div class="card shadow mb-4">
                    <div class="card-header py-3 d-flex justify-content-between align-items-center">
                        <h6 class="m-0 font-weight-bold text-primary">@Localizer[UIResources.AssociatedContents]</h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-2 mb-3 align-items-center">
                            <div class="col-md-9">
                                <select id="contentsSelect" class="form-select">
                                    <option value="">-- @Localizer[UIResources.SelectContent] --</option>
                                    @foreach (var contentItem in Model.AvailableContents)
                                    {
                                        <option value="@contentItem.Id" data-title="@contentItem.Title" data-slug="@contentItem.Slug">
                                            @contentItem.Title (@contentItem.Slug)
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <button type="button" id="btnAddItem" class="btn btn-outline-primary w-100 d-flex align-items-center justify-content-center gap-1">
                                    <i class="bi bi-plus-lg"></i>
                                    @Localizer[UIResources.AddItem]
                                </button>
                            </div>
                        </div>

                        <div id="selectedItemsContainer" class="list-group">
                            <div class="empty-items-message text-muted text-center py-3 bg-light rounded border @(Model.SelectedItems.Any() ? "d-none" : "")">
                                @Localizer[UIResources.NoContentsSelected]
                            </div>
                            @for (int i = 0; i < Model.SelectedItems.Count; i++)
                            {
                                var item = Model.SelectedItems[i];
                                <div class="list-group-item d-flex justify-content-between align-items-center content-group-item-row p-2 mb-1 bg-white border rounded">
                                    <div class="d-flex align-items-center gap-2 text-truncate me-2">
                                        <span class="badge bg-secondary order-badge">@(i + 1)</span>
                                        <span class="fw-medium text-dark text-truncate">@item.Title</span>
                                        <span class="text-muted small font-monospace d-none d-md-inline">/@item.Slug</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-1 flex-shrink-0">
                                        <input type="hidden" class="item-id-input" name="SelectedItems[@i].Id" value="@item.Id" />
                                        <input type="hidden" class="item-title-input" name="SelectedItems[@i].Title" value="@item.Title" />
                                        <input type="hidden" class="item-slug-input" name="SelectedItems[@i].Slug" value="@item.Slug" />
                                        <input type="hidden" class="item-order-input" name="SelectedItems[@i].Order" value="@i" />
                                        <button type="button" class="btn btn-outline-secondary btn-sm btn-move-up" title="@Localizer[UIResources.MoveUp]" @(i == 0 ? "disabled" : "")>
                                            <i class="bi bi-arrow-up"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm btn-move-down" title="@Localizer[UIResources.MoveDown]" @(i == Model.SelectedItems.Count - 1 ? "disabled" : "")>
                                            <i class="bi bi-arrow-down"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-danger btn-sm btn-remove-item" title="@Localizer[UIResources.Remove]">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

            </div>

            <div class="col-lg-4">
                <div class="card shadow mb-4">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">@Localizer[UIResources.Settings]</h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label d-block text-dark fw-bold">@Localizer[UIResources.Locations]</label>
                            <div class="p-3 border rounded bg-light">
                                @foreach (var value in Enum.GetValues<PlaceToShowEnum>().Where(v => v != PlaceToShowEnum.None))
                                {
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" name="PlaceToShow" value="@value" id="loc-@value" @(Model.PlaceToShow.HasFlag(value) ? "checked" : "")>
                                        <label class="form-check-label fw-medium" for="loc-@value">
                                            @if (value == PlaceToShowEnum.HomePage) { <text>@Localizer[UIResources.HomePage]</text> }
                                            else if (value == PlaceToShowEnum.TopNavigation) { <text>@Localizer[UIResources.TopNavigation]</text> }
                                            else if (value == PlaceToShowEnum.Footer) { <text>@Localizer[UIResources.Footer]</text> }
                                            else { @value }
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="GroupOrder" class="form-label fw-bold text-dark">@Localizer[UIResources.GroupOrder]</label>
                            <input asp-for="GroupOrder" class="form-control" type="number" />
                            <span asp-validation-for="GroupOrder" class="text-danger"></span>
                        </div>

                        <hr />

                        <div class="d-grid">
                            <button type="submit" class="btn btn-success btn-block mb-2">@(isCreate ? Localizer[UIResources.Create] : Localizer[UIResources.Save])</button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-block">@Localizer[UIResources.Back]</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/admin-slug.js" asp-append-version="true"></script>
    <script src="~/js/admin-content-groups.js" asp-append-version="true"></script>
}

