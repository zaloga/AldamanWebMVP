@using Aldaman.Persistence.Enums
@model Aldaman.Services.Dtos.ContentGroup.ContentGroupEditDto

@{
    ViewData.SetPageTitle(Localizer[UIResourceKeys.ContentGroupDetails]);
}

<div class="container-fluid">
    <div class="row">

        <div class="col-lg-8">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">@Localizer[UIResourceKeys.Translations]</h6>
                </div>
                <div class="card-body">
                    @{
                        var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
                        var activeCulture = Model.Translations.Any(t => t.CultureCode == currentCulture) 
                            ? currentCulture 
                            : Model.Translations.FirstOrDefault()?.CultureCode;
                    }
                    <ul class="nav nav-tabs mb-3" id="detailsTabs" role="tablist">
                        @for (int i = 0; i < Model.Translations.Count; i++)
                        {
                            var culture = Model.Translations[i].CultureCode;
                            var isActive = culture == activeCulture;
                            <li class="nav-item" role="presentation">
                                <button class="nav-link @(isActive ? "active" : "")" id="tab-@culture" data-bs-toggle="tab" data-bs-target="#content-@culture" type="button" role="tab" aria-controls="content-@culture" aria-selected="@(isActive ? "true" : "false")">
                                    @culture.ToUpper()
                                </button>
                            </li>
                        }
                    </ul>
                    <div class="tab-content" id="detailsTabsContent">
                        @for (int i = 0; i < Model.Translations.Count; i++)
                        {
                            var translation = Model.Translations[i];
                            var culture = translation.CultureCode;
                            var isActive = culture == activeCulture;
                            <div class="tab-pane fade @(isActive ? "show active" : "")" id="content-@culture" role="tabpanel" aria-labelledby="tab-@culture">
                                <dl class="row">
                                    <dt class="col-sm-2 text-muted small text-uppercase fw-bold">@Localizer[UIResourceKeys.Title]</dt>
                                    <dd class="col-sm-10">
                                        @if (string.IsNullOrWhiteSpace(translation.Title))
                                        {
                                            <span class="text-muted">@Localizer[UIResourceKeys.None]</span>
                                        }
                                        else
                                        {
                                            @translation.Title
                                        }
                                    </dd>

                                    <dt class="col-sm-2 text-muted small text-uppercase fw-bold">URL</dt>
                                    <dd class="col-sm-10 font-monospace">
                                        @if (string.IsNullOrWhiteSpace(translation.Slug))
                                        {
                                            <span class="text-muted">@Localizer[UIResourceKeys.None]</span>
                                        }
                                        else
                                        {
                                            var url = Url.Action("Detail", "ContentGroup", new { area = "", culture = translation.CultureCode, slug = translation.Slug });
                                            <a href="@url" target="_blank">@url</a>
                                        }
                                    </dd>
                                </dl>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Associated Content Items Details -->
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">@Localizer[UIResourceKeys.AssociatedContents]</h6>
                </div>
                <div class="card-body">
                    @if (!Model.SelectedItems.Any())
                    {
                        <p class="text-muted mb-0">@Localizer[UIResourceKeys.NoContentsSelected]</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th style="width: 80px;">@Localizer[UIResourceKeys.Order]</th>
                                        <th>@Localizer[UIResourceKeys.Title]</th>
                                        <th>@Localizer[UIResourceKeys.Slug]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.SelectedItems.OrderBy(x => x.Order))
                                    {
                                        <tr>
                                            <td><span class="badge bg-secondary">@(item.Order + 1)</span></td>
                                            <td class="fw-medium">@item.Title</td>
                                            <td class="font-monospace small text-muted">/@item.Slug</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>


        <div class="col-lg-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">@Localizer[UIResourceKeys.Settings]</h6>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-6 text-muted small text-uppercase fw-bold">@Localizer[UIResourceKeys.State]</dt>
                        <dd class="col-sm-6">
                            @if (Model.IsDeleted)
                            {
                                <span class="badge bg-danger">@Localizer[UIResourceKeys.Deleted]</span>
                            }
                            else
                            {
                                <span class="badge bg-success">@Localizer[UIResourceKeys.Active]</span>
                            }
                        </dd>

                        @if (Model.IsDeleted)
                        {
                            <dt class="col-sm-6 text-muted small text-uppercase fw-bold">@Localizer[UIResourceKeys.DeletionDate]</dt>
                            <dd class="col-sm-6 text-danger">@Model.DeletedAtUtc?.ToLocalTime().ToString(FormatConstants.ShortDateTime)</dd>
                        }

                        <dt class="col-sm-6 text-muted small text-uppercase fw-bold">@Localizer[UIResourceKeys.Locations]</dt>
                        <dd class="col-sm-6">
                            <div class="d-flex flex-wrap gap-1">
                                @if (Model.PlaceToShow.HasFlag(PlaceToShowEnum.HomePage))
                                {
                                    <i class="bi bi-house-door" data-bs-toggle="tooltip" title="@Localizer[UIResourceKeys.HomePage]"></i>
                                }
                                @if (Model.PlaceToShow.HasFlag(PlaceToShowEnum.TopNavigation))
                                {
                                    <i class="bi bi-window-fullscreen" data-bs-toggle="tooltip" title="@Localizer[UIResourceKeys.TopNavigation]"></i>
                                }
                                @if (Model.PlaceToShow.HasFlag(PlaceToShowEnum.Footer))
                                {
                                    <i class="bi bi-window-fullscreen flip-y" data-bs-toggle="tooltip" title="@Localizer[UIResourceKeys.Footer]"></i>
                                }
                                @if (Model.PlaceToShow == PlaceToShowEnum.None)
                                {
                                    <span class="text-muted">@Localizer[UIResourceKeys.None]</span>
                                }
                            </div>
                        </dd>

                        <dt class="col-sm-6 text-muted small text-uppercase fw-bold">@Localizer[UIResourceKeys.GroupOrder]</dt>
                        <dd class="col-sm-6 text-secondary fw-medium">@Model.GroupOrder</dd>
                    </dl>

                    <hr />

                    <div class="d-grid">
                        @if (!Model.IsDeleted)
                        {
                            <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-block mb-2">@Localizer[UIResourceKeys.Edit]</a>
                        }
                        <a asp-action="@(Model.IsDeleted ? "Deleted" : "Index")" class="btn btn-outline-secondary btn-block">@Localizer[UIResourceKeys.Back]</a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
