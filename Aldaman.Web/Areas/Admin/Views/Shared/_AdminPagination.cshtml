@model PagedResultBase
@{
    var queryParams = Context.Request.Query.ToDictionary(x => x.Key, x => x.Value.ToString());
}

<nav aria-label="Pagination" class="d-flex justify-content-between align-items-center mt-4">
    <div class="text-muted small">
        @Localizer["Showing"] <span class="fw-semibold">@((Model.Page - 1) * Model.PageSize + 1)</span> @Localizer["To"]
        <span class="fw-semibold">@(Math.Min(Model.Page * Model.PageSize, Model.TotalCount))</span> @Localizer["Of"]
        <span class="fw-semibold">@Model.TotalCount</span> @Localizer["Results"]
    </div>

    @if (Model.TotalPages > 1)
    {
        <ul class="pagination pagination-sm mb-0">
            @{
                var prevParams = new Dictionary<string, string>(queryParams) { ["Page"] = (Model.Page - 1).ToString() };
            }
            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                <a class="page-link" asp-all-route-data="prevParams" tabindex="-1">@Localizer["Previous"]</a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                if (i == 1 || i == Model.TotalPages || (i >= Model.Page - 2 && i <= Model.Page + 2))
                {
                    var pageParams = new Dictionary<string, string>(queryParams) { ["Page"] = i.ToString() };
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-all-route-data="pageParams">@i</a>
                    </li>
                }
                else if (i == 2 || i == Model.TotalPages - 1)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
            }

            @{
                var nextParams = new Dictionary<string, string>(queryParams) { ["Page"] = (Model.Page + 1).ToString() };
            }
            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                <a class="page-link" asp-all-route-data="nextParams">@Localizer["Next"]</a>
            </li>
        </ul>
    }
</nav>
