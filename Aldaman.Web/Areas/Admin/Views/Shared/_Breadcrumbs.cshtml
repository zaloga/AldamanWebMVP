@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var isIndex = action?.Equals("Index", StringComparison.OrdinalIgnoreCase) ?? false;
    var isHome = controller?.Equals("Home", StringComparison.OrdinalIgnoreCase) ?? false;

    string listTitle = ViewData["ListTitle"]?.ToString();
    if (string.IsNullOrEmpty(listTitle))
    {
        listTitle = controller switch
        {
            "Blog" => Localizer["BlogPosts"].Value,
            "ContentPages" => Localizer["Pages"].Value,
            "ContactMessages" => Localizer["ContactMessages"].Value,
            "Media" => Localizer["MediaLibrary"].Value,
            _ => controller
        };
    }
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb h4 p-2">
        <li class="breadcrumb-item">
            <a asp-area="Admin" asp-controller="Home" asp-action="Index" asp-route-culture="@ViewContext.RouteData.Values["culture"]" class="text-decoration-none d-inline-flex align-items-center">
                <i class="bi bi-house-door-fill me-1" style="font-size: 14px;"></i>
                @Localizer["Dashboard"]
            </a>
        </li>
        @if (!isHome && !isIndex)
        {
            <li class="breadcrumb-item">
                <a asp-action="Index" asp-controller="@controller" asp-route-culture="@ViewContext.RouteData.Values["culture"]" class="text-decoration-none">
                    @listTitle
                </a>
            </li>
        }
        @if (ViewData["Title"] != null && ViewData["Title"].ToString() != "Dashboard" && ViewData["Title"].ToString() != Localizer["Dashboard"].Value && (!isHome || !isIndex))
        {
            <li class="breadcrumb-item active" aria-current="page">
                @ViewData["Title"]
            </li>
        }
    </ol>
</nav>
