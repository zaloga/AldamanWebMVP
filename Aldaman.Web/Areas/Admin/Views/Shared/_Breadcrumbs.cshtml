@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var isIndex = action?.Equals("Index", StringComparison.OrdinalIgnoreCase) ?? false;
    var isDeletedAction = action?.Equals("Deleted", StringComparison.OrdinalIgnoreCase) ?? false;
    var isHome = controller?.Equals("Home", StringComparison.OrdinalIgnoreCase) ?? false;

    var isItemDeleted = ViewData.GetIsDeleted() == true;
    if (!isItemDeleted && ViewData.Model != null)
    {
        var prop = ViewData.Model.GetType().GetProperty("IsDeleted");
        if (prop != null && prop.PropertyType == typeof(bool))
        {
            isItemDeleted = (bool)(prop.GetValue(ViewData.Model) ?? false);
        }
    }

    string? listTitle = ViewData.GetBreadcrumbListTitle();
    if (string.IsNullOrEmpty(listTitle))
    {
        listTitle = controller switch
        {
            "Blog" => Localizer[UIResourceKeys.BlogPosts].Value,
            "ContentPages" => Localizer[UIResourceKeys.Pages].Value,
            "ContentGroups" => Localizer[UIResourceKeys.ContentGroups].Value,
            "ContactMessages" => Localizer[UIResourceKeys.ContactMessages].Value,
            "Media" => Localizer[UIResourceKeys.MediaLibrary].Value,
            _ => controller
        };
    }

    string? deletedListTitle = ViewData.GetBreadcrumbDeletedListTitle();
    if (string.IsNullOrEmpty(deletedListTitle))
    {
        deletedListTitle = controller switch
        {
            "Blog" => Localizer[UIResourceKeys.DeletedPosts].Value,
            "ContentPages" => Localizer[UIResourceKeys.DeletedPages].Value,
            "ContentGroups" => Localizer[UIResourceKeys.DeletedContentGroups].Value,
            "ContactMessages" => Localizer[UIResourceKeys.DeletedMessages].Value,
            "Media" => Localizer[UIResourceKeys.DeletedAssets].Value,
            _ => Localizer[UIResourceKeys.Deleted].Value
        };
    }

    var pageTitle = ViewData.GetPageTitle();
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb h4 p-2">
        <li class="breadcrumb-item">
            <a asp-area="Admin" asp-controller="Home" asp-action="Index" asp-route-culture="@ViewContext.RouteData.Values["culture"]" class="text-decoration-none d-inline-flex align-items-center">
                <i class="bi bi-house-door-fill me-1"></i>
                @Localizer[UIResourceKeys.Dashboard]
            </a>
        </li>
        @if (!isHome)
        {
            @if (isIndex)
            {
                <li class="breadcrumb-item active" aria-current="page">
                    @listTitle
                </li>
            }
            else if (isDeletedAction)
            {
                <li class="breadcrumb-item">
                    <a asp-action="Index" asp-controller="@controller" asp-route-culture="@ViewContext.RouteData.Values["culture"]" class="text-decoration-none">
                        @listTitle
                    </a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">
                    @deletedListTitle
                </li>
            }
            else
            {
                <li class="breadcrumb-item">
                    <a asp-action="Index" asp-controller="@controller" asp-route-culture="@ViewContext.RouteData.Values["culture"]" class="text-decoration-none">
                        @listTitle
                    </a>
                </li>
                @if (isItemDeleted)
                {
                    <li class="breadcrumb-item">
                        <a asp-action="Deleted" asp-controller="@controller" asp-route-culture="@ViewContext.RouteData.Values["culture"]" class="text-decoration-none">
                            @deletedListTitle
                        </a>
                    </li>
                }
                @if (!string.IsNullOrEmpty(pageTitle) && pageTitle != "Dashboard" && pageTitle != Localizer[UIResourceKeys.Dashboard].Value)
                {
                    <li class="breadcrumb-item active" aria-current="page">
                        @pageTitle
                    </li>
                }
            }
        }
    </ol>
</nav>
