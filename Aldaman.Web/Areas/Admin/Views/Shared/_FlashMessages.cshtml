@{
    var successMessage = TempData.GetSuccessMessage();
    var errorMessage = TempData.GetErrorMessage();
    var infoMessage = TempData.GetInfoMessage();
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <strong class="d-block">@Localizer[UIResourceKeys.Success]</strong>
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@Localizer[UIResourceKeys.Close]"></button>
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <strong class="d-block">@Localizer[UIResourceKeys.Error]</strong>
        @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@Localizer[UIResourceKeys.Close]"></button>
    </div>
}

@if (!string.IsNullOrEmpty(infoMessage))
{
    <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
        <strong class="d-block">@Localizer[UIResourceKeys.Information]</strong>
        @infoMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@Localizer[UIResourceKeys.Close]"></button>
    </div>
}
