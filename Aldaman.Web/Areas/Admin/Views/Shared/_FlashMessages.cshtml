@if (TempData[TempDataKeys.SuccessMessage] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <strong class="d-block">@Localizer["Success"]</strong>
        @TempData[TempDataKeys.SuccessMessage]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@Localizer["Close"]"></button>
    </div>
}

@if (TempData[TempDataKeys.ErrorMessage] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <strong class="d-block">@Localizer["Error"]</strong>
        @TempData[TempDataKeys.ErrorMessage]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@Localizer["Close"]"></button>
    </div>
}

@if (TempData[TempDataKeys.InfoMessage] != null)
{
    <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
        <strong class="d-block">@Localizer["Information"]</strong>
        @TempData[TempDataKeys.InfoMessage]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@Localizer["Close"]"></button>
    </div>
}
