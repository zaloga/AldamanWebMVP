<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData.GetPageTitle() - Admin - Aldaman</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="h-100 bg-admin d-flex flex-column min-width-600">

    <header class="bg-light shadow mb-4">
        <div class="container-fluid py-3 px-4 d-flex justify-content-between align-items-center">

            <div class="d-flex align-items-center gap-4">
                <a asp-area="Admin" asp-controller="Home" asp-action="Index" asp-route-culture="@ViewContext.RouteData.Values["culture"]" class="text-decoration-none d-flex align-items-center">
                    <span class="h4 mb-0 fw-bold text-primary">@Localizer[UIResources.Admin]</span>
                </a>

                <a asp-area="" asp-controller="Home" asp-action="Index" asp-route-culture="@ViewContext.RouteData.Values["culture"]" class="btn btn-outline-primary btn-md d-flex align-items-center gap-2">
                    <i class="bi bi-box-arrow-up-right"></i> @Localizer[UIResources.GoToWeb]
                </a>
            </div>

            <div class="d-flex align-items-center gap-4">

                @await Component.InvokeAsync("LanguageSwitcher", new { viewName = "Admin" })

                <div class="dropdown">
                    <button class="btn btn-light dropdown-toggle d-flex align-items-center gap-2 border-0" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="rounded-circle bg-secondary text-white d-flex justify-content-center align-items-center" style="width: 32px; height: 32px; font-size: 14px;">
                            A
                        </div>
                        <span class="fw-medium">@Localizer[UIResources.AdminUser]</span>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" aria-labelledby="userDropdown">
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-area="" asp-controller="Account" asp-action="Logout" asp-route-culture="@ViewContext.RouteData.Values["culture"]" method="post" class="m-0">
                                <button type="submit" class="dropdown-item text-danger d-flex align-items-center gap-2">
                                    <i class="bi bi-box-arrow-right"></i> @Localizer[UIResources.SignOut]
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>

            </div>
        </div>
    </header>

    <main class="container-fluid px-4 flex-grow-1">
        <partial name="_Breadcrumbs" />
        <partial name="_FlashMessages" />
        <partial name="_ValidationSummary" />

        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <script id="admin-i18n-data" type="application/json">
        @Html.Raw(Json.Serialize(new
        {
            areYouSure = Localizer[UIResources.AreYouSure].Value,
            confirmDeleteText = Localizer[UIResources.ConfirmDeleteText].Value,
            confirmDeletePermanentlyText = Localizer[UIResources.ConfirmDeletePermanentlyText].Value,
            confirmRestoreText = Localizer[UIResources.ConfirmRestoreText].Value,
            yesDeleteIt = Localizer[UIResources.YesDeleteIt].Value,
            deletePermanentlyButton = Localizer[UIResources.DeletePermanentlyButton].Value,
            cancel = Localizer[UIResources.Cancel].Value,
            save = Localizer[UIResources.Save].Value,
            deletedSuccessfully = Localizer[UIResources.DeletedSuccessfully].Value,
            restoredSuccessfully = Localizer[UIResources.RestoredSuccessfully].Value,
            yes = Localizer[UIResources.Yes].Value,
            fileSizeExceedsLimit = Localizer[UIResources.FileSizeExceedsLimit].Value,
            imageUploadFailed = Localizer[UIResources.ImageUploadFailed].Value,
            errorUploadingImage = Localizer[UIResources.ErrorUploadingImage].Value,
            invalidRequestPayload = Localizer[UIResources.InvalidRequestPayload].Value,
            error = Localizer[UIResources.Error].Value,
            errorOccurred = Localizer[UIResources.ErrorOccurred].Value,
            quillTooltips = new Dictionary<string, string>
            {
                ["bold"] = Localizer[UIResources.RteBold].Value,
                ["italic"] = Localizer[UIResources.RteItalic].Value,
                ["underline"] = Localizer[UIResources.RteUnderline].Value,
                ["strike"] = Localizer[UIResources.RteStrikethrough].Value,
                ["color"] = Localizer[UIResources.RteTextColor].Value,
                ["background"] = Localizer[UIResources.RteBackgroundColor].Value,
                ["script[value=\"sub\"]"] = Localizer[UIResources.RteSubscript].Value,
                ["script[value=\"super\"]"] = Localizer[UIResources.RteSuperscript].Value,
                ["header[value=\"1\"]"] = Localizer[UIResources.RteHeader1].Value,
                ["header[value=\"2\"]"] = Localizer[UIResources.RteHeader2].Value,
                ["header[value=\"3\"]"] = Localizer[UIResources.RteHeader3].Value,
                ["header[value=\"4\"]"] = Localizer[UIResources.RteHeader4].Value,
                ["blockquote"] = Localizer[UIResources.RteBlockquote].Value,
                ["code-block"] = Localizer[UIResources.RteCodeBlock].Value,
                ["list[value=\"ordered\"]"] = Localizer[UIResources.RteListOrdered].Value,
                ["list[value=\"bullet\"]"] = Localizer[UIResources.RteListBullet].Value,
                ["indent[value=\"-1\"]"] = Localizer[UIResources.RteIndentDecrease].Value,
                ["indent[value=\"+1\"]"] = Localizer[UIResources.RteIndentIncrease].Value,
                ["direction"] = Localizer[UIResources.RteDirection].Value,
                ["align"] = Localizer[UIResources.RteAlign].Value,
                ["link"] = Localizer[UIResources.RteLink].Value,
                ["image"] = Localizer[UIResources.RteImage].Value,
                ["video"] = Localizer[UIResources.RteVideo].Value,
                ["formula"] = Localizer[UIResources.RteFormula].Value,
                ["table"] = Localizer[UIResources.RteTable].Value,
                ["tableRows"] = Localizer[UIResources.RteRows].Value,
                ["tableColumns"] = Localizer[UIResources.RteColumns].Value,
                ["tableInsert"] = Localizer[UIResources.RteInsert].Value,
                ["clean"] = Localizer[UIResources.RteClean].Value,
                ["font"] = Localizer[UIResources.RteFont].Value,
                ["size"] = Localizer[UIResources.RteSize].Value,
                ["customColor"] = Localizer[UIResources.RteCustomColor].Value,
                ["imageProperties"] = Localizer[UIResources.RteImageProperties].Value,
                ["alignLeft"] = Localizer[UIResources.RteAlignLeft].Value,
                ["alignCenter"] = Localizer[UIResources.RteAlignCenter].Value,
                ["alignRight"] = Localizer[UIResources.RteAlignRight].Value,
                ["alignInline"] = Localizer[UIResources.RteAlignInline].Value,
                ["width"] = Localizer[UIResources.RteImageWidth].Value,
                ["height"] = Localizer[UIResources.RteImageHeight].Value,
                ["altText"] = Localizer[UIResources.RteImageAltText].Value,
                ["imageTitle"] = Localizer[UIResources.RteImageTitle].Value,
                ["resetSize"] = Localizer[UIResources.RteResetSize].Value,
                ["maintainAspectRatio"] = Localizer[UIResources.RteMaintainAspectRatio].Value,
                ["gallery"] = Localizer[UIResources.RteGallery].Value,
                ["insertGallery"] = Localizer[UIResources.InsertGallery].Value,
                ["editGallery"] = Localizer[UIResources.EditGallery].Value,
                ["columns"] = Localizer[UIResources.Columns].Value,
                ["columnsAuto"] = Localizer[UIResources.ColumnsAuto].Value,
                ["selectImages"] = Localizer[UIResources.SelectImages].Value,
                ["selectedImagesCount"] = Localizer[UIResources.SelectedImagesCount].Value,
                ["gap"] = Localizer[UIResources.Gap].Value,
                ["gapSmall"] = Localizer[UIResources.GapSmall].Value,
                ["gapMedium"] = Localizer[UIResources.GapMedium].Value,
                ["gapLarge"] = Localizer[UIResources.GapLarge].Value,
                ["enableLightbox"] = Localizer[UIResources.EnableLightbox].Value,
                ["deleteGallery"] = Localizer[UIResources.DeleteGallery].Value,
                ["noImagesSelected"] = Localizer[UIResources.NoImagesSelected].Value,
                ["selected"] = Localizer[UIResources.Selected].Value
            }
        }))
    </script>
    <script src="~/js/admin-actions.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>