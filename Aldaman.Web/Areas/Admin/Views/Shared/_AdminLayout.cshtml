<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData.GetPageTitle() - Admin - Aldaman</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="h-100 bg-admin d-flex flex-column min-width-600">

    <header class="bg-light shadow mb-4">
        <div class="container-fluid py-3 px-4 d-flex justify-content-between align-items-center">

            <div class="d-flex align-items-center gap-4">
                <a asp-area="Admin" asp-controller="Home" asp-action="Index" asp-route-culture="@ViewContext.RouteData.Values["culture"]" class="text-decoration-none d-flex align-items-center">
                    <span class="h4 mb-0 fw-bold text-primary">@Localizer[UIResourceKeys.Admin]</span>
                </a>

                <a asp-area="" asp-controller="Home" asp-action="Index" asp-route-culture="@ViewContext.RouteData.Values["culture"]" class="btn btn-outline-primary btn-md d-flex align-items-center gap-2">
                    <i class="bi bi-box-arrow-up-right"></i> @Localizer[UIResourceKeys.GoToWeb]
                </a>
            </div>

            <div class="d-flex align-items-center gap-4">

                @await Component.InvokeAsync("LanguageSwitcher", new { viewName = "Admin" })

                <div class="dropdown">
                    <button class="btn btn-light dropdown-toggle d-flex align-items-center gap-2 border-0" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="rounded-circle bg-secondary text-white d-flex justify-content-center align-items-center" style="width: 32px; height: 32px; font-size: 14px;">
                            A
                        </div>
                        <span class="fw-medium">@Localizer[UIResourceKeys.AdminUser]</span>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" aria-labelledby="userDropdown">
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-area="" asp-controller="Account" asp-action="Logout" asp-route-culture="@ViewContext.RouteData.Values["culture"]" method="post" class="m-0">
                                <button type="submit" class="dropdown-item text-danger d-flex align-items-center gap-2">
                                    <i class="bi bi-box-arrow-right"></i> @Localizer[UIResourceKeys.SignOut]
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>

            </div>
        </div>
    </header>

    <main class="container-fluid px-4 flex-grow-1">
        <partial name="_Breadcrumbs" />
        <partial name="_FlashMessages" />
        <partial name="_ValidationSummary" />

        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/lib/quill-blot-formatter/quill-blot-formatter.min.js" asp-append-version="true"></script>
    <script id="admin-i18n-data" type="application/json">
        @Html.Raw(Json.Serialize(new
        {
            areYouSure = Localizer[UIResourceKeys.AreYouSure].Value,
            confirmDeleteText = Localizer[UIResourceKeys.ConfirmDeleteText].Value,
            confirmDeletePermanentlyText = Localizer[UIResourceKeys.ConfirmDeletePermanentlyText].Value,
            confirmRestoreText = Localizer[UIResourceKeys.ConfirmRestoreText].Value,
            yesDeleteIt = Localizer[UIResourceKeys.YesDeleteIt].Value,
            deletePermanentlyButton = Localizer[UIResourceKeys.DeletePermanentlyButton].Value,
            cancel = Localizer[UIResourceKeys.Cancel].Value,
            deletedSuccessfully = Localizer[UIResourceKeys.DeletedSuccessfully].Value,
            restoredSuccessfully = Localizer[UIResourceKeys.RestoredSuccessfully].Value,
            yes = Localizer[UIResourceKeys.Yes].Value,
            fileSizeExceedsLimit = Localizer[UIResourceKeys.FileSizeExceedsLimit].Value,
            imageUploadFailed = Localizer[UIResourceKeys.ImageUploadFailed].Value,
            errorUploadingImage = Localizer[UIResourceKeys.ErrorUploadingImage].Value,
            invalidRequestPayload = Localizer[UIResourceKeys.InvalidRequestPayload].Value,
            error = Localizer[UIResourceKeys.Error].Value,
            errorOccurred = Localizer[UIResourceKeys.ErrorOccurred].Value,
            quillTooltips = new Dictionary<string, string>
            {
                ["bold"] = Localizer[UIResourceKeys.RteBold].Value,
                ["italic"] = Localizer[UIResourceKeys.RteItalic].Value,
                ["underline"] = Localizer[UIResourceKeys.RteUnderline].Value,
                ["strike"] = Localizer[UIResourceKeys.RteStrikethrough].Value,
                ["color"] = Localizer[UIResourceKeys.RteTextColor].Value,
                ["background"] = Localizer[UIResourceKeys.RteBackgroundColor].Value,
                ["script[value=\"sub\"]"] = Localizer[UIResourceKeys.RteSubscript].Value,
                ["script[value=\"super\"]"] = Localizer[UIResourceKeys.RteSuperscript].Value,
                ["header[value=\"1\"]"] = Localizer[UIResourceKeys.RteHeader1].Value,
                ["header[value=\"2\"]"] = Localizer[UIResourceKeys.RteHeader2].Value,
                ["header[value=\"3\"]"] = Localizer[UIResourceKeys.RteHeader3].Value,
                ["header[value=\"4\"]"] = Localizer[UIResourceKeys.RteHeader4].Value,
                ["blockquote"] = Localizer[UIResourceKeys.RteBlockquote].Value,
                ["code-block"] = Localizer[UIResourceKeys.RteCodeBlock].Value,
                ["list[value=\"ordered\"]"] = Localizer[UIResourceKeys.RteListOrdered].Value,
                ["list[value=\"bullet\"]"] = Localizer[UIResourceKeys.RteListBullet].Value,
                ["indent[value=\"-1\"]"] = Localizer[UIResourceKeys.RteIndentDecrease].Value,
                ["indent[value=\"+1\"]"] = Localizer[UIResourceKeys.RteIndentIncrease].Value,
                ["direction"] = Localizer[UIResourceKeys.RteDirection].Value,
                ["align"] = Localizer[UIResourceKeys.RteAlign].Value,
                ["link"] = Localizer[UIResourceKeys.RteLink].Value,
                ["image"] = Localizer[UIResourceKeys.RteImage].Value,
                ["video"] = Localizer[UIResourceKeys.RteVideo].Value,
                ["formula"] = Localizer[UIResourceKeys.RteFormula].Value,
                ["table"] = Localizer[UIResourceKeys.RteTable].Value,
                ["tableRows"] = Localizer[UIResourceKeys.RteRows].Value,
                ["tableColumns"] = Localizer[UIResourceKeys.RteColumns].Value,
                ["tableInsert"] = Localizer[UIResourceKeys.RteInsert].Value,
                ["clean"] = Localizer[UIResourceKeys.RteClean].Value,
                ["font"] = Localizer[UIResourceKeys.RteFont].Value,
                ["size"] = Localizer[UIResourceKeys.RteSize].Value,
                ["customColor"] = Localizer[UIResourceKeys.RteCustomColor].Value
            }
        }))
    </script>
    <script src="~/js/admin-actions.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>