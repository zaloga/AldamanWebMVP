<!DOCTYPE html>
<html lang="en" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin - Aldaman</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="h-100 bg-admin d-flex flex-column min-width-600">

    <header class="bg-light shadow mb-4">
        <div class="container-fluid py-3 px-4 d-flex justify-content-between align-items-center">

            <div class="d-flex align-items-center gap-4">
                <a asp-area="Admin" asp-controller="Home" asp-action="Index" asp-route-culture="@ViewContext.RouteData.Values["culture"]" class="text-decoration-none d-flex align-items-center">
                    <span class="h4 mb-0 fw-bold text-primary">@Localizer[UIResourceKeys.Admin]</span>
                </a>

                <a asp-area="" asp-controller="Home" asp-action="Index" asp-route-culture="@ViewContext.RouteData.Values["culture"]" class="btn btn-outline-primary btn-md d-flex align-items-center gap-2">
                    <i class="bi bi-box-arrow-up-right"></i> @Localizer[UIResourceKeys.GoToWeb]
                </a>
            </div>

            <div class="d-flex align-items-center gap-4">

                @await Component.InvokeAsync("LanguageSwitcher", new { viewName = "Admin" })

                <div class="dropdown">
                    <button class="btn btn-light dropdown-toggle d-flex align-items-center gap-2 border-0" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="rounded-circle bg-secondary text-white d-flex justify-content-center align-items-center" style="width: 32px; height: 32px; font-size: 14px;">
                            A
                        </div>
                        <span class="fw-medium">@Localizer[UIResourceKeys.AdminUser]</span>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" aria-labelledby="userDropdown">
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-area="" asp-controller="Account" asp-action="Logout" asp-route-culture="@ViewContext.RouteData.Values["culture"]" method="post" class="m-0">
                                <button type="submit" class="dropdown-item text-danger d-flex align-items-center gap-2">
                                    <i class="bi bi-box-arrow-right"></i> @Localizer[UIResourceKeys.SignOut]
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>

            </div>
        </div>
    </header>

    <main class="container-fluid px-4 flex-grow-1">
        <partial name="_Breadcrumbs" />
        <partial name="_FlashMessages" />
        <partial name="_ValidationSummary" />

        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <script>
        window.AdminI18n = {
            areYouSure: @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.AreYouSure].Value)),
            confirmDeleteText: @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.ConfirmDeleteText].Value)),
            confirmDeletePermanentlyText: @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.ConfirmDeletePermanentlyText].Value)),
            confirmRestoreText: @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.ConfirmRestoreText].Value)),
            yesDeleteIt: @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.YesDeleteIt].Value)),
            deletePermanentlyButton: @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.DeletePermanentlyButton].Value)),
            cancel: @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.Cancel].Value)),
            deletedSuccessfully: @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.DeletedSuccessfully].Value)),
            restoredSuccessfully: @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.RestoredSuccessfully].Value)),
            yes: @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.Yes].Value)),
            fileSizeExceedsLimit: @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.FileSizeExceedsLimit].Value)),
            imageUploadFailed: @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.ImageUploadFailed].Value)),
            errorUploadingImage: @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.ErrorUploadingImage].Value)),
            error: @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.Error].Value)),
            errorOccurred: @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.ErrorOccurred].Value)),
            quillTooltips: {
                'bold': @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.RteBold].Value)),
                'italic': @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.RteItalic].Value)),
                'underline': @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.RteUnderline].Value)),
                'strike': @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.RteStrikethrough].Value)),
                'color': @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.RteTextColor].Value)),
                'background': @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.RteBackgroundColor].Value)),
                'script[value="sub"]': @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.RteSubscript].Value)),
                'script[value="super"]': @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.RteSuperscript].Value)),
                'header[value="1"]': @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.RteHeader1].Value)),
                'header[value="2"]': @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.RteHeader2].Value)),
                'header[value="3"]': @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.RteHeader3].Value)),
                'header[value="4"]': @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.RteHeader4].Value)),
                'blockquote': @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.RteBlockquote].Value)),
                'code-block': @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.RteCodeBlock].Value)),
                'list[value="ordered"]': @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.RteListOrdered].Value)),
                'list[value="bullet"]': @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.RteListBullet].Value)),
                'indent[value="-1"]': @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.RteIndentDecrease].Value)),
                'indent[value="+1"]': @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.RteIndentIncrease].Value)),
                'direction': @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.RteDirection].Value)),
                'align': @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.RteAlign].Value)),
                'link': @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.RteLink].Value)),
                'image': @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.RteImage].Value)),
                'video': @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.RteVideo].Value)),
                'formula': @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.RteFormula].Value)),
                'clean': @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.RteClean].Value)),
                'font': @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.RteFont].Value)),
                'size': @Html.Raw(Json.Serialize(Localizer[UIResourceKeys.RteSize].Value))
            }
        };

    </script>
    <script src="~/js/admin-actions.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>