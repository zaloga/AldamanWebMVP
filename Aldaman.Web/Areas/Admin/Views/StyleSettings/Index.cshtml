@model List<Aldaman.Services.Dtos.StyleSettings.StyleSettingDto>
@using Aldaman.Persistence.Enums

@{
    ViewData["Title"] = Localizer[UIResourceKeys.StyleSettings];
    var deletedItems = ViewBag.DeletedItems as List<Aldaman.Services.Dtos.StyleSettings.StyleSettingDto>;
}

@* commented out for now - TODO do as optionally visible by switch in appsettings.json
    <div class="mb-4">
    <a asp-action="Update" class="btn btn-success">
        <i class="bi bi-plus-lg me-1"></i>
        @Localizer[UIResourceKeys.Create]
    </a>
</div> *@

<div class="bg-light border shadow rounded-4 overflow-hidden mb-4">
    <div class="p-3 border-bottom bg-light">
        <h6 class="m-0 fw-bold text-primary">@Localizer[UIResourceKeys.CustomizeThemeVariables]</h6>
    </div>
    <div class="table-responsive">
        <table class="table table-light table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-4 py-3 text-uppercase small fw-bold text-muted">@Localizer[UIResourceKeys.Key]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer[UIResourceKeys.Type]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer[UIResourceKeys.Value]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted text-end pe-4">@Localizer[UIResourceKeys.Actions]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var setting in Model)
                {
                    <tr id="row-@setting.Id">
                        <td class="ps-4 py-3"><code>@setting.Key</code></td>
                        <td class="py-3">@setting.Type</td>
                        <td class="py-3">
                            <form asp-action="UpdateInline" method="post" class="d-flex align-items-center gap-2 m-0">
                                <input type="hidden" name="id" value="@setting.Id" />
                                
                                @if (setting.Type == CssType.Color)
                                {
                                    <input type="color" name="value" class="form-control form-control-color" value="@setting.Value" title="@Localizer[UIResourceKeys.ChooseColor]">
                                    <input type="text" class="form-control" value="@setting.Value" disabled style="width: 100px;" />
                                }
                                else
                                {
                                    <input type="text" name="value" class="form-control" value="@setting.Value" />
                                }
                                
                                <div class="btn-group btn-group-sm">
                                    <button type="submit" class="btn btn-success">@Localizer[UIResourceKeys.Save]</button>
                                    <button type="button" class="btn btn-outline-secondary" onclick="resetToDefault('@setting.Id', '@setting.Key', '@setting.DefaultValue')" title="@Localizer[UIResourceKeys.ResetToDefault]">
                                        <i class="bi bi-arrow-counterclockwise" style="font-size: 14px;"></i>
                                    </button>
                                </div>
                            </form>
                        </td>
                        <td class="py-3 text-end pe-4">
                            <div class="d-inline-flex gap-1">
                                <a asp-action="UpdatePage" asp-route-id="@setting.Id" class="btn btn-outline-primary btn-sm d-inline align-items-center gap-1" title="@Localizer[UIResourceKeys.Edit]">
                                    <i class="bi bi-pencil-square"></i>
                                    @Localizer[UIResourceKeys.Edit]
                                </a>
                                @* commented out for now - TODO do as optionally visible by switch in appsettings.json
                                    <button class="btn btn-outline-danger btn-sm d-inline align-items-center gap-1" data-action="delete" data-id="@setting.Id" data-title="@setting.Key" data-url="@Url.Action("Delete")" title="@Localizer[UIResourceKeys.Delete]">
                                    <i class="bi bi-trash"></i>
                                    @Localizer[UIResourceKeys.Delete]
                                </button> *@
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (deletedItems != null && deletedItems.Any())
{
    <div class="mt-5 mb-4">
        <h3 class="h5 text-danger d-flex align-items-center gap-2">
            <i class="bi bi-trash fs-5"></i>
            @Localizer[UIResourceKeys.DeletedSettings]
        </h3>
    </div>

    <div class="bg-light border shadow rounded-4 overflow-hidden mb-5">
        <div class="table-responsive">
            <table class="table table-light table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4 py-3 text-uppercase small fw-bold text-muted">@Localizer[UIResourceKeys.Key]</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer[UIResourceKeys.Type]</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer[UIResourceKeys.Value]</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted text-end pe-4">@Localizer[UIResourceKeys.Actions]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in deletedItems)
                    {
                        <tr id="row-deleted-@item.Id">
                            <td class="ps-4 py-3"><code class="text-muted">@item.Key</code></td>
                            <td class="py-3">@item.Type</td>
                            <td class="py-3"><span class="text-muted">@item.Value</span></td>
                            <td class="py-3 text-end pe-4">
                                <div class="d-inline-flex gap-2">
                                    <button class="btn btn-outline-success btn-sm d-inline align-items-center gap-1" data-action="restore" data-id="@item.Id" data-title="@item.Key" data-url="@Url.Action("Restore")">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                        @Localizer[UIResourceKeys.Restore]
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm d-inline align-items-center gap-1" data-action="hard-delete" data-id="@item.Id" data-title="@item.Key" data-url="@Url.Action("HardDelete")">
                                        <i class="bi bi-trash"></i>
                                        @Localizer[UIResourceKeys.DeletePermanently]
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        function resetToDefault(id, key, defaultValue) {
            const i18n = window.AdminI18n || {};
            Swal.fire({
                title: i18n.areYouSure,
                text: key + ' (' + defaultValue + ')',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#6366f1',
                cancelButtonColor: '#64748b',
                confirmButtonText: i18n.yes,
                cancelButtonText: i18n.cancel
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("ResetToDefault")',
                        type: 'POST',
                        data: { 
                            id: id,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            if (response && response.success) {
                                Swal.fire({
                                    title: response.message || '@Localizer[UIResourceKeys.UpdatedSuccessfully]',
                                    icon: 'success'
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                const msg = (response && response.message) ? response.message : i18n.errorOccurred;
                                Swal.fire(i18n.error, msg, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire(i18n.error, i18n.errorOccurred, 'error');
                        }
                    });
                }
            });
        }
    </script>
}
