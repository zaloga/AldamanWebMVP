@model List<Aldaman.Services.Dtos.StyleSettings.StyleSettingDto>
@using Aldaman.Persistence.Enums

@{
    ViewData["Title"] = Localizer["StyleSettings"];
    var deletedItems = ViewBag.DeletedItems as List<Aldaman.Services.Dtos.StyleSettings.StyleSettingDto>;
}

<div class="mb-4">
    <a asp-action="Update" class="btn btn-success">
        <i class="bi bi-plus-lg me-1"></i>
        @Localizer["Create"]
    </a>
</div>

<div class="bg-light border shadow rounded-4 overflow-hidden mb-4">
    <div class="p-3 border-bottom bg-light">
        <h6 class="m-0 fw-bold text-primary">@Localizer["CustomizeThemeVariables"]</h6>
    </div>
    <div class="table-responsive">
        <table class="table table-light table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-4 py-3 text-uppercase small fw-bold text-muted">@Localizer["Key"]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer["Type"]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer["Value"]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted text-end pe-4">@Localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var setting in Model)
                {
                    <tr id="row-@setting.Id">
                        <td class="ps-4 py-3"><code>@setting.Key</code></td>
                        <td class="py-3">@setting.Type</td>
                        <td class="py-3">
                            <form asp-action="UpdateInline" method="post" class="d-flex align-items-center gap-2 m-0">
                                <input type="hidden" name="id" value="@setting.Id" />
                                
                                @if (setting.Type == CssType.Color)
                                {
                                    <input type="color" name="value" class="form-control form-control-color" value="@setting.Value" title="@Localizer["ChooseColor"]">
                                    <input type="text" class="form-control" value="@setting.Value" disabled style="width: 100px;" />
                                }
                                else
                                {
                                    <input type="text" name="value" class="form-control" value="@setting.Value" />
                                }
                                
                                <div class="btn-group btn-group-sm">
                                    <button type="submit" class="btn btn-success">@Localizer["Save"]</button>
                                    <button type="button" class="btn btn-outline-secondary" onclick="resetToDefault('@setting.Id', '@setting.Key', '@setting.DefaultValue')" title="@Localizer["ResetToDefault"]">
                                        <i class="bi bi-arrow-counterclockwise" style="font-size: 14px;"></i>
                                    </button>
                                </div>
                            </form>
                        </td>
                        <td class="py-3 text-end pe-4">
                            <div class="d-inline-flex gap-1">
                                <a asp-action="UpdatePage" asp-route-id="@setting.Id" class="btn btn-outline-primary btn-sm d-inline align-items-center gap-1" title="@Localizer["Edit"]">
                                    <i class="bi bi-pencil-square"></i>
                                    @Localizer["Edit"]
                                </a>
                                <button class="btn btn-outline-danger btn-sm d-inline align-items-center gap-1" onclick="deleteItem('@setting.Id', '@setting.Key')" title="@Localizer["Delete"]">
                                    <i class="bi bi-trash"></i>
                                    @Localizer["Delete"]
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (deletedItems != null && deletedItems.Any())
{
    <div class="mt-5 mb-4">
        <h3 class="h5 text-danger d-flex align-items-center gap-2">
            <i class="bi bi-trash fs-5"></i>
            @Localizer["DeletedSettings"]
        </h3>
    </div>

    <div class="bg-light border shadow rounded-4 overflow-hidden mb-5">
        <div class="table-responsive">
            <table class="table table-light table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4 py-3 text-uppercase small fw-bold text-muted">@Localizer["Key"]</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer["Type"]</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer["Value"]</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted text-end pe-4">@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in deletedItems)
                    {
                        <tr id="row-deleted-@item.Id">
                            <td class="ps-4 py-3"><code class="text-muted">@item.Key</code></td>
                            <td class="py-3">@item.Type</td>
                            <td class="py-3"><span class="text-muted">@item.Value</span></td>
                            <td class="py-3 text-end pe-4">
                                <div class="d-inline-flex gap-2">
                                    <button class="btn btn-outline-success btn-sm d-inline align-items-center gap-1" onclick="restoreItem('@item.Id', '@item.Key')">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                        @Localizer["Restore"]
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm d-inline align-items-center gap-1" onclick="hardDeleteItem('@item.Id', '@item.Key')">
                                        <i class="bi bi-trash"></i>
                                        @Localizer["DeletePermanently"]
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@Html.AntiForgeryToken()

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function deleteItem(id, key) {
            Swal.fire({
                title: '@Localizer["AreYouSure"]',
                text: '@Localizer["ConfirmDeleteText"]'.replace('{0}', key),
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: '@Localizer["YesDeleteIt"]',
                cancelButtonText: '@Localizer["Cancel"]'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("Delete")',
                        type: 'POST',
                        data: { 
                            id: id,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            if (response.success) {
                                Swal.fire('@Localizer["DeletedSuccessfully"]', response.message, 'success').then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('@Localizer["Error"]', response.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('@Localizer["Error"]', '@Localizer["ErrorOccurred"]', 'error');
                        }
                    });
                }
            });
        }

        function resetToDefault(id, key, defaultValue) {
            Swal.fire({
                title: '@Localizer["AreYouSure"]',
                text: key + ' (' + defaultValue + ')',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#6366f1',
                cancelButtonColor: '#64748b',
                confirmButtonText: '@Localizer["Yes"]',
                cancelButtonText: '@Localizer["Cancel"]'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("ResetToDefault")',
                        type: 'POST',
                        data: { 
                            id: id,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            if (response.success) {
                                Swal.fire('@Localizer["UpdatedSuccessfully"]', response.message, 'success').then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('@Localizer["Error"]', response.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('@Localizer["Error"]', '@Localizer["ErrorOccurred"]', 'error');
                        }
                    });
                }
            });
        }

        function restoreItem(id, key) {
            $.ajax({
                url: '@Url.Action("Restore")',
                type: 'POST',
                data: { 
                    id: id,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        Swal.fire('@Localizer["RestoredSuccessfully"]', response.message, 'success').then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('@Localizer["Error"]', response.message, 'error');
                    }
                },
                error: function() {
                    Swal.fire('@Localizer["Error"]', '@Localizer["ErrorOccurred"]', 'error');
                }
            });
        }

        function hardDeleteItem(id, key) {
            Swal.fire({
                title: '@Localizer["AreYouSure"]',
                text: '@Localizer["ConfirmDeletePermanentlyText"]'.replace('{0}', key),
                icon: 'error',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: '@Localizer["DeletePermanentlyButton"]',
                cancelButtonText: '@Localizer["Cancel"]'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("HardDelete")',
                        type: 'POST',
                        data: { 
                            id: id,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            if (response.success) {
                                Swal.fire('@Localizer["DeletedSuccessfully"]', response.message, 'success').then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('@Localizer["Error"]', response.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('@Localizer["Error"]', '@Localizer["ErrorOccurred"]', 'error');
                        }
                    });
                }
            });
        }
    </script>
}
