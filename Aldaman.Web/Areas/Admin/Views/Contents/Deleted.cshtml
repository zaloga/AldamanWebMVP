@using Aldaman.Persistence.Enums
@using Aldaman.Services.Dtos.General
@using Aldaman.Services.Dtos.Content
@model PagedResultDto<ContentListItemDto>
@{
    ViewData.SetPageTitle(Localizer[UIResources.DeletedContents]);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h3 mb-0 text-danger d-flex align-items-center gap-2">
        <i class="bi bi-trash fs-4"></i>
        @Localizer[UIResources.DeletedContents]
    </h2>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i>
        @Localizer[UIResources.BackToList]
    </a>
</div>

<div class="mb-4 p-3 bg-light border shadow rounded-4">
    <form method="get" class="row g-3">
        <div class="col-md-3">
            <div class="input-group">
                <span class="input-group-text border-end-0">
                    <i class="bi bi-search" style="font-size: 18px;"></i>
                </span>
                <input type="text" name="SearchTerm" class="form-control border-start-0" placeholder="@Localizer[UIResources.Search]..." value="@Context.Request.Query["SearchTerm"]">
            </div>
        </div>
        <div class="col-md-4">
            <select name="@SortByConstants.SortBy" class="form-select">
                <option value="@SortByConstants.CreatedAt" selected="@(Context.Request.Query[SortByConstants.SortBy] == SortByConstants.CreatedAt)">@Localizer[UIResources.SortByCreatedDate]</option>
                <option value="@SortByConstants.Title" selected="@(Context.Request.Query[SortByConstants.SortBy] == SortByConstants.Title)">@Localizer[UIResources.SortByTitle]</option>
                <option value="@SortByConstants.PublishedAt" selected="@(Context.Request.Query[SortByConstants.SortBy] == SortByConstants.PublishedAt)">@Localizer[UIResources.SortByPublishDate]</option>
                <option value="@SortByConstants.PageOrder" selected="@(Context.Request.Query[SortByConstants.SortBy] == SortByConstants.PageOrder)">@Localizer[UIResources.SortByOrder]</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="@SortByConstants.SortDescending" class="form-select">
                <option value="true" selected="@(Context.Request.Query[SortByConstants.SortDescending] == "true" || string.IsNullOrEmpty(Context.Request.Query[SortByConstants.SortDescending]))">@Localizer[UIResources.Descending]</option>
                <option value="false" selected="@(Context.Request.Query[SortByConstants.SortDescending] == "false")">@Localizer[UIResources.Ascending]</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary flex-grow-1">@Localizer[UIResources.Filter]</button>
            <button type="button" data-action="clear-filter" data-default-sort-by="@SortByConstants.CreatedAt" data-default-sort-desc="true" class="btn btn-outline-secondary flex-grow-1">@Localizer[UIResources.Clear]</button>
        </div>
    </form>
</div>

<div class="bg-light border shadow rounded-4 overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table table-light table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-4 py-3 text-uppercase small fw-bold text-muted">@Localizer[UIResources.Content]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer[UIResources.CoverImage]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted text-center">@Localizer[UIResources.Locations] / @Localizer[UIResources.Order]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted text-center">@Localizer[UIResources.DisplayMode]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted">@Localizer[UIResources.State]</th>
                    <th class="py-3 text-uppercase small fw-bold text-muted text-end pe-4">@Localizer[UIResources.Actions]</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">@Localizer[UIResources.NoItemsFound]</td>
                    </tr>
                }
                @foreach (var item in Model.Items)
                {
                    <tr id="row-deleted-@item.Id">
                        <td class="ps-4 py-3">
                            <div class="fw-semibold text-dark">@item.Title</div>
                            @if (!string.IsNullOrWhiteSpace(item.Perex))
                            {
                                <div class="small text-muted text-truncate mt-2" style="max-width: 300px;">@item.Perex</div>
                            }
                            <div class="text-muted small mt-2">
                                @{
                                    var culture = (string?)ViewContext.RouteData.Values["culture"] ?? System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
                                    var deletedContentUrl = item.ContentType == ContentTypeEnum.Page
                                        ? Url.RouteUrl("page_detail", new { culture = culture, slug = item.Slug }, Context.Request.Scheme)
                                        : Url.RouteUrl("blog_detail", new { culture = culture, slug = item.Slug }, Context.Request.Scheme);
                                    deletedContentUrl ??= Url.Action("Detail", "Content", new { area = "", culture = culture, slug = item.Slug }, Context.Request.Scheme);
                                }
                                <a href="@deletedContentUrl" target="_blank" class="text-decoration-none text-primary opacity-50">@deletedContentUrl</a>
                            </div>
                        </td>
                        <td class="py-3">
                            @if (!string.IsNullOrEmpty(item.CoverImageRelativePath))
                            {
                                <img src="@item.CoverImageRelativePath" alt="@item.Title" class="img-thumbnail opacity-50" style="width: 60px; height: 60px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="bg-light border rounded d-flex align-items-center justify-content-center text-muted opacity-50" style="width: 60px; height: 60px;">
                                    <i class="bi bi-image" style="font-size: 20px;"></i>
                                </div>
                            }
                        </td>
                        <td class="py-3 text-center">
                            <div class="d-flex flex-wrap gap-1 justify-content-center">
                                @if (item.PlaceToShow.HasFlag(PlaceToShowEnum.HomePage))
                                {
                                    <i class="bi bi-house-door" data-bs-toggle="tooltip" title="@Localizer[UIResources.HomePage]"></i>
                                }
                                @if (item.PlaceToShow.HasFlag(PlaceToShowEnum.TopNavigation))
                                {
                                    <i class="bi bi-window-fullscreen" data-bs-toggle="tooltip" title="@Localizer[UIResources.TopNavigation]"></i>
                                }
                                @if (item.PlaceToShow.HasFlag(PlaceToShowEnum.Footer))
                                {
                                    <i class="bi bi-window-fullscreen flip-y" data-bs-toggle="tooltip" title="@Localizer[UIResources.Footer]"></i>
                                }
                                @if (item.PlaceToShow.HasFlag(PlaceToShowEnum.Sidebar))
                                {
                                    <i class="bi bi-layout-sidebar-inset-reverse" data-bs-toggle="tooltip" title="@Localizer[UIResources.Sidebar]"></i>
                                }
                                @if (item.PlaceToShow == PlaceToShowEnum.None)
                                {
                                    <span class="text-muted small">@Localizer[UIResources.NotSet]</span>
                                }
                            </div>
                            <div class="fw-medium text-secondary pt-1">@item.Order</div>
                        </td>
                        <td class="py-3 text-center">
                            @if (item.ContentType == ContentTypeEnum.Page)
                            {
                                <span class="badge bg-secondary opacity-75">@Localizer[UIResources.AsPage]</span>
                            }
                            else
                            {
                                <span class="badge bg-primary opacity-75">@Localizer[UIResources.AsPost]</span>
                            }
                        </td>
                        <td class="py-3">
                            <span class="text-danger small fw-medium">
                                @(item.DeletedAtUtc.HasValue ? string.Format(Localizer[UIResources.DeletedOnDate].Value, item.DeletedAtUtc.Value.ToLocalTime().ToString(FormatConstants.DateDot)) : Localizer[UIResources.Deleted].Value)
                            </span>
                            <div class="text-muted small mt-2">
                                <div>
                                    <i class="bi bi-asterisk"></i>
                                    @item.CreatedAtUtc.ToLocalTime().ToString(FormatConstants.DateTimeDot)
                                </div>
                                @if (item.UpdatedAtUtc.HasValue)
                                {
                                    <div class="text-secondary text-opacity-75 mt-2">
                                        <i class="bi bi-pencil"></i>
                                        @item.UpdatedAtUtc.Value.ToLocalTime().ToString(FormatConstants.DateTimeDot)
                                    </div>
                                }
                            </div>
                        </td>
                        <td class="py-3 text-end pe-4">
                            <div class="d-inline-flex flex-column gap-2">
                                <button class="btn btn-outline-success btn-sm d-inline align-items-center gap-1" data-action="restore" data-id="@item.Id" data-title="@item.Title" data-url="@Url.Action("Restore")">
                                    <i class="bi bi-arrow-counterclockwise"></i>
                                    @Localizer[UIResources.Restore]
                                </button>
                                <a class="btn btn-outline-info btn-sm d-inline align-items-center gap-1" asp-action="Details" asp-route-id="@item.Id">
                                    <i class="bi bi-info-circle"></i>
                                    @Localizer[UIResources.Details]
                                </a>
                                <button class="btn btn-outline-danger btn-sm d-inline align-items-center gap-1" data-action="hard-delete" data-id="@item.Id" data-title="@item.Title" data-url="@Url.Action("HardDelete")">
                                    <i class="bi bi-trash"></i>
                                    @Localizer[UIResources.DeletePermanently]
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="px-4 pb-4">
        @await Html.PartialAsync("_AdminPagination", Model)
    </div>
</div>

@Html.AntiForgeryToken()
