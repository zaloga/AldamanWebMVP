@using Aldaman.Services.Dtos.Page
@model IEnumerable<ContentPageNavigationDto>

<div class="relative">
    <a id="brand-nav-link" 
       class="text-xl font-bold tracking-tight text-slate-900 dark:text-white cursor-pointer select-none flex items-center gap-1" 
       asp-area="" asp-controller="Home" asp-action="Index">
        Aldaman
        @if (Model.Any())
        {
            <i id="brand-nav-chevron" class="bi bi-chevron-down w-4 h-4 transition-transform duration-300 text-slate-400"></i>
        }
    </a>

    @if (Model.Any())
    {
        <div id="brand-nav-dropdown" class="absolute left-0 mt-2 w-64 rounded-xl shadow-2xl bg-white dark:bg-slate-800 ring-1 ring-black/5 opacity-0 invisible transition-all duration-300 z-50 transform origin-top-left -translate-y-2 border border-slate-100 dark:border-white/10 overflow-hidden">
            <div class="py-2">
                <a asp-area="" asp-controller="Home" asp-action="Index"
                   class="block px-4 py-3 text-sm font-bold text-brand-primary dark:text-brand-accent hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors border-b border-slate-100 dark:border-white/5">
                    <div class="flex items-center gap-2">
                        <i class="bi bi-house-door text-sm"></i>
                        @Localizer[UIResourceKeys.Home]
                    </div>
                </a>
                @foreach (var hpPage in Model)
                {
                    <a href="@Url.Action("Index", "Home")#@hpPage.Slug" 
                       class="block px-4 py-2.5 text-sm text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700/50 hover:text-brand-primary dark:hover:text-brand-accent transition-colors">
                        <div class="flex items-center justify-between">
                            <span>@hpPage.Title</span>
                        </div>
                    </a>
                }
            </div>
        </div>
    }
</div>
