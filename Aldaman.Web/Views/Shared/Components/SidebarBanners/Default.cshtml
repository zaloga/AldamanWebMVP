@using Aldaman.Persistence.Enums
@model Aldaman.Web.ViewModels.SidebarBannersViewModel

@if (Model.Banners != null && Model.Banners.Any())
{
    <aside class="flex flex-col gap-6" aria-label="@Localizer[UIResources.Sidebar]">
        @foreach (var banner in Model.Banners)
        {
            <div class="rounded-2xl border border-amber-900/10 dark:border-amber-500/15 bg-[#fffaf5] dark:bg-[#1e1a17]/80 p-5 shadow-xs hover:shadow-md transition-all">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="flex justify-end mb-2">
                        <a asp-area="Admin" asp-controller="Contents" asp-action="Update" asp-route-id="@banner.Id"
                           class="inline-flex items-center gap-1 text-xs font-semibold text-amber-700 dark:text-amber-400 hover:underline"
                           title="@Localizer[UIResources.EditContent]">
                            <i class="bi bi-pencil-square"></i>
                            <span>@Localizer[UIResources.EditContent]</span>
                        </a>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(banner.CoverImageRelativePath))
                {
                    <div class="mb-3.5 overflow-hidden rounded-xl bg-stone-100 dark:bg-stone-800">
                        @if (!string.IsNullOrWhiteSpace(banner.Slug))
                        {
                            <a asp-route="@RouteConstants.ContentDetail" asp-route-culture="@CurrentCulture" asp-route-slug="@banner.Slug" class="block group">
                                <img src="@banner.CoverImageRelativePath"
                                     alt="@banner.Title"
                                     class="w-full h-auto object-cover rounded-xl group-hover:scale-105 transition-transform duration-300" />
                            </a>
                        }
                        else
                        {
                            <img src="@banner.CoverImageRelativePath"
                                 alt="@banner.Title"
                                 class="w-full h-auto object-cover rounded-xl" />
                        }
                    </div>
                }

                @if (banner.DisplayTitle && !string.IsNullOrWhiteSpace(banner.Title))
                {
                    <h3 class="font-bold text-stone-900 dark:text-stone-100 text-base sm:text-lg mb-2">
                        @if (!string.IsNullOrWhiteSpace(banner.Slug))
                        {
                            <a asp-route="@RouteConstants.ContentDetail" asp-route-culture="@CurrentCulture" asp-route-slug="@banner.Slug" class="hover:text-amber-700 dark:hover:text-amber-400 transition-colors">
                                @banner.Title
                            </a>
                        }
                        else
                        {
                            @banner.Title
                        }
                    </h3>
                }

                @if (!string.IsNullOrWhiteSpace(banner.Perex))
                {
                    <p class="text-xs sm:text-sm text-stone-600 dark:text-stone-400 mb-2.5 leading-relaxed">
                        @banner.Perex
                    </p>
                }

                @if (!string.IsNullOrWhiteSpace(banner.BodyHtml))
                {
                    <div class="ql-snow mb-2.5">
                        <div class="ql-editor !p-0 text-xs sm:text-sm text-stone-700 dark:text-stone-300">
                            @Html.Raw(banner.BodyHtml)
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(banner.Slug))
                {
                    <div class="mt-3 text-right">
                        <a asp-route="@RouteConstants.ContentDetail" asp-route-culture="@CurrentCulture" asp-route-slug="@banner.Slug"
                           class="inline-flex items-center gap-1.5 text-xs font-semibold text-amber-700 dark:text-amber-400 hover:text-amber-800 dark:hover:text-amber-300 transition-colors">
                            <span>@Localizer[UIResources.ViewDetail]</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                }
            </div>
        }
    </aside>
}
