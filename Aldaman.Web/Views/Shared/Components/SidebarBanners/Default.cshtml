@using Aldaman.Persistence.Enums
@model Aldaman.Web.ViewModels.SidebarBannersViewModel

@if (Model.Banners != null && Model.Banners.Any())
{
    <aside class="flex flex-col gap-6" aria-label="@Localizer[UIResources.Sidebar]">
        @foreach (var banner in Model.Banners)
        {
            <div class="rounded-xl border border-amber-900/15 dark:border-white/10 bg-gradient-to-b from-amber-500/15 via-amber-400/10 to-amber-500/15 dark:bg-slate-800/60 p-4 shadow-sm transition-all hover:shadow-md">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="flex justify-end mb-2">
                        <a asp-area="Admin" asp-controller="Contents" asp-action="Update" asp-route-id="@banner.Id"
                           class="inline-flex items-center gap-1 text-xs font-semibold text-brand-primary dark:text-brand-accent hover:underline"
                           title="@Localizer[UIResources.EditContent]">
                            <i class="bi bi-pencil-square"></i>
                            <span>@Localizer[UIResources.EditContent]</span>
                        </a>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(banner.CoverImageRelativePath))
                {
                    <div class="mb-3 overflow-hidden rounded-lg">
                        @if (!string.IsNullOrWhiteSpace(banner.Slug))
                        {
                            <a asp-route="@RouteConstants.ContentDetail" asp-route-culture="@CurrentCulture" asp-route-slug="@banner.Slug" class="block group">
                                <img src="@banner.CoverImageRelativePath"
                                     alt="@banner.Title"
                                     class="w-full h-auto object-cover rounded-lg group-hover:scale-105 transition-transform duration-300" />
                            </a>
                        }
                        else
                        {
                            <img src="@banner.CoverImageRelativePath"
                                 alt="@banner.Title"
                                 class="w-full h-auto object-cover rounded-lg" />
                        }
                    </div>
                }

                @if (banner.DisplayTitle && !string.IsNullOrWhiteSpace(banner.Title))
                {
                    <h3 class="font-bold text-slate-900 dark:text-white text-base sm:text-lg mb-2">
                        @if (!string.IsNullOrWhiteSpace(banner.Slug))
                        {
                            <a asp-route="@RouteConstants.ContentDetail" asp-route-culture="@CurrentCulture" asp-route-slug="@banner.Slug" class="hover:text-brand-primary dark:hover:text-brand-accent transition-colors">
                                @banner.Title
                            </a>
                        }
                        else
                        {
                            @banner.Title
                        }
                    </h3>
                }

                @if (!string.IsNullOrWhiteSpace(banner.Perex))
                {
                    <p class="text-xs sm:text-sm text-slate-800 dark:text-slate-400 mb-2 leading-relaxed">
                        @banner.Perex
                    </p>
                }

                @if (!string.IsNullOrWhiteSpace(banner.BodyHtml))
                {
                    <div class="ql-snow mb-2">
                        <div class="ql-editor !p-0 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
                            @Html.Raw(banner.BodyHtml)
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(banner.Slug))
                {
                    <div class="mt-2 text-right">
                        <a asp-route="@RouteConstants.ContentDetail" asp-route-culture="@CurrentCulture" asp-route-slug="@banner.Slug"
                           class="inline-flex items-center gap-1 text-xs font-semibold text-brand-primary dark:text-brand-accent hover:underline">
                            <span>@Localizer[UIResources.ViewDetail]</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                }
            </div>
        }
    </aside>
}
