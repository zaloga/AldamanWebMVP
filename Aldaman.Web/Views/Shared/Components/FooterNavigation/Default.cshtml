@using Aldaman.Services.Dtos.Navigation
@using Aldaman.Web.Extensions
@model IEnumerable<NavigationDto>

@foreach (var navigation in Model)
{
    var targetController = navigation.IsGroup ? "ContentGroup" : "Content";
    var routeName = navigation.IsGroup ? RouteConstants.ContentGroupDetail : RouteConstants.ContentDetail;
    var isActive = ViewContext.IsNavActive(targetController, "Detail", navigation.Slug);
    <a class="@(isActive ? "footer-link-active" : "footer-link")" 
       asp-route="@routeName" 
       asp-route-culture="@CurrentCulture" 
       asp-route-slug="@navigation.Slug">
        @navigation.Title
    </a>
}

