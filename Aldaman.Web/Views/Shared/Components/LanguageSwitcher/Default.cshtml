@model Aldaman.Web.ViewModels.LanguageSwitcherViewModel

<div class="flex items-center gap-1.5 text-xs font-semibold">
    @foreach (var lang in Model.SupportedLanguages)
    {
        if (lang.IsActive)
        {
            <span class="px-2.5 py-1 rounded-lg bg-red-600/10 dark:bg-red-500/15 text-red-900 dark:text-red-300 cursor-default">
                @lang.DisplayName
            </span>
        }
        else
        {
            <a href="@lang.Url" 
               class="px-2.5 py-1 rounded-lg text-stone-600 dark:text-stone-400 hover:text-red-700 dark:hover:text-red-300 hover:bg-red-500/10 dark:hover:bg-stone-800/80 transition-all duration-200"
               title="Switch to @lang.DisplayName">
                @lang.DisplayName
            </a>
        }

        @if (lang != Model.SupportedLanguages.Last())
        {
            <span class="w-px h-3.5 bg-red-900/10 dark:bg-red-500/20"></span>
        }
    }
</div>
