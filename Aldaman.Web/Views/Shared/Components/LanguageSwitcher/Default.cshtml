@model Aldaman.Web.ViewModels.LanguageSwitcherViewModel

<div class="flex items-center gap-1.5 text-xs font-semibold">
    @foreach (var lang in Model.SupportedLanguages)
    {
        if (lang.IsActive)
        {
            <span class="px-2.5 py-1 rounded-lg bg-amber-600/15 dark:bg-amber-400/15 text-amber-900 dark:text-amber-300 cursor-default">
                @lang.DisplayName
            </span>
        }
        else
        {
            <a href="@lang.Url" 
               class="px-2.5 py-1 rounded-lg text-stone-600 dark:text-stone-400 hover:text-amber-800 dark:hover:text-amber-300 hover:bg-amber-500/10 dark:hover:bg-stone-800/80 transition-all duration-200"
               title="Switch to @lang.DisplayName">
                @lang.DisplayName
            </a>
        }

        @if (lang != Model.SupportedLanguages.Last())
        {
            <span class="w-px h-3.5 bg-amber-900/10 dark:bg-amber-500/20"></span>
        }
    }
</div>
