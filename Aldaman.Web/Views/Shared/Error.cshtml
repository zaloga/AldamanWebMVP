@model ErrorViewModel
@{
    ViewData.SetPageTitle(Localizer[UIResources.Error]);
}

<h1 class="text-red-600 dark:text-red-400 font-bold text-3xl mb-2">@Localizer[UIResources.Error].</h1>
<h2 class="text-red-600 dark:text-red-400 text-xl mb-4">@Localizer[UIResources.ErrorOccurred]</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@Localizer[UIResources.RequestId]</strong> <code>@Model.RequestId</code>
    </p>
}
