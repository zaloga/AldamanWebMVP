@inject Aldaman.Services.Interfaces.IStyleService StyleService
@inject Aldaman.Services.Interfaces.IContentService ContentService
@using Aldaman.Web.Extensions
<!DOCTYPE html>
<html lang="@CurrentCulture" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData.GetPageTitle() - Aldaman</title>
    <link rel="icon" type="image/svg+xml" href="~/images/logo-icon.svg" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            @foreach (var style in await StyleService.GetActiveStylesAsync())
            {
                @Html.Raw($"{style.Key}: {style.Value};")
            }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
    <script src="~/js/theme-init.js" asp-append-version="true"></script>
</head>
<body class="min-w-[300px] flex flex-col min-h-full bg-[#fce9d8] dark:bg-[#151210] text-stone-800 dark:text-stone-200 transition-colors duration-300">
    <header class="sticky top-0 z-50 header-glass transition-colors duration-300 relative">
        <div class="header-motif absolute inset-0 pointer-events-none select-none" aria-hidden="true"></div>
        <nav class="container relative flex flex-col lg:flex-row lg:items-center justify-between gap-4 py-4.5 lg:py-0 lg:h-[5.625rem]">
            <div class="flex items-center justify-between w-full lg:w-auto">
                <a id="brand-nav-link"
                   class="text-xl font-bold tracking-tight text-stone-900 dark:text-white cursor-pointer select-none flex items-center gap-2.5 group"
                   asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="flex items-center justify-center w-8 h-8 rounded-lg overflow-hidden shadow-xs transition-transform duration-200 group-hover:scale-105">
                        <img src="~/images/logo-icon.svg" asp-append-version="true" alt="Aldaman" class="w-full h-full object-contain" />
                    </span>
                    <span class="font-extrabold text-stone-900 dark:text-white text-lg tracking-tight">Aldaman</span>
                </a>
            </div>

            <div class="flex flex-wrap items-center justify-center lg:justify-start gap-x-2 gap-y-2">
                @await Component.InvokeAsync("TopNavigation")

                @{
                    var isContactActive = ViewContext.IsNavActive("Contact");
                }
                <a class="@(isContactActive ? "px-3.5 py-1.5 rounded-full text-sm font-semibold bg-red-700/10 text-red-900 dark:bg-red-500/15 dark:text-red-300 shadow-2xs transition-all" : "px-3.5 py-1.5 rounded-full text-sm font-medium text-stone-700 dark:text-stone-300 hover:text-red-700 dark:hover:text-red-300 hover:bg-red-900/5 dark:hover:bg-white/5 transition-all")" asp-area="" asp-controller="Contact" asp-action="Index">@Localizer[UIResources.Contact]</a>
            </div>

            <div class="flex items-center justify-center w-full lg:w-auto gap-3">
                <div class="relative group w-full max-w-[220px] lg:max-w-none">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-stone-400 dark:text-stone-500">
                        <i class="bi bi-search text-xs"></i>
                    </div>
                    <input type="text" id="site-search"
                           class="block w-full lg:w-44 xl:w-52 py-2 pl-9 pr-4 text-sm text-stone-900 dark:text-stone-100 rounded-full transition-all focus:lg:w-52 xl:focus:w-60 outline-none"
                           placeholder="@Localizer[UIResources.Search]..."
                           autocomplete="off"
                           data-culture="@CurrentCulture">
                    <div id="search-results" class="absolute left-0 right-0 mt-2 hidden overflow-hidden z-[60]">
                    </div>
                </div>
            </div>

            <div class="flex items-center justify-center gap-3">
                @await Component.InvokeAsync("LanguageSwitcher")

                <button id="theme-toggle" type="button" class="text-stone-700 dark:text-stone-300 hover:bg-red-500/10 dark:hover:bg-stone-800/80 focus:outline-none rounded-xl text-sm p-2 transition-all" title="Theme">
                    <i id="theme-toggle-dark-icon" class="bi bi-moon-stars hidden text-lg"></i>
                    <i id="theme-toggle-light-icon" class="bi bi-sun hidden text-lg"></i>
                </button>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow py-6 sm:py-10 relative">
        <div class="content-backdrop-motif absolute inset-0 -z-10" aria-hidden="true"></div>
        <div class="container relative">
            @{
                var sidebarBanners = await ContentService.GetSidebarBannersCachedAsync(CurrentCulture);
                var hasSidebar = sidebarBanners.Any();
            }
            @if (hasSidebar)
            {
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                    <div class="lg:col-span-8 xl:col-span-9 min-w-0">
                        @RenderBody()
                    </div>
                    <div class="lg:col-span-4 xl:col-span-3 min-w-0">
                        @await Component.InvokeAsync("SidebarBanners")
                    </div>
                </div>
            }
            else
            {
                @RenderBody()
            }
        </div>
    </main>

    <footer class="site-footer">
        <div class="header-motif absolute inset-0 pointer-events-none select-none" aria-hidden="true"></div>
        <div class="container relative flex flex-col md:flex-row justify-between items-center gap-6 text-center md:text-left">
            <div class="flex flex-col items-center md:items-start gap-1.5">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="flex items-center gap-2.5 group cursor-pointer select-none">
                    <span class="flex items-center justify-center w-8 h-8 rounded-lg overflow-hidden shadow-xs transition-transform duration-200 group-hover:scale-105">
                        <img src="~/images/logo-icon.svg" asp-append-version="true" alt="Aldaman" class="w-full h-full object-contain" />
                    </span>
                    <span class="font-extrabold text-stone-900 dark:text-stone-100 text-lg tracking-tight">Aldaman</span>
                </a>
                <p class="text-xs font-medium text-stone-700 dark:text-stone-400">
                    &copy; @DateTime.Today.Year Aldaman.
                </p>
            </div>

            <div class="flex flex-wrap items-center justify-center md:justify-end gap-2">
                @await Component.InvokeAsync("FooterNavigation")
            </div>

            <div class="flex flex-wrap items-center justify-center md:justify-end gap-2">
                <a asp-area="" asp-controller="Home" asp-action="Mcp" class="footer-link @(ViewContext.IsNavActive("Home", "Mcp") ? "footer-link-active" : "")">MCP API</a>
                <a asp-area="" asp-controller="Home" asp-action="Search" class="footer-link @(ViewContext.IsNavActive("Home", "Search") ? "footer-link-active" : "")">Search API</a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="footer-link">@Localizer[UIResources.Admin]</a>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="inline-flex">
                        <button type="submit" class="footer-link cursor-pointer">@Localizer[UIResources.Logout]</button>
                    </form>
                }
                else
                {
                    <a asp-area="" asp-controller="Account" asp-action="Login" class="footer-link">@Localizer[UIResources.Login]</a>
                }
            </div>
        </div>
    </footer>

    @if (TempData.GetShowTranslationMissingToast())
    {
        <div id="toast-wrapper" class="fixed top-20 left-0 right-0 z-[100] flex justify-center pointer-events-none px-4">
            <div id="translation-missing-toast" class="pointer-events-auto flex items-center gap-3 w-full max-w-sm p-4 bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-800 rounded-2xl shadow-2xl transition-all duration-500 transform -translate-y-10 opacity-0 overflow-hidden">
                <div class="text-amber-600 dark:text-amber-400">
                    <i class="bi bi-info-circle text-xl"></i>
                </div>
                <div class="flex-1 text-sm font-medium text-stone-800 dark:text-stone-200 pr-2">
                    @Localizer[UIResources.TranslationMissing]
                </div>
                <button id="close-toast-btn" class="text-stone-400 hover:text-stone-600 dark:hover:text-stone-200 transition-colors">
                    <i class="bi bi-x text-lg"></i>
                </button>
                <div class="absolute bottom-0 left-0 right-0 h-1 bg-stone-100 dark:bg-stone-800 rounded-b-2xl overflow-hidden">
                    <div id="toast-progress" class="h-full bg-amber-500 dark:bg-amber-400 w-full transition-all duration-100 ease-linear"></div>
                </div>
            </div>
        </div>
    }

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
