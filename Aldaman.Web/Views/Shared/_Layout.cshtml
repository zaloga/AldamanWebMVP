@inject Aldaman.Services.Interfaces.IStyleService StyleService
@using Aldaman.Web.Extensions
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData.GetPageTitle() - Aldaman</title>
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            @foreach (var style in await StyleService.GetActiveStylesAsync())
            {
                @Html.Raw($"{style.Key}: {style.Value};")
            }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
    <script src="~/js/theme-init.js" asp-append-version="true"></script>
</head>
<body class="min-w-[300px] flex flex-col min-h-full bg-brand-bg-light dark:bg-brand-bg-dark text-slate-900 dark:text-slate-100 transition-colors duration-300">
    <header class="glass sticky top-0 z-50 transition-colors duration-300">
        <nav class="container flex flex-col lg:flex-row lg:items-center justify-between gap-4 py-4 lg:py-0 lg:h-16">
            <div class="flex items-center justify-between w-full lg:w-auto">
                @* TODO - refactor and use it or delete it including dependencies *@
                @* @await Component.InvokeAsync("Brand") *@
                <a id="brand-nav-link"
                   class="text-xl font-bold tracking-tight text-slate-900 dark:text-white cursor-pointer select-none flex items-center gap-1"
                   asp-area="" asp-controller="Home" asp-action="Index">
                    Aldaman
                </a>
            </div>

            <div class="flex flex-wrap items-center justify-center lg:justify-start gap-x-4 gap-y-2">
                @await Component.InvokeAsync("TopNavigation")

                @{
                    var isContactActive = ViewContext.IsNavActive("Contact");
                }
                <a class="@(isContactActive ? "text-sm font-semibold text-brand-primary dark:text-brand-accent border-b-2 border-brand-primary dark:border-brand-accent pb-0.5 transition-all" : "text-sm font-medium text-slate-800 dark:text-slate-400 hover:text-brand-primary dark:hover:text-brand-accent transition-colors")" asp-area="" asp-controller="Contact" asp-action="Index">@Localizer[UIResourceKeys.Contact]</a>
            </div>


            <div class="flex items-center justify-center w-full lg:w-auto gap-4">
                <div class="relative group w-full max-w-[200px] lg:max-w-none">
                    <input type="text" id="site-search"
                           class="block w-full lg:w-40 xl:w-48 p-2.5 pl-4 pr-10 text-sm text-slate-900 border border-slate-200 rounded-full shadow-sm dark:border-slate-700 dark:placeholder-slate-400 dark:text-white transition-all focus:lg:w-48 xl:focus:w-56 outline-none"
                           placeholder="@Localizer[UIResourceKeys.Search]..."
                           autocomplete="off"
                           data-culture="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
                    <div id="search-results" class="absolute left-0 right-0 mt-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl shadow-2xl hidden overflow-hidden z-[60]">
                    </div>
                </div>
            </div>

            <div class="flex items-center justify-center gap-4">
                @await Component.InvokeAsync("LanguageSwitcher")

                <button id="theme-toggle" type="button" class="text-amber-950/80 dark:text-slate-400 hover:bg-amber-500/20 dark:hover:bg-slate-800 focus:outline-none focus:ring-4 focus:ring-amber-900/20 dark:focus:ring-slate-700 rounded-lg text-sm p-2 transition-all">
                    <i id="theme-toggle-dark-icon" class="bi bi-moon-fill hidden text-xl"></i>
                    <i id="theme-toggle-light-icon" class="bi bi-sun-fill hidden text-xl"></i>
                </button>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow bg-gradient-to-b from-orange-500/30 via-amber-500/25 to-orange-500/30 dark:bg-brand-bg-dark">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="glass border-x-0 border-b-0 py-10">
        <div class="container flex flex-col md:flex-row justify-between items-center gap-6 text-center md:text-left">
            <div class="flex flex-wrap items-center justify-center md:justify-end gap-x-6 gap-y-2">
                @await Component.InvokeAsync("FooterNavigation")
            </div>
            <div class="flex flex-col items-center md:items-start gap-1">
                <p class="text-sm text-amber-950/80 dark:text-slate-400">
                    &copy; @DateTime.Today.Year Aldaman.
                </p>
                <div class="flex flex-wrap items-center justify-center md:justify-start gap-4">
                    <a asp-area="" asp-controller="Home" asp-action="Mcp" class="footer-link @(ViewContext.IsNavActive("Home", "Mcp") ? "text-brand-primary dark:text-brand-accent font-semibold underline" : "")">MCP API for AI</a>
                    <a asp-area="" asp-controller="Home" asp-action="Search" class="footer-link @(ViewContext.IsNavActive("Home", "Search") ? "text-brand-primary dark:text-brand-accent font-semibold underline" : "")">Search API for AI</a>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="footer-link">@Localizer[UIResourceKeys.Admin]</a>
                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="inline leading-4">
                            <button type="submit" class="footer-link">@Localizer[UIResourceKeys.Logout]</button>
                        </form>
                    }
                    else
                    {
                        <a asp-area="" asp-controller="Account" asp-action="Login" class="footer-link">@Localizer[UIResourceKeys.Login]</a>
                    }
                </div>
            </div>
        </div>
    </footer>

    @if (TempData.GetShowTranslationMissingToast())
    {
        <div id="toast-wrapper" class="fixed top-20 left-0 right-0 z-[100] flex justify-center pointer-events-none px-4">
            <div id="translation-missing-toast" class="pointer-events-auto flex items-center gap-3 w-full max-w-sm p-4 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl shadow-2xl transition-all duration-500 transform -translate-y-10 opacity-0 overflow-hidden">
                <div class="text-blue-500 dark:text-blue-400">
                    <i class="bi bi-info-circle text-2xl"></i>
                </div>
                <div class="flex-1 text-sm font-medium text-slate-800 dark:text-slate-200 pr-2">
                    @Localizer[UIResourceKeys.TranslationMissing]
                </div>
                <button id="close-toast-btn" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors">
                    <i class="bi bi-x text-lg"></i>
                </button>
                <div class="absolute bottom-0 left-0 right-0 h-1 bg-slate-100 dark:bg-slate-700 rounded-b-xl overflow-hidden">
                    <div id="toast-progress" class="h-full bg-blue-500 dark:bg-blue-400 w-full transition-all duration-100 ease-linear"></div>
                </div>
            </div>
        </div>
    }

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
