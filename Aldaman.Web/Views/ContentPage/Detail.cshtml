@model Aldaman.Web.ViewModels.ContentPageViewModel
@{
    ViewData.SetPageTitle(Model.Page.Title);
}

@section Styles {
    <link rel="stylesheet" href="~/lib/quill/quill.snow.css" />
}
<section id="@Model.Page.Slug" class="border-b border-slate-200 dark:border-white/5 last:border-0">
    <div class="flex flex-col">
        <div class="flex items-start justify-between gap-4 mb-2">
            @if (Model.Page.DisplayTitle)
            {
                <div>
                    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
                        @Model.Page.Title
                    </h1>
                    <div class="h-1.5 w-20 bg-brand-primary dark:bg-brand-accent rounded-full mt-2"></div>
                </div>
            }
            else
            {
                <div></div>
            }

            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-area="Admin" asp-controller="ContentPages" asp-action="Update" asp-route-id="@Model.Page.Id"
                   class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg bg-amber-500/10 text-amber-900 dark:bg-slate-800 dark:text-amber-400 border border-amber-500/30 dark:border-slate-700 hover:bg-amber-500/20 dark:hover:bg-slate-700 transition-colors shrink-0 shadow-sm"
                   title="@Localizer[UIResourceKeys.Edit]">
                    <i class="bi bi-pencil-square"></i>
                    <span>@Localizer[UIResourceKeys.Edit]</span>
                </a>
            }
        </div>

        @if (!string.IsNullOrEmpty(Model.Page.BodyHtml))
        {
            <div class="ql-snow">
                <div class="ql-editor">
                    @Html.Raw(Model.Page.BodyHtml)
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-12 bg-amber-500/10 dark:bg-slate-800/50 rounded-2xl border border-dashed border-amber-900/20 dark:border-slate-700">
                @if (Model.Page.DisplayTitle)
                {
                    <h2 class="text-2xl font-bold text-amber-950/70 dark:text-slate-500">@Model.Page.Title</h2>
                }
                <p class="mt-2 text-amber-950/60 dark:text-slate-600">@Localizer[UIResourceKeys.SectionNoContent]</p>
            </div>
        }
    </div>
</section>