@model Aldaman.Web.ViewModels.ContactFormViewModel
@{
    ViewData.SetPageTitle(Localizer[UIResources.Contact]);
}

<div class="bg-[#fffaf5] dark:bg-[#1e1a17]/90 rounded-2xl border border-amber-900/10 dark:border-amber-500/15 p-6 sm:p-10 shadow-xs">
    <h2 class="text-3xl sm:text-4xl font-extrabold text-red-700 dark:text-stone-100 tracking-tight">@Localizer[UIResources.ContactMe]</h2>
    <p class="mt-3 text-base sm:text-lg text-stone-600 dark:text-stone-400">
        @Localizer[UIResources.ContactSubtitle]
    </p>

    <form asp-controller="Contact" asp-action="Submit" method="post" class="mt-8 grid grid-cols-1 gap-y-6 sm:grid-cols-2 sm:gap-x-8">
        <div class="sm:col-span-2">
            <label asp-for="EmailOrPhone" class="block text-sm font-semibold text-stone-700 dark:text-stone-300 mb-1.5">@Localizer[UIResources.EmailOrPhone]</label>
            <div>
                <input asp-for="EmailOrPhone" type="text" class="contact-input py-3 px-4 block w-full text-stone-900 dark:text-white outline-none">
                <span asp-validation-for="EmailOrPhone" class="text-sm text-red-600 mt-1 block"></span>
            </div>
        </div>
         
        <div class="sm:col-span-2">
            <label asp-for="Message" class="block text-sm font-semibold text-stone-700 dark:text-stone-300 mb-1.5">@Localizer[UIResources.Message]</label>
            <div>
                <textarea asp-for="Message" rows="5" class="contact-input py-3 px-4 block w-full text-stone-900 dark:text-white outline-none"></textarea>
                <span asp-validation-for="Message" class="text-sm text-red-600 mt-1 block"></span>
            </div>
        </div>

        <div class="sm:col-span-2">
            <button type="submit" class="btn-primary w-full justify-center py-3.5 text-base cursor-pointer">
                <i class="bi bi-send-fill"></i>
                <span>@Localizer[UIResources.SendMessage]</span>
            </button>
        </div>
    </form>
</div>
