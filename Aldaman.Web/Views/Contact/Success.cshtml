@{
    ViewData.SetPageTitle(Localizer[UIResources.MessageSent]);
}

<div class="bg-[#fffaf5] dark:bg-[#1e1a17]/90 rounded-2xl border border-amber-900/10 dark:border-amber-500/15 p-8 sm:p-12 text-center shadow-xs my-6">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 mb-4 text-3xl">
        <i class="bi bi-check-circle-fill"></i>
    </div>
    <h2 class="text-2xl sm:text-3xl font-extrabold text-red-700 dark:text-stone-100 mb-3">@Localizer[UIResources.ThankYouForMessage]</h2>
    <p class="text-base sm:text-lg text-stone-600 dark:text-stone-400 mb-8 max-w-lg mx-auto">@Localizer[UIResources.MessageSentConfirmation]</p>
    <a href="/" class="btn-primary">
        <i class="bi bi-arrow-left"></i>
        <span>@Localizer[UIResources.BackToHome]</span>
    </a>
</div>
