@model Aldaman.Web.ViewModels.BlogListViewModel
@{
    ViewData["Title"] = Localizer[UIResourceKeys.Blog];
}

<div class="text-center mb-10">
    <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-4xl">@Localizer[UIResourceKeys.Blog]</h2>
    <p class="mt-3 max-w-2xl mx-auto text-xl text-slate-600 dark:text-slate-400 sm:mt-4">
        @Localizer[UIResourceKeys.BlogSubtitle]
    </p>
</div>

<div class="grid gap-6 grid-cols-1">
    @foreach (var post in Model.Posts.Items)
    {
        <a href="/blog/@post.Slug" class="group flex flex-col overflow-hidden rounded-xl border border-slate-200 dark:border-white/10 bg-white dark:bg-slate-800/60 p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl dark:hover:bg-slate-800 dark:hover:border-white/20">
            <div class="flex items-center gap-4 sm:gap-5 mb-5">
                <img class="h-22 w-22 rounded-full object-cover shrink-0 border border-slate-200 dark:border-white/10 bg-slate-100 dark:bg-slate-900/50"
                     src="@(post.CoverImageRelativePath ?? "/images/placeholder.jpg")"
                     alt="@post.Title">
                <div class="flex flex-col">
                    <span class="font-bold text-slate-900 dark:text-white text-xl sm:text-2xl leading-snug">Alda Man</span>
                    <time datetime="@post.PublishedAtUtc?.ToString(FormatConstants.DateIso)" class="text-sm sm:text-base text-slate-500 dark:text-slate-400">
                        @post.PublishedAtUtc?.ToString(FormatConstants.DateDot)
                    </time>
                </div>
            </div>

            <div class="flex flex-1 flex-col justify-between">
                <div class="flex-1">
                    <h3 class="line-clamp-2 text-xl font-bold text-slate-900 dark:text-white transition-colors group-hover:text-brand-primary dark:group-hover:text-brand-accent">
                        @post.Title
                    </h3>
                    <p class="mt-3 line-clamp-3 text-sm/relaxed text-slate-600 dark:text-slate-400">
                        @post.Perex
                    </p>
                </div>
            </div>
        </a>
    }
</div>

