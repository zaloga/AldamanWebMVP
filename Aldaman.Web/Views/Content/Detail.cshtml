@using Aldaman.Persistence.Enums
@model Aldaman.Web.ViewModels.ContentViewModel
@{
    ViewData.SetPageTitle(Model.Content.Title);
    var isPost = Model.Content.ContentType == ContentTypeEnum.Post;
}

@section Styles {
    <link rel="stylesheet" href="~/lib/quill/quill.snow.css" />
}

@if (isPost)
{
    @* --- BLOG POST LAYOUT --- *@
    <article id="@Model.Content.Slug" class="bg-[#fffaf5] dark:bg-[#1e1a17]/90 rounded-2xl border border-amber-900/10 dark:border-amber-500/15 p-6 sm:p-10 shadow-xs mb-8 card-motif-a">
        <div class="flex flex-col">
            <div class="mb-6">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="flex justify-end mb-5">
                        <a asp-area="Admin" asp-controller="Contents" asp-action="Update" asp-route-id="@Model.Content.Id"
                           class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold rounded-xl bg-amber-500/10 text-amber-900 dark:bg-stone-800 dark:text-amber-400 border border-amber-500/20 dark:border-stone-700 hover:bg-amber-500/20 dark:hover:bg-stone-700 transition-colors shrink-0 shadow-xs"
                           title="@Localizer[UIResources.EditContent]">
                            <i class="bi bi-pencil-square"></i>
                            <span>@Localizer[UIResources.EditContent]</span>
                        </a>
                    </div>
                }

                @if (Model.Content.DisplayTitle && !string.IsNullOrWhiteSpace(Model.Content.Title))
                {
                    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-red-700 dark:text-stone-100 mb-4 leading-tight">
                        @Model.Content.Title
                    </h1>
                }

                @if (Model.Content.PublishedAtUtc.HasValue || !string.IsNullOrWhiteSpace(Model.Content.AuthorName))
                {
                    <div class="flex items-center gap-4 text-xs sm:text-sm text-stone-500 dark:text-stone-400 mb-6">
                        @if (Model.Content.PublishedAtUtc.HasValue)
                        {
                            <span class="inline-flex items-center gap-1.5">
                                <i class="bi bi-calendar3 text-amber-700 dark:text-amber-400"></i>
                                @Model.Content.PublishedAtUtc.Value.ToLocalTime().ToString(FormatConstants.DateDot)
                            </span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Content.AuthorName))
                        {
                            <span class="inline-flex items-center gap-1.5">
                                <i class="bi bi-person text-amber-700 dark:text-amber-400"></i>
                                @Model.Content.AuthorName
                            </span>
                        }
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Content.CoverImageRelativePath))
                {
                    <div class="mb-8 overflow-hidden rounded-2xl max-h-[480px] bg-stone-100 dark:bg-stone-800 shadow-xs">
                        <img src="@Model.Content.CoverImageRelativePath" alt="@Model.Content.Title" class="w-full h-full object-cover" />
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Content.Perex))
                {
                    <div class="text-lg sm:text-xl text-stone-700 dark:text-stone-300 font-medium leading-relaxed mb-6 border-l-4 border-amber-600 dark:border-amber-500 pl-4 py-1">
                        @Model.Content.Perex
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(Model.Content.BodyHtml))
            {
                <div class="ql-snow">
                    <div class="ql-editor !p-0">
                        @Html.Raw(Model.Content.BodyHtml)
                    </div>
                </div>
            }
            else if (string.IsNullOrWhiteSpace(Model.Content.Perex))
            {
                <div class="text-center py-12 bg-amber-500/5 dark:bg-stone-800/40 rounded-2xl border border-dashed border-amber-900/15 dark:border-stone-700">
                    <p class="text-stone-500 dark:text-stone-400 italic">@Localizer[UIResources.NoHtmlContent]</p>
                </div>
            }

            @if (Model.PreviousContent != null || Model.NextContent != null)
            {
                <footer class="mt-10 pt-8 border-t border-amber-900/10 dark:border-amber-500/15">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        @if (Model.PreviousContent != null)
                        {
                            <a asp-route="@RouteConstants.ContentDetail" asp-route-culture="@CurrentCulture" asp-route-slug="@Model.PreviousContent.Slug" 
                               class="group flex flex-col p-4 rounded-xl border border-amber-900/10 dark:border-amber-500/15 bg-amber-500/10 dark:bg-stone-800/40 hover:bg-amber-500/20 dark:hover:bg-stone-800/80 transition-all">
                                <span class="text-xs font-semibold text-amber-700 dark:text-amber-400 inline-flex items-center gap-1 mb-1">
                                    <i class="bi bi-arrow-left group-hover:-translate-x-1 transition-transform"></i>
                                    @Localizer[UIResources.PreviousPost]
                                </span>
                                <span class="text-sm font-bold text-stone-900 dark:text-stone-100 line-clamp-1">
                                    @Model.PreviousContent.Title
                                </span>
                            </a>
                        }
                        else
                        {
                            <div></div>
                        }

                        @if (Model.NextContent != null)
                        {
                            <a asp-route="@RouteConstants.ContentDetail" asp-route-culture="@CurrentCulture" asp-route-slug="@Model.NextContent.Slug" 
                               class="group flex flex-col items-end p-4 rounded-xl border border-amber-900/10 dark:border-amber-500/15 bg-amber-500/10 dark:bg-stone-800/40 hover:bg-amber-500/20 dark:hover:bg-stone-800/80 transition-all text-right">
                                <span class="text-xs font-semibold text-amber-700 dark:text-amber-400 inline-flex items-center gap-1 mb-1">
                                    @Localizer[UIResources.NextPost]
                                    <i class="bi bi-arrow-right group-hover:translate-x-1 transition-transform"></i>
                                </span>
                                <span class="text-sm font-bold text-stone-900 dark:text-stone-100 line-clamp-1">
                                    @Model.NextContent.Title
                                </span>
                            </a>
                        }
                    </div>
                </footer>
            }
        </div>
    </article>
}
else
{
    @* --- CONTENT PAGE LAYOUT --- *@
    <article id="@Model.Content.Slug" class="bg-[#fffaf5] dark:bg-[#1e1a17]/90 rounded-2xl border border-amber-900/10 dark:border-amber-500/15 p-6 sm:p-10 shadow-xs mb-8 card-motif-a">
        <div class="flex flex-col">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="flex justify-end mb-5">
                    <a asp-area="Admin" asp-controller="Contents" asp-action="Update" asp-route-id="@Model.Content.Id"
                       class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold rounded-xl bg-amber-500/10 text-amber-900 dark:bg-stone-800 dark:text-amber-400 border border-amber-500/20 dark:border-stone-700 hover:bg-amber-500/20 dark:hover:bg-stone-700 transition-colors shrink-0 shadow-xs"
                       title="@Localizer[UIResources.EditContent]">
                        <i class="bi bi-pencil-square"></i>
                        <span>@Localizer[UIResources.EditContent]</span>
                    </a>
                </div>
            }

            @if (Model.Content.DisplayTitle && !string.IsNullOrWhiteSpace(Model.Content.Title))
            {
                <div class="mb-6">
                    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-red-700 dark:text-stone-100 mb-2 leading-tight">
                        @Model.Content.Title
                    </h1>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.Content.BodyHtml))
            {
                <div class="ql-snow">
                    <div class="ql-editor !p-0">
                        @Html.Raw(Model.Content.BodyHtml)
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-12 bg-amber-500/5 dark:bg-stone-800/40 rounded-2xl border border-dashed border-amber-900/15 dark:border-stone-700">
                    <p class="text-stone-500 dark:text-stone-400 italic">@Localizer[UIResources.NoHtmlContent]</p>
                </div>
            }
        </div>
    </article>
}
