@model Aldaman.Web.ViewModels.HomeIndexViewModel
@{
    ViewData["Title"] = Localizer[UIResourceKeys.Home];
}

@section Styles {
    <link rel="stylesheet" href="~/lib/quill/quill.snow.css" />
}

@if (Model.HomePages.Any())
{
    @foreach (var homePage in Model.HomePages)
    {
        <section id="@homePage.Slug" class="mb-3">
            <div class="flex flex-col mb-3">
                <div class="mb-2">
                    <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
                        @homePage.Title
                    </h2>
                    <div class="h-1.5 w-20 bg-brand-primary dark:bg-brand-accent rounded-full"></div>
                </div>
                @if (!string.IsNullOrEmpty(homePage.BodyHtml))
                {
                    <div class="ql-snow">
                        <div class="ql-editor">
                            @Html.Raw(homePage.BodyHtml)
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-12 bg-amber-500/10 dark:bg-slate-800/50 rounded-2xl border border-dashed border-amber-900/20 dark:border-slate-700">
                        <h2 class="text-2xl font-bold text-amber-950/70 dark:text-slate-500">@homePage.Title</h2>
                        <p class="mt-2 text-amber-950/60 dark:text-slate-600">@Localizer[UIResourceKeys.SectionNoContent]</p>
                    </div>
                }
            </div>
        </section>
    }
}

@if (Model.Posts != null && Model.Posts.Items.Any())
{
    <div class="grid gap-6 grid-cols-1 mt-8">
        @foreach (var post in Model.Posts.Items)
        {
            <article class="flex flex-col overflow-hidden rounded-xl border border-amber-900/15 dark:border-white/10 bg-gradient-to-b from-amber-500/20 via-amber-400/15 to-amber-500/20 dark:bg-slate-800/60 p-6 shadow-sm" data-slug="@post.Slug">
                <div class="flex items-center gap-4 sm:gap-5 mb-5">
                    <img class="h-22 w-22 rounded-full object-cover shrink-0 border-2 border-[#EDBD00] dark:border-white/10 bg-amber-100 dark:bg-slate-900/50"
                         src="@(post.CoverImageRelativePath ?? "/images/placeholder.jpg")"
                         alt="@post.Title">
                    <div class="flex flex-col">
                        <span class="font-bold text-slate-900 dark:text-white text-xl sm:text-2xl leading-snug">@post.Title</span>
                        <time datetime="@post.PublishedAtUtc?.ToString(FormatConstants.DateIso)" class="text-sm sm:text-base text-amber-950/70 dark:text-slate-400">
                            @post.PublishedAtUtc?.ToString(FormatConstants.DateDot)
                        </time>
                    </div>
                </div>

                <div class="flex flex-1 flex-col justify-between">
                    <div class="flex-1">
                        <div class="mt-3">
                            <p class="js-perex-text text-sm/relaxed text-slate-800 dark:text-slate-400 line-clamp-3">
                                @post.Perex
                            </p>
                        </div>

                        <div class="js-full-content-container mt-4 prose dark:prose-invert max-w-none text-slate-700 dark:text-slate-300 opacity-0 transition-opacity duration-300" style="display: none;">
                        </div>

                        <div class="mt-3 flex items-center justify-between gap-4">
                            <div>
                                <button type="button"
                                        class="js-show-more-btn inline-flex items-center gap-1.5 font-semibold text-brand-primary dark:text-brand-accent hover:underline focus:outline-none cursor-pointer text-sm"
                                        data-slug="@post.Slug">
                                    <span>@Localizer[UIResourceKeys.ShowMore]</span>
                                    <svg class="w-4 h-4 js-spinner-icon hidden animate-spin" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                    </svg>
                                </button>
                                <button type="button"
                                        class="js-show-less-btn inline-flex items-center gap-1.5 font-semibold text-brand-primary dark:text-brand-accent hover:underline focus:outline-none cursor-pointer text-sm"
                                        style="display: none;"
                                        data-slug="@post.Slug">
                                    <span>@Localizer[UIResourceKeys.ShowLess]</span>
                                </button>
                            </div>

                            <a href="/blog/@post.Slug" class="inline-flex items-center gap-1 text-sm font-semibold text-brand-primary dark:text-brand-accent hover:underline">
                                <span>@Localizer[UIResourceKeys.ViewDetail]</span>
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </article>
        }
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const culture = "@System.Globalization.CultureInfo.CurrentUICulture.Name";

            document.querySelectorAll('.js-show-more-btn').forEach(btn => {
                btn.addEventListener('click', async function (e) {
                    e.preventDefault();
                    e.stopPropagation();

                    const button = this;
                    const slug = button.getAttribute('data-slug');
                    if (!slug) return;

                    const card = button.closest('article');
                    if (!card) return;

                    const perexText = card.querySelector('.js-perex-text');
                    const fullContentContainer = card.querySelector('.js-full-content-container');
                    const showLessBtn = card.querySelector('.js-show-less-btn');
                    const spinnerIcon = button.querySelector('.js-spinner-icon');

                    if (card.dataset.loadedContent === "true") {
                        if (perexText) perexText.classList.remove('line-clamp-3');
                        button.style.display = 'none';
                        if (fullContentContainer) {
                            fullContentContainer.style.display = 'block';
                            requestAnimationFrame(() => {
                                fullContentContainer.classList.remove('opacity-0');
                            });
                        }
                        if (showLessBtn) showLessBtn.style.display = 'inline-flex';
                        return;
                    }

                    button.disabled = true;
                    if (spinnerIcon) spinnerIcon.classList.remove('hidden');

                    try {
                        const response = await fetch(`/${culture}/blog/content/${encodeURIComponent(slug)}`);
                        if (!response.ok) {
                            throw new Error('Failed to fetch content');
                        }
                        const data = await response.json();

                        if (data && data.bodyHtml) {
                            fullContentContainer.innerHTML = data.bodyHtml;
                            card.dataset.loadedContent = "true";

                            if (perexText) perexText.classList.remove('line-clamp-3');
                            button.style.display = 'none';
                            fullContentContainer.style.display = 'block';
                            requestAnimationFrame(() => {
                                fullContentContainer.classList.remove('opacity-0');
                            });
                            if (showLessBtn) showLessBtn.style.display = 'inline-flex';
                        }
                    } catch (err) {
                        console.error('Error fetching blog content:', err);
                        window.location.href = `/${culture}/blog/${slug}`;
                    } finally {
                        button.disabled = false;
                        if (spinnerIcon) spinnerIcon.classList.add('hidden');
                    }
                });
            });

            document.querySelectorAll('.js-show-less-btn').forEach(btn => {
                btn.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();

                    const card = this.closest('article');
                    if (!card) return;

                    const perexText = card.querySelector('.js-perex-text');
                    const fullContentContainer = card.querySelector('.js-full-content-container');
                    const showMoreBtn = card.querySelector('.js-show-more-btn');

                    this.style.display = 'none';
                    if (fullContentContainer) {
                        fullContentContainer.classList.add('opacity-0');
                        fullContentContainer.style.display = 'none';
                    }
                    if (perexText) perexText.classList.add('line-clamp-3');
                    if (showMoreBtn) showMoreBtn.style.display = 'inline-flex';
                });
            });
        });
    </script>
}