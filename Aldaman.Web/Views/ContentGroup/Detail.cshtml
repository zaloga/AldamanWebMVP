@using Aldaman.Persistence.Enums
@model Aldaman.Web.ViewModels.ContentGroupViewModel
@{
    ViewData.SetPageTitle(Model.Group.Title);
}

@section Styles {
    <link rel="stylesheet" href="~/lib/quill/quill.snow.css" />
}

<div class="content-group-container">
    @* Group Header *@
    <div class="flex items-center justify-between gap-4 mb-6">
        <div>
            <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-red-700 dark:text-stone-100">
                @Model.Group.Title
            </h1>
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-area="Admin" asp-controller="ContentGroups" asp-action="Update" asp-route-id="@Model.Group.Id"
               class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold rounded-xl bg-amber-500/10 text-amber-900 dark:bg-stone-800 dark:text-amber-400 border border-amber-500/20 dark:border-stone-700 hover:bg-amber-500/20 dark:hover:bg-stone-700 transition-colors shrink-0 shadow-xs"
               title="@Localizer[UIResources.Edit]">
                <i class="bi bi-pencil-square"></i>
                <span>@Localizer[UIResources.Edit]</span>
            </a>
        }
    </div>

    @* Group Items in configured order *@
    @if (Model.Group.Items.Any())
    {
        <div class="flex flex-col gap-6 sm:gap-8">
            @foreach (var item in Model.Group.Items)
            {
                var content = item.Content;
                if (content == null) continue;

                var isPost = content.ContentType == ContentTypeEnum.Post;

                @if (isPost)
                {
                    <article class="group relative flex flex-col md:flex-row gap-6 p-6 sm:p-7 bg-[#fffaf5] dark:bg-[#1e1a17]/90 rounded-2xl border border-amber-900/10 dark:border-amber-500/15 shadow-xs hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300"
                             data-slug="@content.Slug"
                             data-loaded-content="@(content.DisplayExpanded ? "true" : "false")">
                        @if (!string.IsNullOrWhiteSpace(content.CoverImageRelativePath))
                        {
                            <div class="md:w-72 xl:w-80 shrink-0 overflow-hidden rounded-xl aspect-[16/10] md:aspect-[4/3] bg-stone-100 dark:bg-stone-800">
                                <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                     src="@content.CoverImageRelativePath"
                                     alt="@content.Title">
                            </div>
                        }

                        <div class="flex flex-1 flex-col justify-between min-w-0">
                            <div>
                                <div class="flex items-center gap-3 text-xs font-semibold text-amber-700 dark:text-amber-400 mb-2.5">
                                    @if (content.PublishedAtUtc.HasValue)
                                    {
                                        <span class="text-stone-500 dark:text-stone-400 font-normal inline-flex items-center gap-1">
                                            <i class="bi bi-calendar3"></i>
                                            @content.PublishedAtUtc.Value.ToLocalTime().ToString(FormatConstants.DateDot)
                                        </span>
                                    }
                                </div>

                                <h3 class="font-bold text-stone-900 dark:text-stone-100 text-xl sm:text-2xl leading-snug group-hover:text-amber-700 dark:group-hover:text-amber-400 transition-colors">
                                    <a asp-route="@RouteConstants.ContentDetail" asp-route-culture="@CurrentCulture" asp-route-slug="@content.Slug">
                                        @content.Title
                                    </a>
                                </h3>

                                @if (!string.IsNullOrWhiteSpace(content.Perex))
                                {
                                    <div class="mt-2.5">
                                        <p class="js-perex-text text-sm sm:text-base text-stone-600 dark:text-stone-400 leading-relaxed @(content.DisplayExpanded ? "" : "line-clamp-3")">
                                            @content.Perex
                                        </p>
                                    </div>
                                }

                                <div class="js-full-content-container mt-4 prose dark:prose-invert max-w-none text-stone-700 dark:text-stone-300 transition-opacity duration-300 @(content.DisplayExpanded ? "" : "opacity-0 hidden")">
                                    @if (content.DisplayExpanded && !string.IsNullOrEmpty(content.BodyHtml))
                                    {
                                        @Html.Raw(content.BodyHtml)
                                    }
                                </div>
                            </div>

                            <div class="mt-5 pt-4 border-t border-amber-900/10 dark:border-amber-500/10 flex items-center justify-between gap-4">
                                <div>
                                    <button type="button"
                                            class="js-show-more-btn inline-flex items-center gap-1.5 text-xs font-semibold text-amber-700 dark:text-amber-400 hover:text-amber-800 dark:hover:text-amber-300 focus:outline-none cursor-pointer @(content.DisplayExpanded ? "hidden" : "")"
                                            data-slug="@content.Slug">
                                        <span>@Localizer[UIResources.ShowMore]</span>
                                        <i class="bi bi-chevron-down text-xs"></i>
                                        <svg class="w-4 h-4 js-spinner-icon hidden animate-spin" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                        </svg>
                                    </button>
                                    <button type="button"
                                            class="js-show-less-btn inline-flex items-center gap-1.5 text-xs font-semibold text-amber-700 dark:text-amber-400 hover:text-amber-800 dark:hover:text-amber-300 focus:outline-none cursor-pointer @(content.DisplayExpanded ? "" : "hidden")"
                                            data-slug="@content.Slug">
                                        <span>@Localizer[UIResources.ShowLess]</span>
                                        <i class="bi bi-chevron-up text-xs"></i>
                                    </button>
                                </div>

                                <div class="flex items-center gap-4">
                                    @if (User.Identity?.IsAuthenticated == true)
                                    {
                                        <a asp-area="Admin" asp-controller="Contents" asp-action="Update" asp-route-id="@content.Id"
                                           class="inline-flex items-center gap-1 text-xs font-semibold text-stone-500 hover:text-amber-700 dark:hover:text-amber-400"
                                           title="@Localizer[UIResources.EditContent]">
                                            <i class="bi bi-pencil-square"></i>
                                            <span>@Localizer[UIResources.EditContent]</span>
                                        </a>
                                    }

                                    <a asp-route="@RouteConstants.ContentDetail" asp-route-culture="@CurrentCulture" asp-route-slug="@content.Slug" 
                                       class="inline-flex items-center gap-1.5 text-xs font-semibold text-amber-700 dark:text-amber-400 hover:text-amber-800 dark:hover:text-amber-300 group-hover:translate-x-0.5 transition-all">
                                        <span>@Localizer[UIResources.ViewDetail]</span>
                                        <i class="bi bi-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </article>
                }
                else
                {
                    <section id="@content.Slug" class="bg-[#fffaf5] dark:bg-[#1e1a17]/80 rounded-2xl border border-amber-900/10 dark:border-amber-500/15 p-6 sm:p-8 shadow-xs">
                        <div class="flex flex-col">
                            <div class="flex items-start justify-between gap-4 mb-4">
                                @if (content.DisplayTitle)
                                {
                                    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-red-700 dark:text-stone-100">
                                        @content.Title
                                    </h2>
                                }
                                else
                                {
                                    <div></div>
                                }

                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <a asp-area="Admin" asp-controller="Contents" asp-action="Update" asp-route-id="@content.Id"
                                       class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold rounded-xl bg-amber-500/10 text-amber-900 dark:bg-stone-800 dark:text-amber-400 border border-amber-500/20 dark:border-stone-700 hover:bg-amber-500/20 dark:hover:bg-stone-700 transition-colors shrink-0 shadow-xs"
                                       title="@Localizer[UIResources.EditContent]">
                                        <i class="bi bi-pencil-square"></i>
                                        <span>@Localizer[UIResources.EditContent]</span>
                                    </a>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(content.BodyHtml))
                            {
                                <div class="ql-snow">
                                    <div class="ql-editor !p-0">
                                        @Html.Raw(content.BodyHtml)
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-10 bg-amber-500/10 dark:bg-stone-800/40 rounded-2xl border border-dashed border-amber-900/15 dark:border-stone-700">
                                    @if (content.DisplayTitle)
                                    {
                                        <h3 class="text-lg font-bold text-stone-700 dark:text-stone-300">@content.Title</h3>
                                    }
                                    <p class="mt-1 text-sm text-stone-500 dark:text-stone-400">@Localizer[UIResources.SectionNoContent]</p>
                                </div>
                            }
                        </div>
                    </section>
                }
            }
        </div>
    }
    else
    {
        <div class="text-center py-16 bg-[#fffaf5] dark:bg-[#1e1a17]/80 rounded-2xl border border-dashed border-amber-900/15 dark:border-stone-700 mt-6">
            <p class="text-stone-500 dark:text-stone-400">@Localizer[UIResources.SectionNoContent]</p>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}
